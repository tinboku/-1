"""Deterministic helpers: citation keys, deduplication, heuristic MATCH."""

from __future__ import annotations

import math
import re

from .models import Paper

_STOPWORDS = {
    "a", "an", "the", "of", "for", "and", "or", "to", "in", "on", "with",
    "using", "via", "based", "toward", "towards", "from", "by", "at", "as",
    "is", "are", "be", "we", "our", "this", "that", "it", "its", "into",
    "including", "include", "includes", "between", "among", "within",
    "study", "studies", "paper", "approach", "approaches", "method",
    "methods", "analysis", "research",
}


def tokenize(text: str) -> list[str]:
    return [t for t in re.findall(r"[a-z0-9]+", text.lower()) if len(t) > 2]


def content_tokens(text: str) -> set[str]:
    return {t for t in tokenize(text) if t not in _STOPWORDS}


def normalize_title(title: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", title.lower()).strip()


def make_key(paper: Paper, taken: set[str]) -> str:
    """Author-year citation key in Undermind's style: Zha25, Cai26, Cai26b."""
    surname = paper.first_author_surname()
    base_name = surname[:12]
    year2 = f"{paper.year % 100:02d}" if paper.year else "nd"
    base = f"{base_name}{year2}"
    if base not in taken:
        taken.add(base)
        return base
    # Undermind style: first collision gets 'b', then 'c', ...
    for suffix_ord in range(ord("b"), ord("z") + 1):
        candidate = base + chr(suffix_ord)
        if candidate not in taken:
            taken.add(candidate)
            return candidate
    n = 2
    while f"{base}x{n}" in taken:
        n += 1
    candidate = f"{base}x{n}"
    taken.add(candidate)
    return candidate


def _merge_into(dst: Paper, src: Paper) -> None:
    for s in src.sources:
        if s not in dst.sources:
            dst.sources.append(s)
    if not dst.abstract and src.abstract:
        dst.abstract = src.abstract
    if not dst.open_access_pdf and src.open_access_pdf:
        dst.open_access_pdf = src.open_access_pdf
    if not dst.doi and src.doi:
        dst.doi = src.doi
    if not dst.arxiv_id and src.arxiv_id:
        dst.arxiv_id = src.arxiv_id
    if not dst.tldr and src.tldr:
        dst.tldr = src.tldr
    if not dst.venue and src.venue:
        dst.venue = src.venue
    if not dst.year and src.year:
        dst.year = src.year
    if src.citation_count > dst.citation_count:
        dst.citation_count = src.citation_count
    if not dst.authors and src.authors:
        dst.authors = src.authors
    if not dst.url and src.url:
        dst.url = src.url


def identity_keys(paper: Paper) -> set[str]:
    """All identity keys a paper can be recognized by across sources.

    The same real paper arrives with different ids per source (S2 id,
    OpenAlex W-id, DOI-based id) and DOI coverage differs per record, so
    cross-stage deduplication must match on ANY of id / DOI / title.
    """
    keys = {f"id:{paper.paper_id}"}
    if paper.doi:
        keys.add(f"doi:{paper.doi.lower()}")
    title_key = normalize_title(paper.title)
    if title_key:
        keys.add(f"title:{title_key}")
    return keys


def dedupe(papers: list[Paper]) -> list[Paper]:
    """Merge duplicates by DOI, else canonical id, else normalized title."""
    by_doi: dict[str, Paper] = {}
    by_id: dict[str, Paper] = {}
    by_title: dict[str, Paper] = {}
    out: list[Paper] = []
    for p in papers:
        found: Paper | None = None
        if p.doi and p.doi.lower() in by_doi:
            found = by_doi[p.doi.lower()]
        elif p.paper_id in by_id:
            found = by_id[p.paper_id]
        elif normalize_title(p.title) in by_title:
            found = by_title[normalize_title(p.title)]
        if found is None:
            out.append(p)
            found = p
        else:
            _merge_into(found, p)
        if found.doi:
            by_doi[found.doi.lower()] = found
        by_id[found.paper_id] = found
        by_title[normalize_title(found.title)] = found
    return out


def lexical_relevance(query_text: str, paper: Paper) -> float:
    """0..1 overlap of query content tokens with title (boosted) and abstract."""
    q = content_tokens(query_text)
    if not q:
        return 0.0
    title_tokens = content_tokens(paper.title)
    abstract_tokens = content_tokens(paper.abstract or "")
    title_hits = len(q & title_tokens)
    abstract_hits = len(q & abstract_tokens)
    coverage = (abstract_hits + 1.6 * title_hits) / (len(q) * 1.6)
    return max(0.0, min(1.0, coverage))


def heuristic_match(criteria: list[str], paper: Paper, current_year: int = 2026) -> tuple[float, str]:
    """Offline MATCH score (0..100) + a short human-readable reason.

    Combines lexical relevance to the search criteria (dominant), citation
    velocity (mild), and recency (mild). Deterministic and testable.
    """
    joined = " ".join(criteria)
    rel = max(lexical_relevance(c, paper) for c in criteria) if criteria else lexical_relevance(joined, paper)
    avg_rel = (
        sum(lexical_relevance(c, paper) for c in criteria) / len(criteria) if criteria else rel
    )
    relevance = 0.75 * rel + 0.25 * avg_rel

    velocity = paper.citations_per_year(current_year)
    citation_component = min(1.0, math.log10(1 + velocity) / 2.0)  # 100/yr -> 1.0

    if paper.year:
        age = current_year - paper.year
        recency_component = 1.0 if age <= 2 else max(0.0, 1.0 - (age - 2) / 12.0)
    else:
        recency_component = 0.3

    score = 100.0 * (0.78 * relevance + 0.12 * citation_component + 0.10 * recency_component)
    score = round(max(0.0, min(100.0, score)), 1)

    matched = sorted(content_tokens(joined) & content_tokens(paper.title + " " + (paper.abstract or "")))
    reason_bits = []
    if matched:
        reason_bits.append("matched terms: " + ", ".join(matched[:6]))
    if paper.citation_count:
        reason_bits.append(f"{paper.citation_count} citations")
    if paper.year:
        reason_bits.append(f"year {paper.year}")
    return score, "; ".join(reason_bits) or "weak lexical overlap"
"""Pluggable LLM backends.

Two implementations of the same interface:

- ``OpenAIChatLLM``: any OpenAI-compatible chat endpoint (set LLM_API_KEY,
  LLM_BASE_URL, LLM_MODEL). Used for brainstorming, criteria writing,
  MATCH judging, report writing, table extraction and follow-up Q&A.
- ``GeminiConnectorLLM``: Gemini through the registered custom.gemini
  connector (set DLS_LLM_BACKEND=gemini-connector). The API key lives in
  the connector's secure storage and is never present in this process;
  each call goes through the connector helper, which attaches a
  surrogate credential that is swapped for the real key on egress.
- ``HeuristicLLM``: deterministic offline fallback (lexical scoring,
  extractive report assembly). Lets the whole pipeline run — and be
  tested — with no API key at all.

Every method degrades to the heuristic behavior on API errors, so a flaky
endpoint never kills a search run.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
import time

import requests

from .config import Config
from .models import Paper
from .scoring import content_tokens, heuristic_match


# ---------------------------------------------------------------------------
# Heuristic backend
# ---------------------------------------------------------------------------

class HeuristicLLM:
    name = "heuristic"

    # -- brainstorming ----------------------------------------------------
    def brainstorm(self, question: str) -> list[str]:
        return [
            "Scope: should the search focus narrowly on the core approach named in "
            "your question, or also include earlier and adjacent approaches as "
            "comparison points?",
            "Purpose: is the goal mainly discovery and cataloguing of what exists, "
            "or should evaluation of quality and usefulness be a priority as well?",
        ]

    # -- criteria -----------------------------------------------------------
    def make_criteria(self, question: str, answers: dict[str, str] | None = None) -> list[str]:
        criteria = [question.strip()]
        focus_terms: list[str] = []
        if answers:
            joined_answers = " ".join(answers.values())
            focus_terms = [t for t in content_tokens(joined_answers) if len(t) > 4][:6]
        if focus_terms:
            criteria.append(question.strip() + " — focus: " + ", ".join(focus_terms))
        # A third, term-based criterion built from the question's content words.
        terms = [t for t in content_tokens(question) if len(t) > 4][:8]
        if terms:
            criteria.append("Papers about: " + " ".join(terms))
        return criteria

    # -- scoring ------------------------------------------------------------
    def score_matches(self, criteria: list[str], papers: list[Paper]) -> list[tuple[float, str]]:
        return [heuristic_match(criteria, p) for p in papers]

    # -- reflection (adapting stage) -----------------------------------------
    def reflect(self, criteria: list[str], top_papers: list[Paper], round_no: int) -> dict:
        seen = content_tokens(" ".join(criteria))
        fresh: list[str] = []
        for p in top_papers:
            for t in content_tokens(p.title):
                if t not in seen and len(t) > 4 and t not in fresh:
                    fresh.append(t)
        new_queries = []
        if fresh:
            new_queries.append(" ".join(fresh[:6]))
        return {"new_queries": new_queries, "stop": round_no >= 2}

    # -- report ---------------------------------------------------------------
    _FAMILY_KEYWORDS = [
        ("LLM / generative methods", ["llm", "language model", "generative", "gpt", "prompt"]),
        ("Profiling-driven methods", ["profiling", "profile", "statistics", "schema"]),
        ("Retrieval & embedding methods", ["retrieval", "embedding", "semantic search", "indexing"]),
        ("Template / rule-based methods", ["template", "rule", "ontology", "knowledge graph"]),
        ("Evaluation & benchmarking", ["evaluation", "benchmark", "quality", "assessment"]),
    ]

    def _family(self, paper: Paper) -> str:
        text = (paper.title + " " + (paper.abstract or "")).lower()
        best, best_hits = "Other approaches", 0
        for name, kws in self._FAMILY_KEYWORDS:
            hits = sum(1 for k in kws if k in text)
            if hits > best_hits:
                best, best_hits = name, hits
        return best

    @staticmethod
    def _first_sentence(text: str | None) -> str:
        if not text:
            return ""
        parts = re.split(r"(?<=[.!?])\s+", text.strip())
        return parts[0] if parts else ""

    def write_report(self, question: str, criteria: list[str], papers: list[Paper], focus: str | None = None) -> str:
        papers = sorted(papers, key=lambda p: (p.match or 0), reverse=True)
        lines: list[str] = []
        lines.append(f"# Literature search report")
        lines.append("")
        lines.append(f"**Research question.** {question}")
        lines.append("")
        lines.append("**Search criteria.**")
        for c in criteria:
            lines.append(f"- {c}")
        lines.append("")
        lines.append("## Executive summary")
        lines.append("")
        lines.append(
            f"This search retained {len(papers)} papers after relevance scoring and "
            f"citation snowballing. The strongest matches are "
            + ", ".join(f"[{p.key}]" for p in papers[:5])
            + ". The sections below group the retained papers by method family and "
            "summarize what each contributes, using the papers' own abstracts."
        )
        lines.append("")
        families: dict[str, list[Paper]] = {}
        for p in papers:
            families.setdefault(self._family(p), []).append(p)
        lines.append("## Method families")
        for fam, members in sorted(families.items(), key=lambda kv: -len(kv[1])):
            lines.append("")
            lines.append(f"### {fam}")
            lines.append("")
            for p in members[:6]:
                sentence = self._first_sentence(p.abstract) or (p.tldr or "")
                lines.append(f"- [{p.key}] {p.title} ({p.year or 'n.d.'}). {sentence}")
        lines.append("")
        lines.append("## Evaluation and limitations")
        lines.append("")
        lines.append(
            "Scores (MATCH) combine lexical relevance to the criteria with citation "
            "velocity and recency in offline mode; treat the ordering as a screening "
            "aid, not a quality judgement. Papers without abstracts could only be "
            "scored on titles, and citation counts favour older work."
        )
        lines.append("")
        lines.append("## References")
        lines.append("")
        lines.append("| KEY | Year | Cit/yr | Found via | Title |")
        lines.append("|---|---|---|---|---|")
        for p in papers:
            cpy = p.citations_per_year()
            lines.append(f"| {p.key} | {p.year or ''} | {cpy:.1f} | {p.found_via or 'search'} | {p.title} |")
        lines.append("")
        return "\n".join(lines)

    # -- table extraction ------------------------------------------------------
    def extract_row(self, paper: Paper, columns: list[str]) -> dict[str, str]:
        row: dict[str, str] = {}
        abstract = paper.abstract or ""
        for col in columns:
            c = col.lower()
            if "paper" in c or "title" in c:
                row[col] = f"[{paper.key}] {paper.title}"
            elif "year" in c:
                row[col] = str(paper.year or "")
            elif "author" in c:
                row[col] = ", ".join(paper.authors[:3])
            elif "venue" in c:
                row[col] = paper.venue or ""
            elif "citation" in c:
                row[col] = str(paper.citation_count)
            elif "method" in c or "approach" in c:
                row[col] = self._family(paper)
            else:
                # Find the abstract sentence mentioning the column's key term.
                term = c.split()[0] if c.split() else c
                sentence = next(
                    (s for s in re.split(r"(?<=[.!?])\s+", abstract) if term in s.lower()),
                    "",
                )
                row[col] = sentence[:200] if sentence else "—"
        return row

    # -- follow-up Q&A -----------------------------------------------------------
    def answer(self, question: str, papers: list[Paper]) -> str:
        ranked = sorted(papers, key=lambda p: (p.match or 0), reverse=True)[:5]
        bits = [f"Based on the {len(papers)} papers in this search, the most relevant sources are:"]
        for p in ranked:
            sentence = self._first_sentence(p.abstract) or (p.tldr or "")
            bits.append(f"- [{p.key}] {p.title}: {sentence}")
        bits.append("(Offline mode: connect an LLM via LLM_API_KEY for a synthesized answer.)")
        return "\n".join(bits)


# ---------------------------------------------------------------------------
# OpenAI-compatible backend
# ---------------------------------------------------------------------------

class OpenAIChatLLM(HeuristicLLM):
    name = "openai-compatible"

    def __init__(self, config: Config):
        self.config = config
        self.session = requests.Session()
        self.session.headers.update(
            {
                "Authorization": f"Bearer {config.llm_api_key}",
                "Content-Type": "application/json",
            }
        )

    def _chat(self, system: str, user: str, json_mode: bool = False) -> str:
        body: dict = {
            "model": self.config.llm_model,
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": user},
            ],
            "temperature": 0.2,
        }
        if json_mode:
            body["response_format"] = {"type": "json_object"}
        resp = self.session.post(
            f"{self.config.llm_base_url.rstrip('/')}/chat/completions",
            json=body,
            timeout=120,
        )
        resp.raise_for_status()
        return resp.json()["choices"][0]["message"]["content"]

    @staticmethod
    def _parse_json(text: str) -> dict | list | None:
        text = text.strip()
        if text.startswith("```"):
            text = re.sub(r"^```[a-z]*\n?|```$", "", text, flags=re.M).strip()
        try:
            return json.loads(text)
        except Exception:
            m = re.search(r"(\{.*\}|\[.*\])", text, flags=re.S)
            if m:
                try:
                    return json.loads(m.group(1))
                except Exception:
                    return None
            return None

    def brainstorm(self, question: str) -> list[str]:
        try:
            out = self._chat(
                "You are a research librarian. Before searching, ask exactly two short "
                "clarifying questions that pin down scope and purpose. Return JSON: "
                '{"questions": ["...", "..."]}',
                f"Research question: {question}",
                json_mode=True,
            )
            data = self._parse_json(out)
            if isinstance(data, dict) and data.get("questions"):
                return [str(q) for q in data["questions"]][:3]
        except Exception:
            pass
        return super().brainstorm(question)

    def make_criteria(self, question: str, answers: dict[str, str] | None = None) -> list[str]:
        try:
            answers_txt = "\n".join(f"- {k}: {v}" for k, v in (answers or {}).items()) or "(no answers)"
            out = self._chat(
                "You convert a research question into 2-4 natural-language search "
                "criteria statements that a literature search engine will execute. "
                'Return JSON: {"criteria": ["...", "..."]}',
                f"Question: {question}\nClarifying answers:\n{answers_txt}",
                json_mode=True,
            )
            data = self._parse_json(out)
            if isinstance(data, dict) and data.get("criteria"):
                return [str(c) for c in data["criteria"]][:4]
        except Exception:
            pass
        return super().make_criteria(question, answers)

    def score_matches(self, criteria: list[str], papers: list[Paper]) -> list[tuple[float, str]]:
        results: list[tuple[float, str]] = []
        batch_size = 10
        for i in range(0, len(papers), batch_size):
            batch = papers[i : i + batch_size]
            try:
                listing = "\n".join(
                    f"{j}. TITLE: {p.title}\n   ABSTRACT: {(p.abstract or '')[:600]}"
                    for j, p in enumerate(batch)
                )
                out = self._chat(
                    "You judge how well each paper matches the search criteria. "
                    "Score 0-100 (100 = directly on-topic). Return JSON: "
                    '{"scores": [{"index": 0, "score": 87, "reason": "short reason"}]}',
                    f"Criteria:\n- " + "\n- ".join(criteria) + f"\n\nPapers:\n{listing}",
                    json_mode=True,
                )
                data = self._parse_json(out)
                by_index: dict[int, tuple[float, str]] = {}
                if isinstance(data, dict):
                    for s in data.get("scores") or []:
                        by_index[int(s["index"])] = (float(s["score"]), str(s.get("reason", "")))
                for j, p in enumerate(batch):
                    results.append(by_index.get(j) or heuristic_match(criteria, p))
            except Exception:
                results.extend(heuristic_match(criteria, p) for p in batch)
        return results

    def reflect(self, criteria: list[str], top_papers: list[Paper], round_no: int) -> dict:
        try:
            titles = "\n".join(f"- {p.title}" for p in top_papers[:10])
            out = self._chat(
                    "You are reflecting on a literature search in progress. Given the "
                    "criteria and the best papers so far, propose up to 2 new search "
                    "queries that would find relevant papers the criteria miss, and say "
                    "whether the search looks saturated. Return JSON: "
                    '{"new_queries": ["..."], "stop": false}',
                "Criteria:\n- " + "\n- ".join(criteria) + f"\n\nBest papers so far:\n{titles}",
                json_mode=True,
            )
            data = self._parse_json(out)
            if isinstance(data, dict):
                return {
                    "new_queries": [str(q) for q in data.get("new_queries") or []][:2],
                    "stop": bool(data.get("stop")),
                }
        except Exception:
            pass
        return super().reflect(criteria, top_papers, round_no)

    def write_report(self, question: str, criteria: list[str], papers: list[Paper], focus: str | None = None) -> str:
        try:
            listing = "\n".join(
                f"[{p.key}] {p.title} ({p.year or 'n.d.'}) — {(p.abstract or '')[:800]}"
                for p in papers
            )
            focus_txt = f"\nReport focus requested by the user: {focus}" if focus else ""
            return self._chat(
                "You write structured literature-search reports in Markdown. Use ONLY "
                "the papers provided, cite them inline with their [KEY] tokens, group "
                "methods into families, include sections: Executive summary; What "
                "counts as in-scope; Inputs and evidence used; Output types and method "
                "families; How quality is evaluated; Reliability and limits; Practical "
                "synthesis; Bottom line. End with a references table (KEY | Year | "
                "Cit/yr | Title).",
                f"Research question: {question}{focus_txt}\n\nPapers:\n{listing}",
            )
        except Exception:
            return super().write_report(question, criteria, papers, focus)

    def extract_row(self, paper: Paper, columns: list[str]) -> dict[str, str]:
        try:
            out = self._chat(
                "Extract values for the requested columns from the paper's title and "
                "abstract. If a value is not stated, use '—'. Return JSON with exactly "
                "the requested column names as keys.",
                f"Columns: {columns}\nTitle: {paper.title}\nAbstract: {(paper.abstract or '')[:2000]}",
                json_mode=True,
            )
            data = self._parse_json(out)
            if isinstance(data, dict):
                return {c: str(data.get(c, "—")) for c in columns}
        except Exception:
            pass
        return super().extract_row(paper, columns)

    def answer(self, question: str, papers: list[Paper]) -> str:
        try:
            listing = "\n".join(
                f"[{p.key}] {p.title} ({p.year or 'n.d.'}) — {(p.abstract or '')[:700]}"
                for p in sorted(papers, key=lambda x: (x.match or 0), reverse=True)[:15]
            )
            return self._chat(
                "Answer the user's follow-up question using ONLY the papers provided. "
                "Cite papers inline with their [KEY] tokens. If the papers do not "
                "cover the question, say so.",
                f"Question: {question}\n\nPapers:\n{listing}",
            )
        except Exception:
            return super().answer(question, papers)


# ---------------------------------------------------------------------------
# Gemini via the custom.gemini connector (credential stays in the vault)
# ---------------------------------------------------------------------------

class GeminiConnectorLLM(OpenAIChatLLM):
    """OpenAI-shaped calls to Gemini, executed by the connector helper.

    The helper (custom.gemini/bin/gemini.py) attaches an ``hsurr:``
    surrogate to each request; the real API key is swapped in by the
    runtime on egress to generativelanguage.googleapis.com. This class
    therefore never sees a credential. All prompting, batching and
    fallbacks are inherited from OpenAIChatLLM; only the transport
    differs.
    """

    name = "gemini-connector"

    def __init__(self, config: Config):
        self.config = config
        self.session = None  # transport is the helper subprocess, not requests

    def _chat(self, system: str, user: str, json_mode: bool = False) -> str:
        body: dict = {
            "model": self.config.llm_model,
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": user},
            ],
            "temperature": 0.2,
        }
        if json_mode:
            body["response_format"] = {"type": "json_object"}
        # The egress path to Google intermittently stalls (observed reads
        # hanging past 180s). Retry a few times before giving up; callers
        # degrade to the heuristic backend only after every attempt fails.
        last_error: Exception | None = None
        for attempt, pause in enumerate((0, 5, 15)):
            if pause:
                time.sleep(pause)
            try:
                proc = subprocess.run(
                    [sys.executable, str(self.config.gemini_helper), "chat"],
                    input=json.dumps(body),
                    capture_output=True,
                    text=True,
                    timeout=150,
                )
                if proc.returncode != 0:
                    raise RuntimeError(f"gemini helper failed: {proc.stderr.strip()[-400:]}")
                data = json.loads(proc.stdout)
                return data["choices"][0]["message"]["content"]
            except Exception as exc:  # timeout, helper error, bad payload
                last_error = exc
        raise RuntimeError(f"gemini connector failed after retries: {last_error}")


def get_llm(config: Config) -> HeuristicLLM:
    if config.llm_backend == "gemini-connector":
        return GeminiConnectorLLM(config)
    if config.llm_backend == "heuristic":
        return HeuristicLLM()
    if config.llm_api_key:
        return OpenAIChatLLM(config)
    return HeuristicLLM()
"""The deep-search engine: orchestrates retrieval, scoring, snowballing.

Stage names intentionally mirror the reference product's progress UI:
Interpreting → Searching → Identifying → Reflecting → Adapting → Done.
A `progress` callback receives (stage, detail) pairs so CLI, Web UI and
tests can all observe the run.
"""

from __future__ import annotations

from typing import Callable

from .clients.openalex import OpenAlexClient
from .clients.semantic_scholar import RateLimited, SemanticScholarClient
from .llm import HeuristicLLM
from .models import Paper, SearchOutcome
from .scoring import dedupe, identity_keys
from .store import Store

ProgressFn = Callable[[str, str], None]


def _noop(stage: str, detail: str) -> None:
    pass


class DeepSearchEngine:
    def __init__(
        self,
        s2: SemanticScholarClient,
        openalex: OpenAlexClient | None,
        llm: HeuristicLLM,
        store: Store,
        include_threshold: float = 55.0,
        crossref=None,
    ):
        self.s2 = s2
        self.openalex = openalex
        self.llm = llm
        self.store = store
        self.include_threshold = include_threshold
        self.crossref = crossref

    # ------------------------------------------------------------------
    def brainstorm(self, question: str) -> list[str]:
        return self.llm.brainstorm(question)

    def build_criteria(self, question: str, answers: dict[str, str] | None = None) -> list[str]:
        return self.llm.make_criteria(question, answers)

    # ------------------------------------------------------------------
    def _score(self, criteria: list[str], papers: list[Paper]) -> list[Paper]:
        scores = self.llm.score_matches(criteria, papers)
        for paper, (score, reason) in zip(papers, scores):
            paper.match = score
            paper.match_reason = reason
        return papers

    def _snowball(self, seeds: list[Paper], warnings: list[str], limit_per_seed: int = 30) -> list[Paper]:
        out: list[Paper] = []
        for seed in seeds:
            label = f"[{seed.key}]" if seed.key else f"'{seed.title[:40]}'"
            for fetcher, direction in ((self.s2.citations, "citations"), (self.s2.references, "references")):
                try:
                    found = fetcher(seed.paper_id, limit=limit_per_seed)
                except Exception as exc:
                    warnings.append(f"{direction} lookup failed for {label}: {exc}")
                    continue
                for p in found:
                    if p.found_via is None:
                        p.found_via = f"{direction} of {label}"
                    out.append(p)
        return out

    # ------------------------------------------------------------------
    @staticmethod
    def estimate_coverage(
        s2_relevant: set[str], oa_relevant: set[str], found_relevant: int
    ) -> dict | None:
        """Lincoln–Petersen / Chapman capture–recapture over two channels.

        Treats Semantic Scholar and OpenAlex as two independent "captures"
        of the same relevant-paper population. Only meaningful when both
        channels returned relevant papers with some overlap.
        """
        n1, n2 = len(s2_relevant), len(oa_relevant)
        m = len(s2_relevant & oa_relevant)
        if n1 < 3 or n2 < 3 or m == 0:
            return None
        total_est = ((n1 + 1) * (n2 + 1) / (m + 1)) - 1
        if total_est <= 0:
            return None
        coverage = max(0.0, min(1.0, found_relevant / total_est))
        return {
            "method": "capture-recapture (Chapman) over Semantic Scholar vs OpenAlex relevant sets",
            "estimated_total_relevant": round(total_est, 1),
            "found_relevant": found_relevant,
            "estimated_coverage": round(coverage, 3),
            "channel_sizes": {"semantic_scholar": n1, "openalex": n2, "overlap": m},
        }

    # ------------------------------------------------------------------
    def trace(
        self,
        seed: Paper,
        question: str | None = None,
        project: str = "default",
        hops: int = 1,
        per_direction: int = 40,
        progress: ProgressFn = _noop,
    ) -> SearchOutcome:
        """Citation-graph traversal from one seed paper ("相互查找").

        Expands both directions — papers the seed cites (references) and
        papers citing it (citations) — scores every neighbour against the
        question (or the seed itself), and stores the neighbourhood as a
        normal search so it can be reported, extracted and asked about.
        """
        warnings: list[str] = []
        criteria = [question] if question else [seed.title, seed.abstract or seed.title]
        label = f"Papers connected to: {seed.title}"
        search_id = self.store.create_search(project, label, criteria, {})
        seed.db_id = self.store.upsert_paper(seed)  # type: ignore[attr-defined]
        progress("Tracing citation graph", f"seed [{seed.key}] {seed.title}")

        seen_keys: set[str] = set(identity_keys(seed))
        pool: list[Paper] = []
        frontier = [seed]
        converged = False
        rounds_done = 0
        for hop in range(1, hops + 1):
            rounds_done = hop
            nxt: list[Paper] = []
            for node in frontier:
                node_label = f"[{node.key}]" if node.key else f"'{node.title[:40]}'"
                for fetcher, direction in ((self.s2.citations, "citations"), (self.s2.references, "references")):
                    try:
                        found = fetcher(node.paper_id, limit=per_direction)
                    except Exception as exc:
                        warnings.append(f"{direction} lookup failed for {node_label}: {exc}")
                        continue
                    for p in found:
                        if identity_keys(p) & seen_keys:
                            continue
                        seen_keys |= identity_keys(p)
                        if p.found_via is None:
                            p.found_via = f"{direction} of {node_label}"
                        pool.append(p)
                        nxt.append(p)
            if not nxt:
                converged = not warnings
                break
            # Score this hop before deciding the next frontier.
            hop_scored = self._score(criteria, nxt)
            for p in hop_scored:
                p.db_id = self.store.upsert_paper(p)  # type: ignore[attr-defined]
            frontier = sorted(
                (p for p in hop_scored if (p.match or 0) >= self.include_threshold),
                key=lambda p: -(p.match or 0),
            )[:5]
            progress("Adapting and searching again", f"hop {hop}: {len(nxt)} neighbours")
            if not frontier:
                converged = not warnings
                break

        included = [p for p in pool if (p.match or 0) >= self.include_threshold]
        included.sort(key=lambda p: -(p.match or 0))
        included_db_ids = {getattr(p, "db_id") for p in included}
        counts = {
            "found": len(included),
            "with_full_text": sum(1 for p in included if p.has_full_text),
            "excluded": len(pool) - len(included),
            "candidates": len(pool),
        }
        self.store.save_results(search_id, pool, included_db_ids, counts, None,
                                degraded=bool(warnings), warnings=warnings, converged=converged)
        progress("Done", f"{counts['found']} connected papers · {counts['excluded']} excluded")
        return SearchOutcome(
            search_id=search_id,
            question=label,
            criteria=criteria,
            included=included,
            excluded_count=counts["excluded"],
            with_full_text=counts["with_full_text"],
            rounds=rounds_done,
            converged=converged,
            coverage=None,
            warnings=warnings,
            degraded=bool(warnings),
        )

    # ------------------------------------------------------------------
    def run(
        self,
        question: str,
        criteria: list[str],
        answers: dict[str, str] | None = None,
        project: str = "default",
        per_query: int = 40,
        max_rounds: int = 2,
        seed_top: int = 8,
        progress: ProgressFn = _noop,
    ) -> SearchOutcome:
        warnings: list[str] = []
        search_id = self.store.create_search(project, question, criteria, answers or {})
        progress("Interpreting your search criteria", f"{len(criteria)} criteria")

        # -- Searching ---------------------------------------------------
        progress("Searching for the most promising papers", "Semantic Scholar + OpenAlex")
        pool: list[Paper] = []
        queries = list(dict.fromkeys([question, *criteria]))
        for q in queries:
            try:
                pool.extend(self.s2.search(q, limit=per_query))
            except RateLimited:
                warnings.append(f"Semantic Scholar initial search rate-limited for query {q!r}.")
                continue
            except Exception as exc:  # network etc.
                warnings.append(f"Semantic Scholar initial search failed for query {q!r}: {exc}")
                continue
        try:
            if self.openalex is not None:
                pool.extend(self.openalex.search(question, per_page=25))
        except Exception as exc:
            warnings.append(f"OpenAlex initial search failed for query {question!r}: {exc}")
        if self.crossref is not None:
            try:
                pool.extend(self.crossref.search(question, rows=per_query))
            except Exception as exc:
                warnings.append(f"Crossref initial search failed for query {question!r}: {exc}")

        pool = dedupe(pool)
        for p in pool:
            if p.found_via is None:
                p.found_via = "search"

        # -- Identifying ---------------------------------------------------
        progress("Identifying the best candidate papers", f"{len(pool)} candidates")
        scored = self._score(criteria, pool)
        included = [p for p in scored if (p.match or 0) >= self.include_threshold]
        seen_keys: set[str] = set()
        for p in scored:
            seen_keys |= identity_keys(p)
        # Persist early so included papers have citation KEYs; snowball
        # provenance labels ("citations of [Key]") depend on them.
        for p in scored:
            p.db_id = self.store.upsert_paper(p)  # type: ignore[attr-defined]

        # -- Reflecting / Adapting (snowball rounds) -------------------------
        rounds_done = 0
        converged = False
        for round_no in range(1, max_rounds + 1):
            rounds_done = round_no
            progress("Reflecting on the results", f"round {round_no}")
            reflection = self.llm.reflect(criteria, sorted(included, key=lambda p: -(p.match or 0)), round_no)
            seeds = sorted(included, key=lambda p: -(p.match or 0))[:seed_top]
            progress("Adapting and searching again", f"snowballing from {len(seeds)} seeds")
            candidates = dedupe(self._snowball(seeds, warnings))
            # The reflection step may propose fresh queries; run them too.
            for new_q in reflection.get("new_queries") or []:
                try:
                    extra = self.s2.search(new_q, limit=20)
                    for p in extra:
                        if p.found_via is None:
                            p.found_via = "reflection query"
                    candidates = dedupe(candidates + extra)
                except Exception as exc:
                    seed_labels = ", ".join(f"[{p.key}]" if p.key else repr(p.title[:40]) for p in seeds) or "no seeds"
                    warnings.append(f"reflection query search failed for {new_q!r} (seeds: {seed_labels}): {exc}")
            candidates = [c for c in candidates if not (identity_keys(c) & seen_keys)]
            for c in candidates:
                seen_keys |= identity_keys(c)
            if not candidates:
                converged = not warnings
                break
            new_scored = self._score(criteria, candidates)
            for p in new_scored:
                p.db_id = self.store.upsert_paper(p)  # type: ignore[attr-defined]
            scored.extend(new_scored)
            new_included = [p for p in new_scored if (p.match or 0) >= self.include_threshold]
            included.extend(new_included)
            gain = len(new_included) / max(1, len(included))
            if reflection.get("stop") or gain < 0.03:
                converged = not warnings
                break

        included.sort(key=lambda p: -(p.match or 0))

        # Persist papers and results; capture db ids for coverage sets.
        s2_rel: set[str] = set()
        oa_rel: set[str] = set()
        included_db_ids: set[int] = set()
        for p in scored:
            db_id = self.store.upsert_paper(p)
            p.db_id = db_id  # type: ignore[attr-defined]
            if (p.match or 0) >= self.include_threshold:
                if "semantic_scholar" in p.sources:
                    s2_rel.add(p.paper_id)
                if "openalex" in p.sources:
                    oa_rel.add(p.paper_id)
        for p in included:
            included_db_ids.add(getattr(p, "db_id"))

        coverage = self.estimate_coverage(s2_rel, oa_rel, len(included))
        counts = {
            "found": len(included),
            "with_full_text": sum(1 for p in included if p.has_full_text),
            "excluded": len(scored) - len(included),
            "candidates": len(scored),
        }
        self.store.save_results(search_id, scored, included_db_ids, counts, coverage,
                                degraded=bool(warnings), warnings=warnings, converged=converged)
        # save_results upserts again internally for any paper missing db_id; keep ids consistent.
        progress("Done", f"{counts['found']} papers · {counts['with_full_text']} with full text · {counts['excluded']} excluded")

        return SearchOutcome(
            search_id=search_id,
            question=question,
            criteria=criteria,
            included=included,
            excluded_count=counts["excluded"],
            with_full_text=counts["with_full_text"],
            rounds=rounds_done,
            converged=converged,
            coverage=coverage,
            warnings=warnings,
            degraded=bool(warnings),
        )

