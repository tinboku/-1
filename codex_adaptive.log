import tempfile
import unittest
from pathlib import Path

from dls.engine import DeepSearchEngine
from dls.llm import HeuristicLLM
from dls.models import Paper
from dls.store import Store

CRITERIA = [
    "natural-language descriptions of tabular datasets using large language "
    "models, including data profiling and metadata generation for catalogs"
]
ABSTRACT = (
    "We generate natural language descriptions of tabular datasets using large "
    "language models, with data profiling and metadata generation for dataset "
    "catalogs and discovery."
)


def mk(pid, title, abstract=ABSTRACT, year=2025, cites=30, doi=None, source="semantic_scholar", authors=None):
    return Paper(
        paper_id=pid, title=title, abstract=abstract, year=year,
        authors=authors or ["Alice Zhang"], citation_count=cites, doi=doi, source=source,
    )


P1 = mk("s2-1", "AutoDDG: Automated Dataset Description Generation", doi="10.1/a")
P2_S2 = mk("s2-2", "Polaris: Structured Dataset Descriptions", year=2026, cites=5, doi="10.1/b")
P2_OA = mk("W2", "Polaris: Structured Dataset Descriptions", year=2026, cites=5, doi="10.1/b", source="openalex")
P3 = mk(
    "s2-3", "Quantum error correction with surface codes",
    abstract="Fault tolerant quantum computation with surface codes and decoders.",
    year=2024, cites=900,
)
P4 = mk("s2-4", "Dataset Metadata Generation for Catalogs", year=2023, cites=12, doi="10.1/d")
P5 = mk("W5", "Metadata Generation for Dataset Discovery", year=2026, cites=3, source="openalex")
P6 = mk("W6", "Tabular Dataset Descriptions with Language Models", year=2026, cites=2, source="openalex")


class FakeS2:
    def search(self, query, limit=50, offset=0, year=None):
        return [P1, P2_S2, P3]

    def citations(self, paper_id, limit=50):
        return [P4] if paper_id == "s2-1" else []

    def references(self, paper_id, limit=50):
        return []


class FakeOpenAlex:
    def search(self, query, per_page=25):
        return [P2_OA, P5, P6]


class TestEngine(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.store = Store(Path(self.tmp.name) / "test.db")
        self.engine = DeepSearchEngine(FakeS2(), FakeOpenAlex(), HeuristicLLM(), self.store)

    def tearDown(self):
        self.tmp.cleanup()

    def test_full_run(self):
        outcome = self.engine.run("dataset descriptions with LLMs", CRITERIA, per_query=10)
        # Included: P1, P2 (merged), P5, P6 from search + P4 from snowballing. P3 excluded.
        self.assertEqual(outcome.found, 5)
        self.assertEqual(outcome.excluded_count, 1)
        self.assertTrue(outcome.converged)
        self.assertGreaterEqual(outcome.rounds, 1)
        titles = [p.title for p in outcome.included]
        self.assertTrue(any("AutoDDG" in t for t in titles))
        self.assertTrue(any("Metadata Generation for Catalogs" in t for t in titles))
        # Provenance: the snowballed paper records which seed it came from.
        snowballed = [p for p in outcome.included if "Catalogs" in p.title][0]
        self.assertEqual(snowballed.found_via, "citations of [Zhang25]")
        stored_snow = [p for p in self.store.search_papers(outcome.search_id) if "Catalogs" in p.title][0]
        self.assertEqual(stored_snow.found_via, "citations of [Zhang25]")
        for p in outcome.included:
            self.assertIsNotNone(p.key)
            self.assertGreaterEqual(p.match, 55)
        # Coverage: S2 relevant {P1,P2,P4}=3, OA relevant {P2,P5,P6}=3, overlap {P2}=1
        self.assertIsNotNone(outcome.coverage)
        self.assertAlmostEqual(outcome.coverage["estimated_total_relevant"], 7.0)
        self.assertAlmostEqual(outcome.coverage["estimated_coverage"], 5 / 7, places=3)
        # Persisted
        stored = self.store.search_papers(outcome.search_id, included_only=True)
        self.assertEqual(len(stored), 5)
        search = self.store.get_search(outcome.search_id)
        self.assertEqual(search["counts"]["found"], 5)


class FakeS2Clone:
    """Returns the seed paper again under a different id (cross-source clone)."""

    def search(self, query, limit=50, offset=0, year=None):
        return [P1]

    def citations(self, paper_id, limit=50):
        clone = mk("doi:10.1/a", P1.title, year=2025, cites=30, doi="10.1/a", source="crossref")
        return [clone]

    def references(self, paper_id, limit=50):
        return []


class TestCrossSourceDedup(unittest.TestCase):
    def test_clone_not_double_counted(self):
        with tempfile.TemporaryDirectory() as td:
            store = Store(Path(td) / "t.db")
            engine = DeepSearchEngine(FakeS2Clone(), None, HeuristicLLM(), store)
            outcome = engine.run("dataset descriptions with LLMs", CRITERIA, per_query=10)
            self.assertEqual(outcome.found, 1)
            self.assertEqual(outcome.included[0].title, P1.title)


class TestTrace(unittest.TestCase):
    def test_trace_from_seed(self):
        with tempfile.TemporaryDirectory() as td:
            store = Store(Path(td) / "t.db")
            engine = DeepSearchEngine(FakeS2(), None, HeuristicLLM(), store)
            seed = mk("s2-1", "AutoDDG: Automated Dataset Description Generation", doi="10.1/a")
            outcome = engine.trace(seed, question=CRITERIA[0])
            # FakeS2.citations(s2-1) -> [P4]; references -> [].
            self.assertEqual(outcome.found, 1)
            self.assertEqual(outcome.included[0].title, P4.title)
            self.assertEqual(outcome.included[0].found_via, "citations of [Zhang25]")


if __name__ == "__main__":
    unittest.main()
"""Offline regression tests for honest convergence and persisted diagnostics."""

import sqlite3
import tempfile
import unittest
from pathlib import Path
from unittest.mock import Mock

from dls.engine import DeepSearchEngine
from dls.models import Paper
from dls.store import SCHEMA, Store


class TestConvergence(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.path = Path(self.tmp.name) / "test.db"
        self.store = Store(self.path)
        self.addCleanup(self.store.conn.close)
        self.seed = Paper("seed", "Seed paper", key="Seed25")
        self.s2 = Mock()
        self.s2.search.return_value = [self.seed]
        self.s2.citations.return_value = []
        self.s2.references.return_value = []
        self.llm = Mock()
        self.llm.score_matches.side_effect = lambda criteria, papers: [(90, "relevant") for _ in papers]
        self.llm.reflect.return_value = {"new_queries": [], "stop": False}
        self.engine = DeepSearchEngine(self.s2, None, self.llm, self.store)

    def assert_status(self, outcome, converged, degraded):
        self.assertEqual(outcome.converged, converged)
        self.assertEqual(outcome.degraded, degraded)
        stored = self.store.get_search(outcome.search_id)
        self.assertEqual(stored["converged"], converged)
        self.assertEqual(stored["degraded"], degraded)
        self.assertEqual(stored["warnings"], outcome.warnings)

    def test_snowball_all_failed(self):
        self.s2.citations.side_effect = RuntimeError("citations offline")
        self.s2.references.side_effect = RuntimeError("references offline")
        outcome = self.engine.run("q", ["q"])
        self.assert_status(outcome, False, True)
        self.assertEqual(len(outcome.warnings), 2)
        self.assertIn("citations lookup failed for [Seed25]", outcome.warnings[0])
        self.assertIn("references lookup failed for [Seed25]", outcome.warnings[1])

    def test_initial_all_failed(self):
        self.s2.search.side_effect = RuntimeError("S2 offline")
        self.engine.openalex = Mock()
        self.engine.openalex.search.side_effect = RuntimeError("OA offline")
        self.engine.crossref = Mock()
        self.engine.crossref.search.side_effect = RuntimeError("Crossref offline")
        outcome = self.engine.run("q", ["q"])
        self.assert_status(outcome, False, True)
        self.assertEqual(outcome.found, 0)
        self.assertEqual(len(outcome.warnings), 3)

    def test_initial_failure_without_rounds(self):
        self.s2.search.side_effect = RuntimeError("offline")
        self.assert_status(self.engine.run("q", ["q"], max_rounds=0), False, True)

    def test_normal_no_new_candidates(self):
        outcome = self.engine.run("q", ["q"])
        self.assert_status(outcome, True, False)
        self.assertEqual(outcome.warnings, [])

    def test_successful_empty_initial_search(self):
        self.s2.search.return_value = []
        self.assert_status(self.engine.run("q", ["q"]), True, False)

    def test_reflection_query_failure(self):
        self.llm.reflect.return_value = {"new_queries": ["fresh query"], "stop": False}
        self.s2.search.side_effect = [[self.seed], RuntimeError("reflection offline")]
        outcome = self.engine.run("q", ["q"])
        self.assert_status(outcome, False, True)
        self.assertIn("reflection query", outcome.warnings[0])
        self.assertIn("fresh query", outcome.warnings[0])
        self.assertIn("[Seed25]", outcome.warnings[0])

    def test_previous_round_failure_is_not_forgotten(self):
        self.s2.citations.side_effect = [RuntimeError("offline"), [], []]
        self.s2.references.side_effect = [[Paper("next", "Next paper")], [], []]
        self.assert_status(self.engine.run("q", ["q"]), False, True)

    def test_reflection_stop_with_failed_channel(self):
        self.s2.citations.side_effect = RuntimeError("offline")
        self.s2.references.return_value = [Paper("next", "Next paper")]
        self.llm.reflect.return_value = {"new_queries": [], "stop": True}
        self.assert_status(self.engine.run("q", ["q"]), False, True)

    def test_trace_exhausted(self):
        self.assert_status(self.engine.trace(self.seed), True, False)

    def test_trace_failed(self):
        self.s2.citations.side_effect = RuntimeError("offline")
        outcome = self.engine.trace(self.seed)
        self.assert_status(outcome, False, True)
        self.assertIn("citations lookup failed for [Seed25]", outcome.warnings[0])

    def test_trace_hop_limit_is_not_convergence(self):
        self.s2.citations.return_value = [Paper("next", "Next paper")]
        outcome = self.engine.trace(self.seed, hops=1)
        self.assert_status(outcome, False, False)
        self.assertEqual(outcome.rounds, 1)

    def test_trace_converges_after_frontier_exhausted(self):
        self.s2.citations.side_effect = [[Paper("next", "Next paper")], []]
        outcome = self.engine.trace(self.seed, hops=3)
        self.assert_status(outcome, True, False)
        self.assertEqual(outcome.rounds, 2)

    def test_diagnostics_survive_reopen(self):
        self.s2.citations.side_effect = RuntimeError("offline")
        outcome = self.engine.run("q", ["q"])
        reopened = Store(self.path)
        self.addCleanup(reopened.conn.close)
        stored = reopened.get_search(outcome.search_id)
        self.assertTrue(stored["degraded"])
        self.assertEqual(stored["warnings"], outcome.warnings)

    def test_legacy_database_migration_is_repeatable(self):
        path = Path(self.tmp.name) / "legacy.db"
        with sqlite3.connect(path) as conn:
            conn.executescript(SCHEMA)
            conn.execute("INSERT INTO projects (id, name, created_at) VALUES (1, 'old', 0)")
            conn.execute("INSERT INTO searches (project_id, question, created_at) VALUES (1, 'q', 0)")
        for _ in range(2):
            migrated = Store(path)
            try:
                stored = migrated.get_search(1)
                self.assertFalse(stored["degraded"])
                self.assertFalse(stored["converged"])
                self.assertEqual(stored["warnings"], [])
            finally:
                migrated.conn.close()
import json
import unittest
from unittest import mock

from dls.config import Config
from dls.llm import GeminiConnectorLLM, HeuristicLLM, get_llm


class TestFactory(unittest.TestCase):
    def test_gemini_connector_backend(self):
        llm = get_llm(Config(llm_backend="gemini-connector", llm_model="gemini-3.8-flash"))
        self.assertIsInstance(llm, GeminiConnectorLLM)

    def test_heuristic_backend(self):
        llm = get_llm(Config(llm_backend="heuristic"))
        self.assertIs(type(llm), HeuristicLLM)


class TestGeminiChatTransport(unittest.TestCase):
    def setUp(self):
        self.llm = GeminiConnectorLLM(
            Config(llm_backend="gemini-connector", llm_model="gemini-3.8-flash")
        )

    def test_chat_parses_helper_output(self):
        fake = mock.Mock(
            returncode=0,
            stdout=json.dumps({"choices": [{"message": {"content": "ready"}}]}),
            stderr="",
        )
        with mock.patch("dls.llm.subprocess.run", return_value=fake) as run:
            out = self.llm._chat("sys", "hi", json_mode=True)
        self.assertEqual(out, "ready")
        payload = json.loads(run.call_args.kwargs["input"])
        self.assertEqual(payload["model"], "gemini-3.8-flash")
        self.assertEqual(payload["response_format"], {"type": "json_object"})
        self.assertEqual(payload["messages"][1]["content"], "hi")

    def test_chat_raises_on_helper_failure(self):
        fake = mock.Mock(returncode=1, stdout="", stderr="boom")
        with mock.patch("dls.llm.subprocess.run", return_value=fake), \
             mock.patch("dls.llm.time.sleep", return_value=None):
            with self.assertRaises(RuntimeError):
                self.llm._chat("sys", "hi")

    def test_chat_retries_then_succeeds(self):
        bad = mock.Mock(returncode=1, stdout="", stderr="stall")
        good = mock.Mock(
            returncode=0,
            stdout=json.dumps({"choices": [{"message": {"content": "ok"}}]}),
            stderr="",
        )
        with mock.patch("dls.llm.subprocess.run", side_effect=[bad, good]) as run, \
             mock.patch("dls.llm.time.sleep", return_value=None):
            out = self.llm._chat("sys", "hi")
        self.assertEqual(out, "ok")
        self.assertEqual(run.call_count, 2)


if __name__ == "__main__":
    unittest.main()
"""Core data types shared across clients, the engine and the store."""

from __future__ import annotations

from dataclasses import dataclass, field


@dataclass
class Paper:
    paper_id: str  # canonical id: S2 id, "W..." OpenAlex id, or "doi:..."
    title: str
    abstract: str | None = None
    year: int | None = None
    authors: list[str] = field(default_factory=list)
    venue: str | None = None
    citation_count: int = 0
    reference_count: int = 0
    doi: str | None = None
    arxiv_id: str | None = None
    open_access_pdf: str | None = None
    url: str | None = None
    tldr: str | None = None
    source: str = "semantic_scholar"
    sources: list[str] = field(default_factory=list)  # every channel that found it

    # Filled in by scoring / storage layers
    key: str | None = None        # citation key, e.g. "Zha25"
    match: float | None = None    # 0..100 relevance to a search's criteria
    match_reason: str | None = None
    found_via: str | None = None  # provenance: "search", "citations of [Key]", ...

    def __post_init__(self) -> None:
        if self.source and self.source not in self.sources:
            self.sources.append(self.source)

    @property
    def has_full_text(self) -> bool:
        return bool(self.open_access_pdf)

    def citations_per_year(self, current_year: int = 2026) -> float:
        if not self.year:
            return float(self.citation_count)
        age = max(1, current_year - self.year + 1)
        return self.citation_count / age

    def first_author_surname(self) -> str:
        if not self.authors:
            return "Anon"
        name = self.authors[0].strip()
        if not name:
            return "Anon"
        # "First Last" -> "Last"; keep only letters for a compact key.
        last = name.split()[-1]
        cleaned = "".join(ch for ch in last if ch.isalpha())
        return cleaned or "Anon"


@dataclass
class SearchOutcome:
    search_id: int
    question: str
    criteria: list[str]
    included: list[Paper]
    excluded_count: int
    with_full_text: int
    rounds: int
    converged: bool
    coverage: dict | None  # discovery-curve estimate, see engine.estimate_coverage
    warnings: list[str] = field(default_factory=list)
    degraded: bool = False

    @property
    def found(self) -> int:
        return len(self.included)
# Undermind 行为规格（黑盒）v0.2 — 实测版

日期：2026-11-02
方法：用已有免费账号登录 app.undermind.ai，完整跑通一次真实搜索
（描述生成测试问题）+ 报告生成 + 聊天抽表，并逐页盘点了工作区功能。
证据分级：= 本次亲眼确认；= 官网/FAQ 说法；
= 评测站描述；未标注的均为。

## 1. 账号与登录

- 已有免费账号即可用；登录方式为邮箱 + 6 位验证码（无密码登录流程）。
- 账号标识："TB tin boku Free"，带 "Upgrade to Pro" 入口。
- 官网无游客模式（v0.1 已确认）：不注册连搜索框都看不到。

## 2. 工作区结构

- 对象类型：Searches、Chats、Files、Papers（论文库）、Folders、Uploads。
- 侧边栏：New chat、Add papers、All Papers、Starred、Uploads、Files、
Chats、Updates；底部主视图切换：Browse / Read / Chat。
- 顶部是标签页式导航，可同时打开多个搜索、报告文件、论文库页签。
- 论文的稳定标识是作者年简码 KEY（如 Zha25、Cai26b），全站通用：
结果列表、报告行内引用、文末论文表都用它。

## 3. 一次搜索的完整流程（实测时间线，2026-11-02 JST）

1. **提交问题**（17:20）：在 Chat 里输入自然语言研究问题，
状态文案依次出现 Papertrailing… 等。
2. **头脑风暴澄清**（17:21，状态 Brainstorming…）：先问 2 道问题再搜——
一道问范围取舍（只看 LLM 方法，还是纳入早期非 LLM 方法作对比）；
一道问用途与重点（面向编目/数据集发现还是更广的表格理解，
评估是否优先）。可答可不答。
3. **生成搜索草稿**（状态 Crafting…）：产出一个带标题的搜索草稿，
核心是 "Search criteria"——一组自然语言检索标准句（本次 2 条，
分别覆盖"自动生成表格数据集自然语言描述/画像/元数据的方法"和
"含非 LLM 早期方法、面向编目与发现的方法与评估"），用户确认后点 Launch。
4. **深度搜索运行**（17:22 → 约 17:28，约 6 分钟）：进度页阶段标签按序为
Interpreting your search criteria → Searching for the most promising
papers → Identifying the best candidate papers → Reflecting on the
results → Adapting and searching again；顶部状态词 Deepdigging…，
有 Stop 按钮。**没有实时篇数计数器**，跑完才给最终计数。
5. **结果页**：标题行 "52 papers · 36 with full text · 12 excluded"，
有 "Open all 52 results"。结果表列：KEY、YEAR、CIT/YR（年均引用）、
TITLE、作者/来源、MATCH（匹配度百分比），可按 MATCH 排序；
单篇可 Star、看 PDF、Add to folder、展开看摘要与 "Read full text"。
6. 本次 MATCH 前五：AutoDDG（2025，100%）、DataAtlas（2026，99%）、
TACO（2026，98%）、Pneuma（2025，98%）、一篇数据生成方法综述（2025，98%）；
Polaris（2026）第 9，97%。

## 4. 跟进聊天与技能

- 搜索完成后有 Follow-up Chat；聊天输入框上方有三个"技能"按钮：
Deep search、Write report、Organize papers。
- Organize papers 的官方说明：用文件夹和自定义字段组织论文库，
选择后同样先头脑风暴提问再动手建结构。

## 5. 报告生成

- 搜索页点 Generate Report，会在聊天框预填一句可编辑的指令；
发送后**再来一轮头脑风暴**（本次 2 道：一道问报告定位——方法地图 /
选型指南 / 批判性评估；一道问是否与用户已有的跨表发现工作挂钩）。
- 产物是一个 **Files 里的文件**（本次名 "LLM Dataset Description Methods"），
17:31 答完问题后约 4 分钟生成完毕。
- 结构（本次实测）：标题 → Executive summary → What counts as a dataset
description → Inputs and evidence used → Output types and method
families → How description quality and usefulness are evaluated →
Reliability, review, and operational limits → Practical synthesis →
Bottom line → 文末完整论文表。正文含多张对比表
（方法映射、输入、输出家族、评估方法）。
- 行内引用就是 KEY 简码（如 Zha25），点开即对应论文。
- **报告里没有相关性分数列，也没有覆盖率/完整度百分比**——
只有篇数口径（52 篇、36 篇全文）。见第 10 节与第三方说法的出入。
- 文件页操作：Export file、Request Edit、More actions
（Share / Duplicate / Rename / Move to folder / Download / Delete）。

## 6. 表格抽取

- 论文列表和搜索页**没有独立的"添加列/抽取"按钮**；抽取走聊天：
自然语言指定列名即可。本次让它对 top 论文抽
paper / year / method / profiling-metadata inputs / output type 五列，
约 3 分钟生成 10 行表，并附注只用搜索结果内的论文、不引入外部来源。
- 对比 Elicit 的列式抽取 UI，Undermind 的抽取更"对话驱动"。

## 7. 论文导入（Add papers 菜单）

Upload PDFs、Add via DOI、Import from Zotero、
Import from Semantic Scholar、Import from BibTeX。

## 8. 导出

- 论文：Export as CSV / BibTeX / RIS。
- 报告文件：Markdown、DOCX、PDF、LaTeX、BibTeX、Research notebook
（可导入 Obsidian/Notion 的 Markdown），另有 Copy as Markdown。

## 9. 监控、协作、集成、设置

- **Updates（新论文提醒）默认开启**：每次搜索自动被定期检查，
有新论文出现在 Updates 页，可对单条搜索 Turn off。
- 协作：Invite to workspace；文件可 Share、Request Edit。
- **MCP**：账号页有 "MCP access" 区（本次账号显示已有 1 个 app 接入，
可 Revoke），另有 Manage apps。
- 账号页：改名、改密码、删号、Data export（Download your data）、Billing。
- 定价（账号页实测，年度价）：学术 Pro $16/月、Team $15/人/月；
行业 Pro $30/月、Team $25/人/月。（官网首页年付切换曾显示行业 Pro $20，
口径不一，以账号页为准。）Pro 卖点：无限搜索/Deep Search/论文库/
上传/聊天/文件夹 + 优先速率与搜索质量。
- 免费档官方口径只有一句 "standard rate limits and search quality"，
**未公示每月次数**；本次一次完整搜索 + 报告 + 抽表全程未撞付费墙。

## 10. 与第三方说法的出入（重要）

- **"发现曲线/覆盖率百分比"未证实**：多家评测称它会给出
"已找到约 89.7% 相关文献"这类覆盖度估计；本次报告与结果页
均未出现任何覆盖率指标，只有篇数计数。可能已改版、或仅在
特定视图/套餐出现，复刻时不要当作已确认功能。
- **平均 2.9 分钟是营销口径**：本次实测约 6 分钟（免费档）。
- **免费额度**：评测有"每月 5 次""送 2 次深度搜索"等说法互相矛盾，
官方未公示，以账号页"standard rate limits"为准。
- 数据源 Semantic Scholar 为官方 FAQ 实锤（v0.1 已确认），
与"官方不公开数据库"的评测说法矛盾，以官方为准。

## 11. 检索方法（官方自述，FAQ，v0.1 沿用）

把研究目标扩展成多个检索，逐篇细读评估，再用引用关系扩展，
直到搜索收敛；单次可读数百篇；数据源为 Semantic Scholar
（2 亿+）加 PubMed Central 等开放获取全文源。

## 12. 对复刻的启示（v0.2 更新）

- **产品骨架 = 项目工作区 + 对话**，搜索/报告/组织都是聊天里的"技能"；
所有产物（搜索、报告文件、论文库）沉淀在项目里，可多标签并行。
- **两个头脑风暴关卡**是它体验的灵魂：搜前澄清范围、写报告前澄清定位，
且都先产出"草稿/标准"让用户确认再执行——可控感来自这里。
- **KEY 简码引用**（作者年）比数字编号更适合做行内引用：
人类可读、跨视图稳定，复刻时建议沿用。
- 核心引擎仍是三件事：检索标准生成（把问题改写成多条 criteria）、
逐篇相关性评估产出 MATCH 分、反思-再搜索的自适应循环（阶段标签
里的 Reflecting / Adapting 就是这个循环的产品化呈现）。
- 发现曲线若真实存在，是"敢说找全了"的关键差异化；但未实测到，
复刻时可作为自研课题（用捕获-再捕获估计总量），不列入 MVP。

