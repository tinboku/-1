   138	    <label>按什么问题打分（留空则按种子论文本身）
   139	      <input id="tr-question" type="text" placeholder="可选">
   140	    </label>
   141	    <div class="dlg-actions">
   142	      <span class="flex-spacer"></span>
   143	      <button type="button" class="btn" onclick="this.closest('dialog').close()">取消</button>
   144	      <button type="button" id="tr-launch" class="btn btn-primary">开始扩展</button>
   145	    </div>
   146	  </form>
   147	</dialog>
   148	
   149	<!-- Import DOI dialog -->
   150	<dialog id="dlg-doi">
