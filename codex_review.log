    92	// Run a job: stream progress into the log, return the final event.
    93	async function runJob(jobId, label) {
    94	  switchTab("progress");
    95	  if ($("job-log").querySelector(".muted")) $("job-log").innerHTML = "";
    96	  const render = logJobEvent(label);
    97	  let headEl = null;
    98	  const final = await watchJob(jobId, (ev) => { headEl = render(ev) || headEl; });
    99	  const status = document.createElement("span");
   100	  status.className = final.type === "done" ? "status-done" : "status-error";
   101	  status.textContent = final.type === "done" ? "✓ 完成" : `✗ ${final.error || "失败"}`;
   102	  (headEl || $("job-log")).appendChild(status);
   103	  return final;
   104	}
