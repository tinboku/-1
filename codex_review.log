   169	            source=row["source"] or "import",
   170	        )
   171	        p.key = row["key"]
   172	        p.db_id = int(row["id"])  # type: ignore[attr-defined]
   173	        p.starred = bool(row["starred"])  # type: ignore[attr-defined]
   174	        p.folder = row["folder"]  # type: ignore[attr-defined]
