    45	# ----------------------------------------------------------------------
    46	# Job management
    47	# ----------------------------------------------------------------------
    48	
    49	@dataclass
    50	class Job:
    51	    id: str
    52	    kind: str
    53	    status: str = "queued"  # queued | running | done | error
    54	    created_at: float = field(default_factory=time.time)
    55	    finished_at: float | None = None
    56	    events: list[dict] = field(default_factory=list)
    57	    result: dict | None = None
    58	    error: str | None = None
    59	    _cond: threading.Condition = field(default_factory=threading.Condition, repr=False)
    60	
    61	    def emit(self, stage: str, detail: str) -> None:
    62	        with self._cond:
    63	            self.events.append({"ts": time.time(), "stage": stage, "detail": detail})
    64	            self._cond.notify_all()
    65	
    66	    def finish(self, status: str, result: dict | None = None, error: str | None = None) -> None:
    67	        with self._cond:
    68	            self.status = status
    69	            self.result = result
    70	            self.error = error
    71	            self.finished_at = time.time()
    72	            self._cond.notify_all()
    73	
    74	    def snapshot(self) -> dict:
    75	        return {
    76	            "id": self.id,
    77	            "kind": self.kind,
    78	            "status": self.status,
    79	            "created_at": self.created_at,
    80	            "finished_at": self.finished_at,
    81	            "events": list(self.events),
    82	            "result": self.result,
    83	            "error": self.error,
    84	        }
    85	
    86	
    87	class JobManager:
    88	    def __init__(self, max_workers: int = 2):
    89	        self._pool = ThreadPoolExecutor(max_workers=max_workers, thread_name_prefix="dls-job")
    90	        self._jobs: dict[str, Job] = {}
    91	        self._lock = threading.Lock()
    92	
    93	    def submit(self, kind: str, fn: Callable[[Job], dict]) -> Job:
    94	        job = Job(id=uuid.uuid4().hex[:12], kind=kind)
    95	        with self._lock:
    96	            self._jobs[job.id] = job
    97	
    98	        def _run() -> None:
    99	            job.status = "running"
   100	            try:
   101	                result = fn(job)
   102	                job.finish("done", result=result)
   103	            except Exception as exc:  # surfaced to the client via the job
   104	                job.finish("error", error=f"{type(exc).__name__}: {exc}")
   105	
   106	        self._pool.submit(_run)
   107	        return job
   108	
   109	    def get(self, job_id: str) -> Job | None:
   110	        with self._lock:
   111	            return self._jobs.get(job_id)
   112	
   113	    def list(self) -> list[Job]:
   114	        with self._lock:
   115	            return sorted(self._jobs.values(), key=lambda j: -j.created_at)
