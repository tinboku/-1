    69	    warnings: list[str] = field(default_factory=list)
    70	
    71	    @property
    72	    def found(self) -> int:
    73	        return len(self.included)
     1	"""Chat-driven table extraction: name the columns, get a table."""
     2	
     3	from __future__ import annotations
     4	
     5	from .llm import HeuristicLLM
     6	from .store import Store
     7	
     8	
     9	def extract_table(
    10	    store: Store,
    11	    search_id: int,
    12	    columns: list[str],
    13	    llm: HeuristicLLM,
    14	    top_n: int = 10,
    15	) -> str:
    16	    papers = store.search_papers(search_id, included_only=True)[:top_n]
    17	    if not papers:
    18	        return "(no included papers in this search)"
    19	    lines = ["| " + " | ".join(columns) + " |", "|" + "---|" * len(columns)]
    20	    for p in papers:
    21	        row = llm.extract_row(p, columns)
    22	        cells = [str(row.get(c, "—")).replace("|", "/").replace("\n", " ") for c in columns]
    23	        lines.append("| " + " | ".join(cells) + " |")
    24	    lines.append("")
    25	    lines.append(f"Only papers from search #{search_id} were included; no external sources were added.")
    26	    return "\n".join(lines)

