   102	# ---------------------------------------------------------------------------
   103	# Minimal Markdown -> HTML (enough for our own reports: headings, tables,
   104	# lists, paragraphs, bold, inline code, links)
   105	# ---------------------------------------------------------------------------
   106	
   107	def _inline(text: str) -> str:
   108	    text = html.escape(text)
   109	    text = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", text)
   110	    text = re.sub(r"`([^`]+)`", r"<code>\1</code>", text)
   111	    text = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', text)
   112	    return text
   113	
   114	
   115	def markdown_to_html(md: str, title: str = "Report") -> str:
   116	    lines = md.splitlines()
   117	    body: list[str] = []
   118	    i = 0
   119	    in_list = False
   120	
   121	    def close_list():
   122	        nonlocal in_list
   123	        if in_list:
   124	            body.append("</ul>")
   125	            in_list = False
   126	
   127	    while i < len(lines):
   128	        line = lines[i]
   129	        stripped = line.strip()
   130	        if stripped.startswith("|") and i + 1 < len(lines) and re.match(r"^\|[\s:\-|]+\|$", lines[i + 1].strip()):
   131	            close_list()
   132	            headers = [c.strip() for c in stripped.strip("|").split("|")]
   133	            body.append("<table><thead><tr>" + "".join(f"<th>{_inline(h)}</th>" for h in headers) + "</tr></thead><tbody>")
   134	            i += 2
   135	            while i < len(lines) and lines[i].strip().startswith("|"):
   136	                cells = [c.strip() for c in lines[i].strip().strip("|").split("|")]
   137	                body.append("<tr>" + "".join(f"<td>{_inline(c)}</td>" for c in cells) + "</tr>")
   138	                i += 1
   139	            body.append("</tbody></table>")
   140	            continue
   141	        if stripped.startswith("#"):
   142	            close_list()
   143	            level = len(stripped) - len(stripped.lstrip("#"))
   144	            text = stripped[level:].strip()
   145	            body.append(f"<h{level}>{_inline(text)}</h{level}>")
   146	        elif stripped.startswith("- ") or stripped.startswith("* "):
   147	            if not in_list:
   148	                body.append("<ul>")
   149	                in_list = True
   150	            body.append(f"<li>{_inline(stripped[2:])}</li>")
   151	        elif stripped == "":
   152	            close_list()
   153	        else:
   154	            close_list()
   155	            body.append(f"<p>{_inline(stripped)}</p>")
   156	        i += 1
   157	    close_list()
   158	    return (
   159	        "<!doctype html><html><head><meta charset='utf-8'>"
   160	        f"<title>{html.escape(title)}</title>"
   161	        "<style>body{font-family:system-ui,sans-serif;max-width:860px;margin:2rem auto;padding:0 1rem;line-height:1.55}"
   162	        "table{border-collapse:collapse;width:100%;font-size:.9em}td,th{border:1px solid #ccc;padding:.3rem .5rem;text-align:left}"
   163	        "code{background:#f2f2f2;padding:0 .25rem}</style></head><body>"
   164	        + "\n".join(body)
   165	        + "</body></html>"
   166	    )
