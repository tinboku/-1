    16	  </div>
    17	</header>
    18	
    19	<div class="layout">
    20	  <!-- Left: searches + files -->
    21	  <aside class="sidebar">
    22	    <button id="btn-new-search" class="btn btn-primary btn-block">＋ 新检索</button>
    23	    <button id="btn-new-trace" class="btn btn-block">◎ 从一篇论文扩展</button>
    24	    <h3>检索历史</h3>
    25	    <div id="search-list" class="search-list"></div>
