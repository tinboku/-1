    40	
    41	def papers_to_bibtex(papers: list[Paper]) -> str:
    42	    out = []
    43	    for p in papers:
    44	        authors = " and ".join(p.authors)
    45	        fields = [
    46	            f"  title = {{{p.title}}}",
    47	            f"  author = {{{authors}}}",
    48	        ]
    49	        if p.year:
    50	            fields.append(f"  year = {{{p.year}}}")
    51	        if p.venue:
    52	            fields.append(f"  journal = {{{p.venue}}}")
    53	        if p.doi:
    54	            fields.append(f"  doi = {{{p.doi}}}")
    55	        if p.url:
    56	            fields.append(f"  url = {{{p.url}}}")
    57	        out.append("@article{" + _bibtex_key(p) + ",\n" + ",\n".join(fields) + "\n}")
    58	    return "\n\n".join(out) + "\n"
    59	
    60	
    61	def papers_to_csv(papers: list[Paper]) -> str:
    62	    buf = io.StringIO()
    63	    writer = csv.writer(buf)
    64	    writer.writerow(["key", "year", "cit_per_year", "match", "title", "authors", "venue", "doi", "url"])
    65	    for p in papers:
    66	        writer.writerow([
    67	            p.key or "",
    68	            p.year or "",
    69	            f"{p.citations_per_year():.1f}",
    70	            p.match if p.match is not None else "",
    71	            p.title,
    72	            "; ".join(p.authors),
    73	            p.venue or "",
    74	            p.doi or "",
    75	            p.url or "",
    76	        ])
    77	    return buf.getvalue()
