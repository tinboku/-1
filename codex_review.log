    75	    @staticmethod
    76	    def estimate_coverage(
    77	        s2_relevant: set[str], oa_relevant: set[str], found_relevant: int
    78	    ) -> dict | None:
    79	        """Lincoln–Petersen / Chapman capture–recapture over two channels.
    80	
    81	        Treats Semantic Scholar and OpenAlex as two independent "captures"
    82	        of the same relevant-paper population. Only meaningful when both
    83	        channels returned relevant papers with some overlap.
