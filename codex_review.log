    81	        if fresh:
    82	            new_queries.append(" ".join(fresh[:6]))
    83	        return {"new_queries": new_queries, "stop": round_no >= 2}
    84	
    85	    # -- report ---------------------------------------------------------------
    86	    _FAMILY_KEYWORDS = [
    87	        ("LLM / generative methods", ["llm", "language model", "generative", "gpt", "prompt"]),
    88	        ("Profiling-driven methods", ["profiling", "profile", "statistics", "schema"]),
    89	        ("Retrieval & embedding methods", ["retrieval", "embedding", "semantic search", "indexing"]),
    90	        ("Template / rule-based methods", ["template", "rule", "ontology", "knowledge graph"]),
    91	        ("Evaluation & benchmarking", ["evaluation", "benchmark", "quality", "assessment"]),
    92	    ]
    93	
    94	    def _family(self, paper: Paper) -> str:
    95	        text = (paper.title + " " + (paper.abstract or "")).lower()
    96	        best, best_hits = "Other approaches", 0
    97	        for name, kws in self._FAMILY_KEYWORDS:
    98	            hits = sum(1 for k in kws if k in text)
    99	            if hits > best_hits:
   100	                best, best_hits = name, hits
   101	        return best
   102	
   103	    @staticmethod
   104	    def _first_sentence(text: str | None) -> str:
   105	        if not text:
   106	            return ""
   107	        parts = re.split(r"(?<=[.!?])\s+", text.strip())
   108	        return parts[0] if parts else ""
   109	
   110	    def write_report(self, question: str, criteria: list[str], papers: list[Paper], focus: str | None = None) -> str:
   111	        papers = sorted(papers, key=lambda p: (p.match or 0), reverse=True)
   112	        lines: list[str] = []
   113	        lines.append(f"# Literature search report")
   114	        lines.append("")
   115	        lines.append(f"**Research question.** {question}")
   116	        lines.append("")
   117	        lines.append("**Search criteria.**")
   118	        for c in criteria:
   119	            lines.append(f"- {c}")
   120	        lines.append("")
   121	        lines.append("## Executive summary")
   122	        lines.append("")
   123	        lines.append(
   124	            f"This search retained {len(papers)} papers after relevance scoring and "
   125	            f"citation snowballing. The strongest matches are "
   126	            + ", ".join(f"[{p.key}]" for p in papers[:5])
   127	            + ". The sections below group the retained papers by method family and "
   128	            "summarize what each contributes, using the papers' own abstracts."
   129	        )
   130	        lines.append("")
   131	        families: dict[str, list[Paper]] = {}
   132	        for p in papers:
   133	            families.setdefault(self._family(p), []).append(p)
   134	        lines.append("## Method families")
   135	        for fam, members in sorted(families.items(), key=lambda kv: -len(kv[1])):
   136	            lines.append("")
   137	            lines.append(f"### {fam}")
   138	            lines.append("")
   139	            for p in members[:6]:
   140	                sentence = self._first_sentence(p.abstract) or (p.tldr or "")
   141	                lines.append(f"- [{p.key}] {p.title} ({p.year or 'n.d.'}). {sentence}")
   142	        lines.append("")
   143	        lines.append("## Evaluation and limitations")
   144	        lines.append("")
   145	        lines.append(
   146	            "Scores (MATCH) combine lexical relevance to the criteria with citation "
   147	            "velocity and recency in offline mode; treat the ordering as a screening "
   148	            "aid, not a quality judgement. Papers without abstracts could only be "
   149	            "scored on titles, and citation counts favour older work."
   150	        )
   151	        lines.append("")
   152	        lines.append("## References")
   153	        lines.append("")
   154	        lines.append("| KEY | Year | Cit/yr | Found via | Title |")
   155	        lines.append("|---|---|---|---|---|")
   156	        for p in papers:
   157	            cpy = p.citations_per_year()
   158	            lines.append(f"| {p.key} | {p.year or ''} | {cpy:.1f} | {p.found_via or 'search'} | {p.title} |")
   159	        lines.append("")
   160	        return "\n".join(lines)
   161	
   162	    # -- table extraction ------------------------------------------------------
   163	    def extract_row(self, paper: Paper, columns: list[str]) -> dict[str, str]:
   164	        row: dict[str, str] = {}
   165	        abstract = paper.abstract or ""
   166	        for col in columns:
   167	            c = col.lower()
   168	            if "paper" in c or "title" in c:
   169	                row[col] = f"[{paper.key}] {paper.title}"
   170	            elif "year" in c:
   171	                row[col] = str(paper.year or "")
   172	            elif "author" in c:
   173	                row[col] = ", ".join(paper.authors[:3])
   174	            elif "venue" in c:
   175	                row[col] = paper.venue or ""
   176	            elif "citation" in c:
   177	                row[col] = str(paper.citation_count)
   178	            elif "method" in c or "approach" in c:
   179	                row[col] = self._family(paper)
   180	            else:
   181	                # Find the abstract sentence mentioning the column's key term.
   182	                term = c.split()[0] if c.split() else c
   183	                sentence = next(
   184	                    (s for s in re.split(r"(?<=[.!?])\s+", abstract) if term in s.lower()),
   185	                    "",
   186	                )
   187	                row[col] = sentence[:200] if sentence else "—"
   188	        return row
   189	
   190	    # -- follow-up Q&A -----------------------------------------------------------
   191	    def answer(self, question: str, papers: list[Paper]) -> str:
   192	        ranked = sorted(papers, key=lambda p: (p.match or 0), reverse=True)[:5]
   193	        bits = [f"Based on the {len(papers)} papers in this search, the most relevant sources are:"]
   194	        for p in ranked:
   195	            sentence = self._first_sentence(p.abstract) or (p.tldr or "")
   196	            bits.append(f"- [{p.key}] {p.title}: {sentence}")
   197	        bits.append("(Offline mode: connect an LLM via LLM_API_KEY for a synthesized answer.)")
   198	        return "\n".join(bits)
   199	
   200	
   201	# ---------------------------------------------------------------------------
   202	# OpenAI-compatible backend
   203	# ---------------------------------------------------------------------------
   204	
   205	class OpenAIChatLLM(HeuristicLLM):
   206	    name = "openai-compatible"
   207	
   208	    def __init__(self, config: Config):
   209	        self.config = config
   210	        self.session = requests.Session()
   211	        self.session.headers.update(
   212	            {
   213	                "Authorization": f"Bearer {config.llm_api_key}",
   214	                "Content-Type": "application/json",
   215	            }
   216	        )
   217	
   218	    def _chat(self, system: str, user: str, json_mode: bool = False) -> str:
   219	        body: dict = {
   220	            "model": self.config.llm_model,
   221	            "messages": [
   222	                {"role": "system", "content": system},
   223	                {"role": "user", "content": user},
   224	            ],
   225	            "temperature": 0.2,
   226	        }
   227	        if json_mode:
   228	            body["response_format"] = {"type": "json_object"}
   229	        resp = self.session.post(
   230	            f"{self.config.llm_base_url.rstrip('/')}/chat/completions",
   231	            json=body,
   232	            timeout=120,
   233	        )
   234	        resp.raise_for_status()
   235	        return resp.json()["choices"][0]["message"]["content"]
   236	
   237	    @staticmethod
   238	    def _parse_json(text: str) -> dict | list | None:
   239	        text = text.strip()
   240	        if text.startswith("```"):
   241	            text = re.sub(r"^```[a-z]*\n?|```$", "", text, flags=re.M).strip()
   242	        try:
   243	            return json.loads(text)
   244	        except Exception:
   245	            m = re.search(r"(\{.*\}|\[.*\])", text, flags=re.S)
   246	            if m:
   247	                try:
   248	                    return json.loads(m.group(1))
   249	                except Exception:
   250	                    return None
   251	            return None
   252	
   253	    def brainstorm(self, question: str) -> list[str]:
   254	        try:
   255	            out = self._chat(
   256	                "You are a research librarian. Before searching, ask exactly two short "
   257	                "clarifying questions that pin down scope and purpose. Return JSON: "
   258	                '{"questions": ["...", "..."]}',
   259	                f"Research question: {question}",
   260	                json_mode=True,
   261	            )
   262	            data = self._parse_json(out)
   263	            if isinstance(data, dict) and data.get("questions"):
   264	                return [str(q) for q in data["questions"]][:3]
   265	        except Exception:
   266	            pass
   267	        return super().brainstorm(question)
   268	
   269	    def make_criteria(self, question: str, answers: dict[str, str] | None = None) -> list[str]:
   270	        try:
   271	            answers_txt = "\n".join(f"- {k}: {v}" for k, v in (answers or {}).items()) or "(no answers)"
   272	            out = self._chat(
   273	                "You convert a research question into 2-4 natural-language search "
   274	                "criteria statements that a literature search engine will execute. "
   275	                'Return JSON: {"criteria": ["...", "..."]}',
   276	                f"Question: {question}\nClarifying answers:\n{answers_txt}",
   277	                json_mode=True,
   278	            )
   279	            data = self._parse_json(out)
   280	            if isinstance(data, dict) and data.get("criteria"):
   281	                return [str(c) for c in data["criteria"]][:4]
   282	        except Exception:
   283	            pass
   284	        return super().make_criteria(question, answers)
   285	
   286	    def score_matches(self, criteria: list[str], papers: list[Paper]) -> list[tuple[float, str]]:
   287	        results: list[tuple[float, str]] = []
   288	        batch_size = 10
   289	        for i in range(0, len(papers), batch_size):
   290	            batch = papers[i : i + batch_size]
   291	            try:
   292	                listing = "\n".join(
   293	                    f"{j}. TITLE: {p.title}\n   ABSTRACT: {(p.abstract or '')[:600]}"
   294	                    for j, p in enumerate(batch)
   295	                )
   296	                out = self._chat(
   297	                    "You judge how well each paper matches the search criteria. "
   298	                    "Score 0-100 (100 = directly on-topic). Return JSON: "
   299	                    '{"scores": [{"index": 0, "score": 87, "reason": "short reason"}]}',
   300	                    f"Criteria:\n- " + "\n- ".join(criteria) + f"\n\nPapers:\n{listing}",
   301	                    json_mode=True,
   302	                )
   303	                data = self._parse_json(out)
   304	                by_index: dict[int, tuple[float, str]] = {}
   305	                if isinstance(data, dict):
   306	                    for s in data.get("scores") or []:
   307	                        by_index[int(s["index"])] = (float(s["score"]), str(s.get("reason", "")))
   308	                for j, p in enumerate(batch):
   309	                    results.append(by_index.get(j) or heuristic_match(criteria, p))
   310	            except Exception:
   311	                results.extend(heuristic_match(criteria, p) for p in batch)
   312	        return results
   313	
   314	    def reflect(self, criteria: list[str], top_papers: list[Paper], round_no: int) -> dict:
   315	        try:
   316	            titles = "\n".join(f"- {p.title}" for p in top_papers[:10])
   317	            out = self._chat(
   318	                    "You are reflecting on a literature search in progress. Given the "
   319	                    "criteria and the best papers so far, propose up to 2 new search "
   320	                    "queries that would find relevant papers the criteria miss, and say "
   321	                    "whether the search looks saturated. Return JSON: "
   322	                    '{"new_queries": ["..."], "stop": false}',
   323	                "Criteria:\n- " + "\n- ".join(criteria) + f"\n\nBest papers so far:\n{titles}",
   324	                json_mode=True,
   325	            )
   326	            data = self._parse_json(out)
   327	            if isinstance(data, dict):
   328	                return {
   329	                    "new_queries": [str(q) for q in data.get("new_queries") or []][:2],
   330	                    "stop": bool(data.get("stop")),
   331	                }
   332	        except Exception:
   333	            pass
   334	        return super().reflect(criteria, top_papers, round_no)
   335	
   336	    def write_report(self, question: str, criteria: list[str], papers: list[Paper], focus: str | None = None) -> str:
   337	        try:
   338	            listing = "\n".join(
   339	                f"[{p.key}] {p.title} ({p.year or 'n.d.'}) — {(p.abstract or '')[:800]}"
   340	                for p in papers
   341	            )
   342	            focus_txt = f"\nReport focus requested by the user: {focus}" if focus else ""
   343	            return self._chat(
   344	                "You write structured literature-search reports in Markdown. Use ONLY "
   345	                "the papers provided, cite them inline with their [KEY] tokens, group "
   346	                "methods into families, include sections: Executive summary; What "
   347	                "counts as in-scope; Inputs and evidence used; Output types and method "
   348	                "families; How quality is evaluated; Reliability and limits; Practical "
   349	                "synthesis; Bottom line. End with a references table (KEY | Year | "
   350	                "Cit/yr | Title).",
   351	                f"Research question: {question}{focus_txt}\n\nPapers:\n{listing}",
   352	            )
   353	        except Exception:
   354	            return super().write_report(question, criteria, papers, focus)
   355	
   356	    def extract_row(self, paper: Paper, columns: list[str]) -> dict[str, str]:
   357	        try:
   358	            out = self._chat(
   359	                "Extract values for the requested columns from the paper's title and "
   360	                "abstract. If a value is not stated, use '—'. Return JSON with exactly "
   361	                "the requested column names as keys.",
   362	                f"Columns: {columns}\nTitle: {paper.title}\nAbstract: {(paper.abstract or '')[:2000]}",
   363	                json_mode=True,
   364	            )
   365	            data = self._parse_json(out)
   366	            if isinstance(data, dict):
   367	                return {c: str(data.get(c, "—")) for c in columns}
   368	        except Exception:
   369	            pass
   370	        return super().extract_row(paper, columns)
   371	
   372	    def answer(self, question: str, papers: list[Paper]) -> str:
   373	        try:
   374	            listing = "\n".join(
   375	                f"[{p.key}] {p.title} ({p.year or 'n.d.'}) — {(p.abstract or '')[:700]}"
   376	                for p in sorted(papers, key=lambda x: (x.match or 0), reverse=True)[:15]
   377	            )
   378	            return self._chat(
   379	                "Answer the user's follow-up question using ONLY the papers provided. "
   380	                "Cite papers inline with their [KEY] tokens. If the papers do not "
   381	                "cover the question, say so.",
   382	                f"Question: {question}\n\nPapers:\n{listing}",
   383	            )
   384	        except Exception:
   385	            return super().answer(question, papers)
