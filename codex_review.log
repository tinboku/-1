   157	    : esc(p.title);
   158	  const authors = (p.authors || []).slice(0, 4).join(", ") + ((p.authors || []).length > 4 ? " et al." : "");
   159	  const via = p.found_via && p.found_via !== "search" ? `<span class="via">← ${esc(p.found_via)}</span>` : "";
   160	  const pdf = p.open_access_pdf ? ` · <a href="${esc(p.open_access_pdf)}" target="_blank" rel="noopener">PDF</a>` : "";
   161	  tr.innerHTML = `
   162	    <td>${first}</td>
   163	    <td>
   164	      <div class="paper-title">${titleLink}${via}</div>
   165	      <div class="paper-sub">${esc(authors)} · ${p.year ?? "n.d."} · ${esc(p.venue || "")}${pdf}</div>
   166	      ${p.match_reason ? `<div class="paper-reason">${esc(p.match_reason)}</div>` : ""}
   167	    </td>
   168	    <td>${p.citations_per_year ?? ""}</td>
   169	    <td><button class="star-btn ${p.starred ? "on" : ""}" title="收藏">★</button></td>`;
   170	  tr.querySelector(".star-btn").addEventListener("click", async (e) => {
