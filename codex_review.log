     1	"""Importers: DOI, BibTeX files, and PDF files into the library."""
     2	
     3	from __future__ import annotations
     4	
     5	import re
     6	import shutil
     7	from pathlib import Path
     8	
     9	from .clients.crossref import CrossrefClient
    10	from .clients.semantic_scholar import SemanticScholarClient
    11	from .models import Paper
    12	from .store import Store
    13	
    14	
    15	def import_doi(store: Store, doi: str, crossref: CrossrefClient, s2: SemanticScholarClient | None = None) -> Paper:
    16	    paper = None
    17	    if s2 is not None:
    18	        try:
    19	            paper = s2.paper(f"DOI:{doi}")
    20	        except Exception:
    21	            paper = None
    22	    if paper is None:
    23	        paper = crossref.by_doi(doi)
    24	    if paper is None:
    25	        raise ValueError(f"DOI not found: {doi}")
    26	    store.upsert_paper(paper)
    27	    stored = store.find_paper(doi)
    28	    return stored or paper
    29	
    30	
    31	# -- BibTeX -------------------------------------------------------------------
    32	
    33	_ENTRY_RE = re.compile(r"@\w+\s*\{\s*([^,]+),(.*?)\n\}", re.S)
    34	_FIELD_RE = re.compile(r"(\w+)\s*=\s*\{((?:[^{}]|\{[^{}]*\})*)\}|(\w+)\s*=\s*\"([^\"]*)\"|(\w+)\s*=\s*(\d+)")
    35	
    36	
    37	def parse_bibtex(text: str) -> list[Paper]:
    38	    papers: list[Paper] = []
    39	    for _key, body in _ENTRY_RE.findall(text):
    40	        fields: dict[str, str] = {}
    41	        for m in _FIELD_RE.finditer(body):
    42	            if m.group(1):
    43	                fields[m.group(1).lower()] = m.group(2)
    44	            elif m.group(3):
    45	                fields[m.group(3).lower()] = m.group(4)
    46	            elif m.group(5):
    47	                fields[m.group(5).lower()] = m.group(6)
    48	        title = re.sub(r"[{}]", "", fields.get("title", "")).strip()
    49	        if not title:
    50	            continue
    51	        authors = []
    52	        if fields.get("author"):
    53	            authors = [a.strip() for a in re.split(r"\s+and\s+", fields["author"]) if a.strip()]
    54	        year = None
    55	        if fields.get("year", "").isdigit():
    56	            year = int(fields["year"])
    57	        doi = fields.get("doi")
    58	        papers.append(
    59	            Paper(
    60	                paper_id=f"doi:{doi}" if doi else f"bibtex:{title[:40]}",
    61	                title=title,
    62	                abstract=fields.get("abstract"),
    63	                year=year,
    64	                authors=authors,
    65	                venue=fields.get("journal") or fields.get("booktitle"),
    66	                doi=doi,
    67	                url=fields.get("url"),
    68	                source="bibtex",
    69	            )
    70	        )
    71	    return papers
    72	
    73	
    74	def import_bibtex(store: Store, path: Path) -> int:
    75	    papers = parse_bibtex(path.read_text(encoding="utf-8", errors="replace"))
    76	    for p in papers:
    77	        store.upsert_paper(p)
    78	    return len(papers)
    79	
    80	
    81	# -- PDF ------------------------------------------------------------------------
    82	
    83	def import_pdf(store: Store, path: Path, files_dir: Path) -> Paper:
    84	    """Register a PDF in the library. Extracts first-page text when a PDF
    85	    library (pypdf/PyPDF2) happens to be installed; otherwise stores the
    86	    file with filename-based metadata for later enrichment."""
    87	    files_dir.mkdir(parents=True, exist_ok=True)
    88	    dest = files_dir / path.name
    89	    if path.resolve() != dest.resolve():
    90	        shutil.copyfile(path, dest)
    91	    title = path.stem.replace("_", " ").replace("-", " ").strip() or path.name
    92	    abstract = None
    93	    try:
    94	        reader = None
    95	        try:
    96	            from pypdf import PdfReader  # type: ignore
    97	        except Exception:
    98	            from PyPDF2 import PdfReader  # type: ignore
    99	        reader = PdfReader(str(dest))
   100	        if reader.pages:
   101	            text = reader.pages[0].extract_text() or ""
   102	            lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
   103	            if lines:
   104	                title = lines[0][:200]
   105	            abstract = " ".join(lines)[:1500] or None
   106	    except Exception:
   107	        pass
   108	    paper = Paper(
   109	        paper_id=f"file:{dest.name}",
   110	        title=title,
   111	        abstract=abstract,
   112	        url=str(dest),
   113	        source="upload",
   114	    )
   115	    store.upsert_paper(paper)
   116	    return store.find_paper(paper.paper_id) or paper
