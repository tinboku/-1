     1	"""HTTP API + job runner for the deep-literature-search engine.
     2	
     3	This is the backend layer that turns the CLI/library into a service:
     4	
     5	- **Jobs**: searches, traces, reports, extractions and update checks run
     6	  in a background thread pool (they take minutes), each with a live
     7	  progress event stream — the engine already reports
     8	  (stage, detail) pairs through its `progress` callback.
     9	- **Progress streaming**: `GET /api/jobs/{id}/events` is a
    10	  Server-Sent-Events stream; `GET /api/jobs/{id}` returns a snapshot.
    11	- **Data endpoints**: searches, papers, files (reports/tables), library
    12	  import/export — thin wrappers over `Store` and the existing helpers
    13	  in `report.py` / `extract.py` / `importers.py` / `updates.py`.
    14	
    15	The store uses a single SQLite connection shared across threads, so all
    16	store access is serialized through one re-entrant lock. That is fine for
    17	a local, single-user service and keeps the core package untouched.
    18	
    19	Run it with:  dls api --port 8000      (requires the `api` extra:
    20	                                        pip install fastapi uvicorn)
    21	"""
    22	
    23	from __future__ import annotations
    24	
    25	import json
    26	import threading
    27	import time
    28	import uuid
    29	from concurrent.futures import ThreadPoolExecutor
    30	from contextlib import contextmanager
    31	from dataclasses import dataclass, field
    32	from pathlib import Path
