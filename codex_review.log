     1	:root {
     2	  --accent: #4f46e5;
     3	  --accent-soft: #eef2ff;
     4	  --ink: #1f2430;
     5	  --muted: #6b7280;
     6	  --line: #e5e7eb;
     7	  --bg: #f7f8fa;
     8	  --panel: #ffffff;
     9	  --green: #15803d;
    10	  --green-bg: #dcfce7;
    11	  --amber: #b45309;
    12	  --amber-bg: #fef3c7;
    13	  --grey-bg: #f3f4f6;
    14	}
    15	
    16	* { box-sizing: border-box; }
    17	html, body { height: 100%; }
    18	body {
    19	  margin: 0;
    20	  font: 14px/1.55 -apple-system, "Segoe UI", "Hiragino Sans", "Noto Sans CJK SC", sans-serif;
    21	  color: var(--ink);
    22	  background: var(--bg);
    23	  display: flex;
    24	  flex-direction: column;
    25	}
    26	.hidden { display: none !important; }
    27	.muted { color: var(--muted); }
    28	.flex-spacer { flex: 1; }
    29	
    30	/* ---------- top bar ---------- */
    31	.topbar {
    32	  display: flex; align-items: center; justify-content: space-between;
    33	  padding: 10px 16px; background: var(--panel); border-bottom: 1px solid var(--line);
    34	}
    35	.brand { font-weight: 700; font-size: 15px; }
    36	.backend-status { color: var(--muted); font-size: 12px; margin-right: 10px; }
    37	.backend-status.ok { color: var(--green); }
    38	
    39	/* ---------- layout ---------- */
    40	.layout {
    41	  flex: 1; display: grid; grid-template-columns: 280px 1fr 380px;
    42	  min-height: 0;
    43	}
    44	.sidebar, .inspector { background: var(--panel); overflow-y: auto; padding: 14px; }
    45	.sidebar { border-right: 1px solid var(--line); }
    46	.inspector { border-left: 1px solid var(--line); display: flex; flex-direction: column; }
    47	.main { overflow-y: auto; padding: 18px 22px; }
    48	.sidebar h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 18px 0 8px; }
    49	
    50	/* ---------- buttons ---------- */
    51	.btn {
    52	  border: 1px solid var(--line); background: var(--panel); color: var(--ink);
    53	  border-radius: 8px; padding: 6px 12px; cursor: pointer; font-size: 13px;
    54	}
    55	.btn:hover { border-color: var(--accent); color: var(--accent); }
    56	.btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    57	.btn-primary:hover { color: #fff; opacity: .92; }
    58	.btn-ghost { border-color: transparent; }
    59	.btn-block { display: block; width: 100%; margin-bottom: 8px; text-align: center; }
    60	button:disabled { opacity: .5; cursor: wait; }
    61	
    62	/* ---------- search list ---------- */
    63	.search-item {
    64	  padding: 9px 10px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;
    65	  border: 1px solid transparent;
    66	}
    67	.search-item:hover { background: var(--bg); }
    68	.search-item.active { background: var(--accent-soft); border-color: #c7d2fe; }
    69	.search-item .q { font-weight: 600; font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    70	.search-item .m { color: var(--muted); font-size: 12px; margin-top: 2px; }
    71	.file-item { padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 13px; color: var(--ink); }
    72	.file-item:hover { background: var(--bg); }
    73	.file-item .kind { color: var(--muted); font-size: 11px; text-transform: uppercase; margin-right: 6px; }
    74	
    75	/* ---------- detail ---------- */
    76	.welcome { max-width: 560px; margin: 60px auto; text-align: center; }
    77	.welcome h2 { font-size: 22px; }
    78	.welcome p { color: var(--muted); }
    79	.detail-head h2 { margin: 0 0 6px; font-size: 19px; }
    80	.detail-meta { color: var(--muted); font-size: 13px; display: flex; gap: 14px; flex-wrap: wrap; }
    81	.criteria-chips { margin: 10px 0; display: flex; flex-wrap: wrap; gap: 6px; }
    82	.chip { background: var(--grey-bg); border-radius: 999px; padding: 2px 10px; font-size: 12px; }
    83	.detail-actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 16px; }
    84	.export-group { display: inline-flex; gap: 6px; margin-left: auto; }
    85	
    86	/* ---------- papers table ---------- */
    87	.papers-table { width: 100%; border-collapse: collapse; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    88	.papers-table th { text-align: left; font-size: 12px; color: var(--muted); padding: 9px 12px; border-bottom: 1px solid var(--line); background: #fbfbfc; }
    89	.papers-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
    90	.papers-table tr.paper-row { cursor: pointer; }
    91	.papers-table tr.paper-row:hover td { background: #fafaff; }
    92	.col-match { width: 76px; } .col-cit { width: 76px; } .col-star { width: 40px; }
    93	.score {
    94	  display: inline-block; min-width: 46px; text-align: center; font-weight: 700;
    95	  border-radius: 6px; padding: 2px 6px; font-size: 13px;
    96	}
    97	.score.high { background: var(--green-bg); color: var(--green); }
    98	.score.mid { background: var(--amber-bg); color: var(--amber); }
    99	.score.low { background: var(--grey-bg); color: var(--muted); }
   100	.paper-title { font-weight: 600; }
   101	.paper-title a { color: inherit; text-decoration: none; }
   102	.paper-title a:hover { color: var(--accent); text-decoration: underline; }
   103	.paper-sub { color: var(--muted); font-size: 12px; margin-top: 1px; }
   104	.paper-reason { font-size: 12.5px; margin-top: 4px; }
   105	.via { display: inline-block; font-size: 11px; color: var(--accent); background: var(--accent-soft); border-radius: 4px; padding: 0 5px; margin-left: 6px; }
   106	.key { font-family: ui-monospace, monospace; font-size: 12px; color: var(--muted); }
   107	.star-btn { background: none; border: none; font-size: 16px; cursor: pointer; color: #d1d5db; padding: 0; }
   108	.star-btn.on { color: #f59e0b; }
   109	.abstract-row td { background: #fcfcfe; color: #374151; font-size: 13px; white-space: pre-wrap; }
   110	.empty { padding: 28px; text-align: center; color: var(--muted); }
   111	.star-filter { margin-left: auto; }
   112	
   113	/* ---------- inspector ---------- */
   114	.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin: -14px -14px 12px; padding: 10px 14px 0; }
   115	.tab { background: none; border: none; border-bottom: 2px solid transparent; padding: 6px 10px; cursor: pointer; font-size: 13px; color: var(--muted); }
   116	.tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
   117	.tab-page { flex: 1; overflow-y: auto; min-height: 0; }
   118	.job-log .ev { display: flex; gap: 8px; padding: 6px 0; border-bottom: 1px dashed var(--line); font-size: 13px; }
   119	.job-log .ev .stage { font-weight: 600; white-space: nowrap; }
   120	.job-log .ev .detail { color: var(--muted); }
   121	.job-log .job-head { font-weight: 700; margin: 10px 0 4px; }
   122	.job-log .job-head .status-done { color: var(--green); }
   123	.job-log .job-head .status-error { color: #b91c1c; }
   124	.ask-log { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
   125	.ask-msg { border-radius: 10px; padding: 8px 12px; font-size: 13.5px; white-space: pre-wrap; }
   126	.ask-msg.user { background: var(--accent-soft); align-self: flex-end; max-width: 90%; }
   127	.ask-msg.bot { background: var(--grey-bg); align-self: flex-start; max-width: 95%; }
   128	.ask-bar, .extract-bar { display: flex; gap: 8px; }
   129	.ask-bar input, .extract-bar input, dialog input[type="text"], dialog textarea {
   130	  flex: 1; border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; font: inherit; font-size: 13px;
   131	}
   132	.extract-bar { margin-bottom: 12px; }
   133	
   134	/* ---------- markdown ---------- */
   135	.markdown { font-size: 13.5px; }
   136	.markdown h1 { font-size: 18px; } .markdown h2 { font-size: 16px; } .markdown h3 { font-size: 14.5px; }
   137	.markdown table { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 12.5px; }
   138	.markdown th, .markdown td { border: 1px solid var(--line); padding: 5px 8px; text-align: left; vertical-align: top; }
