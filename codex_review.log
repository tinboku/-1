     3	async function req(method, path, body) {
     4	  const res = await fetch(path, {
     5	    method,
     6	    headers: body ? { "Content-Type": "application/json" } : undefined,
     7	    body: body ? JSON.stringify(body) : undefined,
     8	  });
     9	  if (!res.ok) {
    10	    let detail = res.statusText;
    11	    try { detail = (await res.json()).detail || detail; } catch { /* keep status text */ }
    12	    throw new Error(`${res.status}: ${detail}`);
    13	  }
    14	  return res.status === 204 ? null : res.json();
    15	}
