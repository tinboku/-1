    79	
    80	def papers_to_ris(papers: list[Paper]) -> str:
    81	    out = []
    82	    for p in papers:
    83	        lines = ["TY  - JOUR"]
    84	        lines.append(f"TI  - {p.title}")
    85	        for a in p.authors:
    86	            lines.append(f"AU  - {a}")
    87	        if p.year:
    88	            lines.append(f"Y1  - {p.year}")
    89	        if p.venue:
    90	            lines.append(f"JO  - {p.venue}")
    91	        if p.doi:
    92	            lines.append(f"DO  - {p.doi}")
    93	        if p.url:
    94	            lines.append(f"UR  - {p.url}")
    95	        if p.abstract:
    96	            lines.append(f"AB  - {p.abstract[:500]}")
    97	        lines.append("ER  - ")
    98	        out.append("\n".join(lines))
    99	    return "\n\n".join(out) + "\n"
