     7	
     8	@dataclass
     9	class Paper:
    10	    paper_id: str  # canonical id: S2 id, "W..." OpenAlex id, or "doi:..."
    11	    title: str
    12	    abstract: str | None = None
    13	    year: int | None = None
    14	    authors: list[str] = field(default_factory=list)
    15	    venue: str | None = None
    16	    citation_count: int = 0
    17	    reference_count: int = 0
    18	    doi: str | None = None
    19	    arxiv_id: str | None = None
    20	    open_access_pdf: str | None = None
    21	    url: str | None = None
    22	    tldr: str | None = None
    23	    source: str = "semantic_scholar"
    24	    sources: list[str] = field(default_factory=list)  # every channel that found it
    25	
    26	    # Filled in by scoring / storage layers
    27	    key: str | None = None        # citation key, e.g. "Zha25"
    28	    match: float | None = None    # 0..100 relevance to a search's criteria
    29	    match_reason: str | None = None
    30	    found_via: str | None = None  # provenance: "search", "citations of [Key]", ...
    31	
    32	    def __post_init__(self) -> None:
    33	        if self.source and self.source not in self.sources:
    34	            self.sources.append(self.source)
    35	
    36	    @property
    37	    def has_full_text(self) -> bool:
    38	        return bool(self.open_access_pdf)
    39	
    40	    def citations_per_year(self, current_year: int = 2026) -> float:
    41	        if not self.year:
    42	            return float(self.citation_count)
    43	        age = max(1, current_year - self.year + 1)
    44	        return self.citation_count / age
    45	
    46	    def first_author_surname(self) -> str:
    47	        if not self.authors:
    48	            return "Anon"
    49	        name = self.authors[0].strip()
    50	        if not name:
    51	            return "Anon"
    52	        # "First Last" -> "Last"; keep only letters for a compact key.
    53	        last = name.split()[-1]
    54	        cleaned = "".join(ch for ch in last if ch.isalpha())
    55	        return cleaned or "Anon"
    56	
