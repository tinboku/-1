     7	/* ------------------------------------------------------------------ */
     8	/* tiny markdown renderer (escape first, then a safe subset)           */
     9	/* ------------------------------------------------------------------ */
    10	function esc(s) {
    11	  return String(s ?? "").replace(/[&<>"']/g, (c) => ({
    12	    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    13	  }[c]));
    14	}
    15	
    16	function inline(s) {
    17	  return esc(s)
    18	    .replace(/`([^`]+)`/g, "<code>$1</code>")
    19	    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    20	    .replace(/(?<![*\w])\*([^*\n]+)\*/g, "<em>$1</em>")
    21	    .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
    22	    .replace(/\[([A-Z][A-Za-zÀ-ÿ'-]*\d{2}[a-z]?)\]/g, '<span class="cite">[$1]</span>');
    23	}
    24	
    25	export function renderMarkdown(md) {
    26	  const lines = String(md ?? "").split("\n");
    27	  const out = [];
    28	  let i = 0;
    29	  let listOpen = false;
    30	  const closeList = () => { if (listOpen) { out.push("</ul>"); listOpen = false; } };
    31	  while (i < lines.length) {
    32	    const line = lines[i];
    33	    // table block
    34	    if (/^\s*\|.*\|\s*$/.test(line) && i + 1 < lines.length && /^\s*\|[\s:|-]+\|\s*$/.test(lines[i + 1])) {
    35	      closeList();
    36	      const cells = (l) => l.trim().replace(/^\||\|$/g, "").split("|").map((c) => c.trim());
    37	      const head = cells(line);
    38	      i += 2;
    39	      const rows = [];
    40	      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) { rows.push(cells(lines[i])); i++; }
    41	      out.push("<table><thead><tr>" + head.map((h) => `<th>${inline(h)}</th>`).join("") + "</tr></thead><tbody>");
    42	      for (const r of rows) out.push("<tr>" + r.map((c) => `<td>${inline(c)}</td>`).join("") + "</tr>");
    43	      out.push("</tbody></table>");
    44	      continue;
    45	    }
    46	    const h = line.match(/^(#{1,4})\s+(.*)$/);
    47	    if (h) { closeList(); out.push(`<h${h[1].length}>${inline(h[2])}</h${h[1].length}>`); i++; continue; }
    48	    const li = line.match(/^\s*[-*]\s+(.*)$/);
    49	    if (li) { if (!listOpen) { out.push("<ul>"); listOpen = true; } out.push(`<li>${inline(li[1])}</li>`); i++; continue; }
    50	    closeList();
    51	    if (line.trim() === "") { i++; continue; }
    52	    if (/^\s*(-{3,}|_{3,})\s*$/.test(line)) { out.push("<hr>"); i++; continue; }
    53	    out.push(`<p>${inline(line)}</p>`);
    54	    i++;
    55	  }
    56	  closeList();
    57	  return out.join("\n");
    58	}
