     1	"""Minimal MCP server (stdio, JSON-RPC) exposing literature tools.
     2	
     3	Implements just enough of the Model Context Protocol for clients to
     4	initialize, list tools, and call them:
     5	
     6	- deep_search: run the full iterative search and return a summary
     7	- search_papers: one-shot Semantic Scholar search
     8	- get_paper: fetch one paper by S2 id / DOI / arXiv id
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import json
    14	import sys
    15	
    16	PROTOCOL_VERSION = "2024-11-05"
    17	
    18	TOOLS = [
    19	    {
    20	        "name": "deep_search",
    21	        "description": "Run an Undermind-style deep literature search: multi-query retrieval, per-paper match scoring, and citation snowballing until convergence. Returns the top papers with match scores and citation keys.",
    22	        "inputSchema": {
    23	            "type": "object",
    24	            "properties": {
    25	                "question": {"type": "string"},
    26	                "max_rounds": {"type": "integer", "default": 2},
    27	            },
    28	            "required": ["question"],
    29	        },
    30	    },
    31	    {
    32	        "name": "search_papers",
    33	        "description": "One-shot Semantic Scholar paper search.",
    34	        "inputSchema": {
    35	            "type": "object",
    36	            "properties": {
    37	                "query": {"type": "string"},
    38	                "limit": {"type": "integer", "default": 10},
    39	            },
    40	            "required": ["query"],
    41	        },
    42	    },
    43	    {
    44	        "name": "get_paper",
    45	        "description": "Fetch one paper by Semantic Scholar id, DOI (DOI:...) or arXiv id (ARXIV:...).",
    46	        "inputSchema": {
    47	            "type": "object",
    48	            "properties": {"paper_id": {"type": "string"}},
    49	            "required": ["paper_id"],
    50	        },
    51	    },
    52	]
    53	
    54	
    55	def _paper_json(p) -> dict:
    56	    return {
    57	        "key": p.key,
    58	        "title": p.title,
    59	        "year": p.year,
    60	        "authors": p.authors,
    61	        "venue": p.venue,
    62	        "citations": p.citation_count,
    63	        "match": p.match,
    64	        "doi": p.doi,
    65	        "url": p.url,
    66	        "abstract": (p.abstract or "")[:500],
    67	    }
    68	
    69	
    70	def _call_tool(ctx, name: str, arguments: dict) -> str:
    71	    if name == "search_papers":
    72	        papers = ctx.s2.search(arguments["query"], limit=int(arguments.get("limit", 10)))
    73	        for p in papers:
    74	            ctx.store.upsert_paper(p)
    75	        return json.dumps([_paper_json(p) for p in papers], ensure_ascii=False)
    76	    if name == "get_paper":
    77	        paper = ctx.s2.paper(arguments["paper_id"])
    78	        if paper is None:
    79	            return json.dumps({"error": "not found"})
    80	        ctx.store.upsert_paper(paper)
    81	        return json.dumps(_paper_json(paper), ensure_ascii=False)
    82	    if name == "deep_search":
    83	        question = arguments["question"]
    84	        criteria = ctx.engine.build_criteria(question, {})
    85	        outcome = ctx.engine.run(
    86	            question, criteria, max_rounds=int(arguments.get("max_rounds", 2)), per_query=30
    87	        )
    88	        return json.dumps(
    89	            {
    90	                "search_id": outcome.search_id,
    91	                "found": outcome.found,
    92	                "with_full_text": outcome.with_full_text,
    93	                "excluded": outcome.excluded_count,
    94	                "coverage": outcome.coverage,
    95	                "papers": [_paper_json(p) for p in outcome.included[:25]],
    96	            },
    97	            ensure_ascii=False,
    98	        )
    99	    raise ValueError(f"unknown tool: {name}")
   100	
   101	
   102	def run_stdio(ctx) -> None:
   103	    out = sys.stdout
   104	
   105	    def send(obj: dict) -> None:
   106	        out.write(json.dumps(obj) + "\n")
   107	        out.flush()
   108	
   109	    for line in sys.stdin:
   110	        line = line.strip()
   111	        if not line:
   112	            continue
   113	        try:
   114	            msg = json.loads(line)
   115	        except Exception:
   116	            continue
   117	        method = msg.get("method")
   118	        msg_id = msg.get("id")
   119	        if method == "initialize":
   120	            send(
   121	                {
   122	                    "jsonrpc": "2.0",
   123	                    "id": msg_id,
   124	                    "result": {
   125	                        "protocolVersion": PROTOCOL_VERSION,
   126	                        "capabilities": {"tools": {}},
   127	                        "serverInfo": {"name": "deep-literature-search", "version": "0.1.0"},
   128	                    },
   129	                }
   130	            )
   131	        elif method == "tools/list":
   132	            send({"jsonrpc": "2.0", "id": msg_id, "result": {"tools": TOOLS}})
   133	        elif method == "tools/call":
   134	            params = msg.get("params") or {}
   135	            try:
   136	                text = _call_tool(ctx, params.get("name", ""), params.get("arguments") or {})
   137	                send(
   138	                    {
   139	                        "jsonrpc": "2.0",
   140	                        "id": msg_id,
   141	                        "result": {"content": [{"type": "text", "text": text}]},
   142	                    }
   143	                )
   144	            except Exception as exc:
   145	                send(
   146	                    {
   147	                        "jsonrpc": "2.0",
   148	                        "id": msg_id,
   149	                        "result": {
   150	                            "content": [{"type": "text", "text": f"error: {exc}"}],
   151	                            "isError": True,
   152	                        },
   153	                    }
   154	                )
   155	        elif method == "ping":
   156	            send({"jsonrpc": "2.0", "id": msg_id, "result": {}})
   157	        elif msg_id is not None:
   158	            send(
   159	                {
   160	                    "jsonrpc": "2.0",
   161	                    "id": msg_id,
   162	                    "error": {"code": -32601, "message": f"method not found: {method}"},
   163	                }
   164	            )
"""deep-literature-search: an Undermind-style deep literature search agent."""

__version__ = "0.1.0"
"""Data-source clients: Semantic Scholar, OpenAlex, Crossref."""
