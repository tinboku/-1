   497	    @app.get("/api/jobs/{job_id}/events")
   498	    def job_events(job_id: str, request: Request) -> StreamingResponse:
   499	        job = jobs.get(job_id)
   500	        if job is None:
   501	            raise HTTPException(404, "job not found")
   502	
   503	        def stream() -> Iterator[str]:
   504	            sent = 0
   505	            while True:
   506	                with job._cond:
   507	                    pending = job.events[sent:]
   508	                    done = job.status in ("done", "error") and sent >= len(job.events)
   509	                    if not pending and not done:
   510	                        job._cond.wait(timeout=15)
   511	                        pending = job.events[sent:]
   512	                        done = job.status in ("done", "error") and sent >= len(job.events)
   513	                for ev in pending:
   514	                    sent += 1
   515	                    yield f"data: {json.dumps({'type': 'progress', **ev})}\n\n"
   516	                if done:
   517	                    final = {"type": job.status, "result": job.result, "error": job.error}
   518	                    yield f"data: {json.dumps(final)}\n\n"
   519	                    return
   520	                if not pending:
   521	                    yield ": ping\n\n"
   522	
   523	        return StreamingResponse(stream(), media_type="text/event-stream")
   524	
