   388	# ---------------------------------------------------------------------------
   389	# Gemini via the custom.gemini connector (credential stays in the vault)
   390	# ---------------------------------------------------------------------------
   391	
   392	class GeminiConnectorLLM(OpenAIChatLLM):
   393	    """OpenAI-shaped calls to Gemini, executed by the connector helper.
   394	
   395	    The helper (custom.gemini/bin/gemini.py) attaches an ``hsurr:``
   396	    surrogate to each request; the real API key is swapped in by the
   397	    runtime on egress to generativelanguage.googleapis.com. This class
   398	    therefore never sees a credential. All prompting, batching and
   399	    fallbacks are inherited from OpenAIChatLLM; only the transport
   400	    differs.
   401	    """
   402	
   403	    name = "gemini-connector"
   404	
   405	    def __init__(self, config: Config):
   406	        self.config = config
   407	        self.session = None  # transport is the helper subprocess, not requests
   408	
   409	    def _chat(self, system: str, user: str, json_mode: bool = False) -> str:
   410	        body: dict = {
   411	            "model": self.config.llm_model,
   412	            "messages": [
   413	                {"role": "system", "content": system},
   414	                {"role": "user", "content": user},
   415	            ],
   416	            "temperature": 0.2,
   417	        }
   418	        if json_mode:
   419	            body["response_format"] = {"type": "json_object"}
   420	        # The egress path to Google intermittently stalls (observed reads
   421	        # hanging past 180s). Retry a few times before giving up; callers
   422	        # degrade to the heuristic backend only after every attempt fails.
   423	        last_error: Exception | None = None
   424	        for attempt, pause in enumerate((0, 5, 15)):
   425	            if pause:
   426	                time.sleep(pause)
   427	            try:
   428	                proc = subprocess.run(
   429	                    [sys.executable, str(self.config.gemini_helper), "chat"],
   430	                    input=json.dumps(body),
   431	                    capture_output=True,
   432	                    text=True,
   433	                    timeout=150,
   434	                )
   435	                if proc.returncode != 0:
   436	                    raise RuntimeError(f"gemini helper failed: {proc.stderr.strip()[-400:]}")
   437	                data = json.loads(proc.stdout)
   438	                return data["choices"][0]["message"]["content"]
   439	            except Exception as exc:  # timeout, helper error, bad payload
   440	                last_error = exc
   441	        raise RuntimeError(f"gemini connector failed after retries: {last_error}")
   442	
   443	
   444	def get_llm(config: Config) -> HeuristicLLM:
   445	    if config.llm_backend == "gemini-connector":
   446	        return GeminiConnectorLLM(config)
   447	    if config.llm_backend == "heuristic":
   448	        return HeuristicLLM()
   449	    if config.llm_api_key:
   450	        return OpenAIChatLLM(config)
   451	    return HeuristicLLM()
     1	"""Deterministic helpers: citation keys, deduplication, heuristic MATCH."""
     2	
     3	from __future__ import annotations
     4	
     5	import math
     6	import re
     7	
     8	from .models import Paper
     9	
    10	_STOPWORDS = {
    11	    "a", "an", "the", "of", "for", "and", "or", "to", "in", "on", "with",
    12	    "using", "via", "based", "toward", "towards", "from", "by", "at", "as",
    13	    "is", "are", "be", "we", "our", "this", "that", "it", "its", "into",
    14	    "including", "include", "includes", "between", "among", "within",
    15	    "study", "studies", "paper", "approach", "approaches", "method",
    16	    "methods", "analysis", "research",
    17	}
    18	
    19	
    20	def tokenize(text: str) -> list[str]:
    21	    return [t for t in re.findall(r"[a-z0-9]+", text.lower()) if len(t) > 2]
    22	
    23	
    24	def content_tokens(text: str) -> set[str]:
    25	    return {t for t in tokenize(text) if t not in _STOPWORDS}
    26	
    27	
    28	def normalize_title(title: str) -> str:
    29	    return re.sub(r"[^a-z0-9]+", " ", title.lower()).strip()
    30	
    31	
    32	def make_key(paper: Paper, taken: set[str]) -> str:
    33	    """Author-year citation key in Undermind's style: Zha25, Cai26, Cai26b."""
    34	    surname = paper.first_author_surname()
    35	    base_name = surname[:12]
    36	    year2 = f"{paper.year % 100:02d}" if paper.year else "nd"
    37	    base = f"{base_name}{year2}"
    38	    if base not in taken:
    39	        taken.add(base)
    40	        return base
    41	    # Undermind style: first collision gets 'b', then 'c', ...
    42	    for suffix_ord in range(ord("b"), ord("z") + 1):
    43	        candidate = base + chr(suffix_ord)
    44	        if candidate not in taken:
    45	            taken.add(candidate)
    46	            return candidate
    47	    n = 2
    48	    while f"{base}x{n}" in taken:
    49	        n += 1
    50	    candidate = f"{base}x{n}"
    51	    taken.add(candidate)
    52	    return candidate
    53	
    54	
    55	def _merge_into(dst: Paper, src: Paper) -> None:
    56	    for s in src.sources:
    57	        if s not in dst.sources:
    58	            dst.sources.append(s)
    59	    if not dst.abstract and src.abstract:
    60	        dst.abstract = src.abstract
    61	    if not dst.open_access_pdf and src.open_access_pdf:
    62	        dst.open_access_pdf = src.open_access_pdf
    63	    if not dst.doi and src.doi:
    64	        dst.doi = src.doi
    65	    if not dst.arxiv_id and src.arxiv_id:
    66	        dst.arxiv_id = src.arxiv_id
    67	    if not dst.tldr and src.tldr:
    68	        dst.tldr = src.tldr
    69	    if not dst.venue and src.venue:
    70	        dst.venue = src.venue
    71	    if not dst.year and src.year:
    72	        dst.year = src.year
    73	    if src.citation_count > dst.citation_count:
    74	        dst.citation_count = src.citation_count
    75	    if not dst.authors and src.authors:
    76	        dst.authors = src.authors
    77	    if not dst.url and src.url:
    78	        dst.url = src.url
    79	
    80	
    81	def identity_keys(paper: Paper) -> set[str]:
    82	    """All identity keys a paper can be recognized by across sources.
    83	
    84	    The same real paper arrives with different ids per source (S2 id,
    85	    OpenAlex W-id, DOI-based id) and DOI coverage differs per record, so
    86	    cross-stage deduplication must match on ANY of id / DOI / title.
    87	    """
    88	    keys = {f"id:{paper.paper_id}"}
    89	    if paper.doi:
    90	        keys.add(f"doi:{paper.doi.lower()}")
    91	    title_key = normalize_title(paper.title)
    92	    if title_key:
    93	        keys.add(f"title:{title_key}")
    94	    return keys
    95	
    96	
    97	def dedupe(papers: list[Paper]) -> list[Paper]:
    98	    """Merge duplicates by DOI, else canonical id, else normalized title."""
    99	    by_doi: dict[str, Paper] = {}
   100	    by_id: dict[str, Paper] = {}
   101	    by_title: dict[str, Paper] = {}
   102	    out: list[Paper] = []
   103	    for p in papers:
   104	        found: Paper | None = None
   105	        if p.doi and p.doi.lower() in by_doi:
   106	            found = by_doi[p.doi.lower()]
   107	        elif p.paper_id in by_id:
   108	            found = by_id[p.paper_id]
   109	        elif normalize_title(p.title) in by_title:
   110	            found = by_title[normalize_title(p.title)]
   111	        if found is None:
   112	            out.append(p)
   113	            found = p
   114	        else:
   115	            _merge_into(found, p)
   116	        if found.doi:
   117	            by_doi[found.doi.lower()] = found
   118	        by_id[found.paper_id] = found
   119	        by_title[normalize_title(found.title)] = found
   120	    return out
   121	
   122	
   123	def lexical_relevance(query_text: str, paper: Paper) -> float:
   124	    """0..1 overlap of query content tokens with title (boosted) and abstract."""
   125	    q = content_tokens(query_text)
   126	    if not q:
   127	        return 0.0
   128	    title_tokens = content_tokens(paper.title)
   129	    abstract_tokens = content_tokens(paper.abstract or "")
   130	    title_hits = len(q & title_tokens)
   131	    abstract_hits = len(q & abstract_tokens)
   132	    coverage = (abstract_hits + 1.6 * title_hits) / (len(q) * 1.6)
   133	    return max(0.0, min(1.0, coverage))
   134	
   135	
   136	def heuristic_match(criteria: list[str], paper: Paper, current_year: int = 2026) -> tuple[float, str]:
   137	    """Offline MATCH score (0..100) + a short human-readable reason.
   138	
   139	    Combines lexical relevance to the search criteria (dominant), citation
   140	    velocity (mild), and recency (mild). Deterministic and testable.
   141	    """
   142	    joined = " ".join(criteria)
   143	    rel = max(lexical_relevance(c, paper) for c in criteria) if criteria else lexical_relevance(joined, paper)
   144	    avg_rel = (
   145	        sum(lexical_relevance(c, paper) for c in criteria) / len(criteria) if criteria else rel
   146	    )
   147	    relevance = 0.75 * rel + 0.25 * avg_rel
   148	
   149	    velocity = paper.citations_per_year(current_year)
   150	    citation_component = min(1.0, math.log10(1 + velocity) / 2.0)  # 100/yr -> 1.0
   151	
   152	    if paper.year:
   153	        age = current_year - paper.year
   154	        recency_component = 1.0 if age <= 2 else max(0.0, 1.0 - (age - 2) / 12.0)
   155	    else:
   156	        recency_component = 0.3
   157	
   158	    score = 100.0 * (0.78 * relevance + 0.12 * citation_component + 0.10 * recency_component)
   159	    score = round(max(0.0, min(100.0, score)), 1)
   160	
   161	    matched = sorted(content_tokens(joined) & content_tokens(paper.title + " " + (paper.abstract or "")))
   162	    reason_bits = []
   163	    if matched:
   164	        reason_bits.append("matched terms: " + ", ".join(matched[:6]))
   165	    if paper.citation_count:
   166	        reason_bits.append(f"{paper.citation_count} citations")
   167	    if paper.year:
   168	        reason_bits.append(f"year {paper.year}")
   169	    return score, "; ".join(reason_bits) or "weak lexical overlap"
