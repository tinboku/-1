    29	            pool.extend(s2.search(criterion, limit=25, year=f"{since_year}-"))
    30	        except Exception:
    31	            continue
    32	    for paper in dedupe(pool):
    33	        if paper.year and paper.year < since_year:
    34	            continue
    35	        db_id = store.upsert_paper(paper)
    36	        if db_id in known_ids:
    37	            continue
    38	        score, _reason = llm.score_matches(search["criteria"], [paper])[0]
    39	        if score >= threshold:
    40	            store.add_update(search_id, db_id)
    41	            fresh.append({"paper_id": db_id, "key": paper.key, "title": paper.title, "year": paper.year, "match": score})
    42	    return fresh

