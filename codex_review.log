    43	    # -- brainstorming ----------------------------------------------------
    44	    def brainstorm(self, question: str) -> list[str]:
    45	        return [
    46	            "Scope: should the search focus narrowly on the core approach named in "
    47	            "your question, or also include earlier and adjacent approaches as "
    48	            "comparison points?",
    49	            "Purpose: is the goal mainly discovery and cataloguing of what exists, "
    50	            "or should evaluation of quality and usefulness be a priority as well?",
    51	        ]
    52	
    53	    # -- criteria -----------------------------------------------------------
    54	    def make_criteria(self, question: str, answers: dict[str, str] | None = None) -> list[str]:
    55	        criteria = [question.strip()]
    56	        focus_terms: list[str] = []
    57	        if answers:
    58	            joined_answers = " ".join(answers.values())
    59	            focus_terms = [t for t in content_tokens(joined_answers) if len(t) > 4][:6]
    60	        if focus_terms:
    61	            criteria.append(question.strip() + " — focus: " + ", ".join(focus_terms))
    62	        # A third, term-based criterion built from the question's content words.
    63	        terms = [t for t in content_tokens(question) if len(t) > 4][:8]
    64	        if terms:
    65	            criteria.append("Papers about: " + " ".join(terms))
    66	        return criteria
