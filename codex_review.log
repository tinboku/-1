   107	    def upsert_paper(self, paper: Paper) -> int:
   108	        """Insert or enrich a paper; assigns a citation KEY on first insert."""
   109	        row = self.conn.execute(
   110	            "SELECT id FROM papers WHERE paper_uid = ?", (paper.paper_id,)
   111	        ).fetchone()
   112	        if row is None and paper.doi:
   113	            row = self.conn.execute(
   114	                "SELECT id FROM papers WHERE doi = ?", (paper.doi,)
   115	            ).fetchone()
   116	        if row is not None:
   117	            pid = int(row["id"])
   118	            # Enrich missing fields only.
   119	            cur = self.conn.execute("SELECT * FROM papers WHERE id = ?", (pid,)).fetchone()
   120	            if not paper.key and cur["key"]:
   121	                paper.key = cur["key"]
   122	            updates: dict[str, object] = {}
   123	            if not cur["abstract"] and paper.abstract:
   124	                updates["abstract"] = paper.abstract
   125	            if not cur["oa_pdf"] and paper.open_access_pdf:
   126	                updates["oa_pdf"] = paper.open_access_pdf
   127	            if not cur["tldr"] and paper.tldr:
   128	                updates["tldr"] = paper.tldr
   129	            if paper.citation_count > (cur["citation_count"] or 0):
   130	                updates["citation_count"] = paper.citation_count
   131	            if updates:
   132	                sets = ", ".join(f"{k} = ?" for k in updates)
   133	                self.conn.execute(
   134	                    f"UPDATE papers SET {sets} WHERE id = ?", (*updates.values(), pid)
   135	                )
   136	                self.conn.commit()
   137	            return pid
   138	        if not paper.key:
   139	            paper.key = make_key(paper, self._taken_keys())
   140	        cur = self.conn.execute(
   141	            """INSERT INTO papers (paper_uid, key, title, abstract, year, authors, venue,
   142	               citation_count, reference_count, doi, arxiv_id, oa_pdf, url, tldr, source, created_at)
   143	               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
   144	            (
   145	                paper.paper_id, paper.key, paper.title, paper.abstract, paper.year,
   146	                json.dumps(paper.authors), paper.venue, paper.citation_count,
   147	                paper.reference_count, paper.doi, paper.arxiv_id,
   148	                paper.open_access_pdf, paper.url, paper.tldr, paper.source, time.time(),
   149	            ),
