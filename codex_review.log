    66	    def test_full_run(self):
    67	        outcome = self.engine.run("dataset descriptions with LLMs", CRITERIA, per_query=10)
    68	        # Included: P1, P2 (merged), P5, P6 from search + P4 from snowballing. P3 excluded.
    69	        self.assertEqual(outcome.found, 5)
    70	        self.assertEqual(outcome.excluded_count, 1)
    71	        self.assertTrue(outcome.converged)
    72	        self.assertGreaterEqual(outcome.rounds, 1)
    73	        titles = [p.title for p in outcome.included]
    74	        self.assertTrue(any("AutoDDG" in t for t in titles))
    75	        self.assertTrue(any("Metadata Generation for Catalogs" in t for t in titles))
    76	        # Provenance: the snowballed paper records which seed it came from.
    77	        snowballed = [p for p in outcome.included if "Catalogs" in p.title][0]
    78	        self.assertEqual(snowballed.found_via, "citations of [Zhang25]")
    79	        stored_snow = [p for p in self.store.search_papers(outcome.search_id) if "Catalogs" in p.title][0]
    80	        self.assertEqual(stored_snow.found_via, "citations of [Zhang25]")
    81	        for p in outcome.included:
    82	            self.assertIsNotNone(p.key)
    83	            self.assertGreaterEqual(p.match, 55)
    84	        # Coverage: S2 relevant {P1,P2,P4}=3, OA relevant {P2,P5,P6}=3, overlap {P2}=1
    85	        self.assertIsNotNone(outcome.coverage)
    86	        self.assertAlmostEqual(outcome.coverage["estimated_total_relevant"], 7.0)
    87	        self.assertAlmostEqual(outcome.coverage["estimated_coverage"], 5 / 7, places=3)
    88	        # Persisted
    89	        stored = self.store.search_papers(outcome.search_id, included_only=True)
    90	        self.assertEqual(len(stored), 5)
    91	        search = self.store.get_search(outcome.search_id)
    92	        self.assertEqual(search["counts"]["found"], 5)
