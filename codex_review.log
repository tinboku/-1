   203	def _resolve_seed(ctx, identifier: str) -> Paper | None:
   204	    """Same resolution order as the CLI's `trace` command."""
   205	    stored = ctx.store.find_paper(identifier)
   206	    if stored is not None:
   207	        if stored.paper_id.startswith("doi:"):
   208	            try:
   209	                seed = ctx.s2.paper(f"DOI:{stored.doi}") if stored.doi else None
   210	            except Exception:
   211	                seed = None
   212	            if seed is not None:
   213	                return seed
   214	        else:
   215	            return stored
   216	    if identifier.startswith("10."):
   217	        try:
   218	            return ctx.s2.paper(f"DOI:{identifier}")
   219	        except Exception:
   220	            pass
   221	    try:
   222	        results = ctx.s2.search(identifier, limit=1)
   223	        return results[0] if results else None
   224	    except Exception:
   225	        return None
