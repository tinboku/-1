    82	def _wait_job(client: TestClient, job_id: str, timeout: float = 10.0) -> dict:
    83	    deadline = time.time() + timeout
    84	    while time.time() < deadline:
    85	        snap = client.get(f"/api/jobs/{job_id}").json()
    86	        if snap["status"] in ("done", "error"):
    87	            return snap
    88	        time.sleep(0.05)
    89	    raise AssertionError("job did not finish in time")
