   115	    </label>
   116	    <div id="ns-plan-area" class="hidden">
   117	      <h4>澄清问题（可留空）</h4>
   118	      <div id="ns-questions"></div>
   119	      <h4>检索标准（可编辑，一行一条）</h4>
   120	      <textarea id="ns-criteria" rows="5"></textarea>
   121	    </div>
   122	    <div class="dlg-actions">
