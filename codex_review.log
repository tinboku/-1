    37	// Stream a job's progress events; resolves with the final event
    38	// ({type: "done"|"error", result, error}).
    39	export function watchJob(jobId, onProgress) {
    40	  return new Promise((resolve, reject) => {
    41	    const es = new EventSource(`/api/jobs/${jobId}/events`);
    42	    es.onmessage = (msg) => {
    43	      let ev;
    44	      try { ev = JSON.parse(msg.data); } catch { return; }
    45	      if (ev.type === "progress") {
    46	        onProgress(ev);
    47	      } else {
    48	        es.close();
    49	        resolve(ev);
    50	      }
    51	    };
    52	    es.onerror = () => {
    53	      // EventSource fires error on close too; fall back to one snapshot poll.
    54	      es.close();
    55	      api.getJob(jobId).then((snap) => {
    56	        if (snap.status === "done") resolve({ type: "done", result: snap.result });
    57	        else if (snap.status === "error") resolve({ type: "error", error: snap.error });
    58	        else reject(new Error("progress stream disconnected"));
    59	      }).catch(reject);
    60	    };
    61	  });
    62	}

