   286	async function sendAsk() {
   287	  if (!needSearch()) return;
   288	  const q = $("ask-input").value.trim();
   289	  if (!q) return;
   290	  $("ask-input").value = "";
   291	  const log = $("ask-log");
   292	  if (log.querySelector(".muted")) log.innerHTML = "";
   293	  const u = document.createElement("div");
   294	  u.className = "ask-msg user"; u.textContent = q; log.appendChild(u);
   295	  const b = document.createElement("div");
   296	  b.className = "ask-msg bot"; b.textContent = "思考中…"; log.appendChild(b);
   297	  try {
   298	    const { answer } = await api.ask(state.searchId, q);
   299	    b.innerHTML = renderMarkdown(answer);
   300	  } catch (e) {
   301	    b.textContent = "出错：" + e.message;
   302	  }
   303	}
   304	$("btn-ask").addEventListener("click", sendAsk);
   305	$("ask-input").addEventListener("keydown", (e) => { if (e.key === "Enter") sendAsk(); });
   306	
   307	/* ------------------------------------------------------------------ */
   308	/* dialogs: new search / trace / import                                */
   309	/* ------------------------------------------------------------------ */
   310	const dlgSearch = $("dlg-search");
   311	$("btn-new-search").addEventListener("click", () => { dlgSearch.showModal(); });
   312	
   313	$("ns-plan").addEventListener("click", async () => {
   314	  const question = $("ns-question").value.trim();
   315	  if (!question) { alert("先写研究问题。"); return; }
   316	  const btn = $("ns-plan");
   317	  btn.disabled = true; btn.textContent = "生成中…";
   318	  try {
   319	    const { questions, criteria } = await api.plan(question, {});
   320	    $("ns-questions").innerHTML = questions.map((q) => `
   321	      <div class="ns-q"><div class="qtext">${esc(q)}</div>
   322	      <input type="text" data-q="${esc(q)}" placeholder="你的回答（可留空）"></div>`).join("");
   323	    $("ns-criteria").value = criteria.join("\n");
   324	    $("ns-plan-area").classList.remove("hidden");
   325	    btn.textContent = "按回答重新生成标准";
   326	  } finally { btn.disabled = false; }
   327	});
   328	
   329	$("ns-launch").addEventListener("click", async () => {
   330	  const question = $("ns-question").value.trim();
   331	  if (!question) { alert("先写研究问题。"); return; }
   332	  const answers = {};
   333	  document.querySelectorAll("#ns-questions input").forEach((inp) => {
   334	    if (inp.value.trim()) answers[inp.dataset.q] = inp.value.trim();
   335	  });
   336	  const criteriaText = $("ns-criteria").value.trim();
   337	  const criteria = criteriaText ? criteriaText.split("\n").map((x) => x.trim()).filter(Boolean) : null;
   338	  dlgSearch.close();
   339	  const { job_id } = await api.launchSearch({ question, criteria, answers });
   340	  const final = await runJob(job_id, "深度检索");
   341	  await refreshSearches();
   342	  if (final.type === "done" && final.result?.search_id) openSearch(final.result.search_id);
   343	});
   344	
   345	const dlgTrace = $("dlg-trace");
   346	$("btn-new-trace").addEventListener("click", () => dlgTrace.showModal());
   347	$("tr-launch").addEventListener("click", async () => {
   348	  const identifier = $("tr-seed").value.trim();
   349	  if (!identifier) { alert("先填种子论文。"); return; }
   350	  const question = $("tr-question").value.trim() || null;
   351	  dlgTrace.close();
   352	  const { job_id } = await api.launchTrace({ identifier, question, hops: 1 });
   353	  const final = await runJob(job_id, "引用图谱扩展");
   354	  await refreshSearches();
   355	  if (final.type === "done" && final.result?.search_id) openSearch(final.result.search_id);
   356	});
   357	
   358	const dlgDoi = $("dlg-doi");
   359	$("btn-import-doi").addEventListener("click", () => dlgDoi.showModal());
   360	$("doi-launch").addEventListener("click", async () => {
   361	  const doi = $("doi-input").value.trim();
   362	  if (!doi) return;
   363	  dlgDoi.close();
   364	  try {
   365	    const p = await api.importDoi(doi);
   366	    alert(`已导入 [${p.key}] ${p.title}`);
   367	  } catch (e) {
   368	    alert("导入失败：" + e.message);
   369	  }
   370	});
   371	
   372	/* ------------------------------------------------------------------ */
   373	/* boot                                                                */
   374	/* ------------------------------------------------------------------ */
   375	(async function boot() {
   376	  try {
   377	    const h = await api.health();
   378	    const el = $("backend-status");
   379	    el.textContent = `后端 OK · ${h.llm_backend} · ${h.llm_model}`;
   380	    el.classList.add("ok");
   381	  } catch {
   382	    $("backend-status").textContent = "后端未连接";
   383	  }
   384	  await refreshSearches();
   385	  await refreshFiles();
   386	})();
