    36	def serve(ctx, port: int = 8765) -> None:
    37	    store = ctx.store
    38	
    39	    class Handler(BaseHTTPRequestHandler):
    40	        def log_message(self, *args):  # quiet
    41	            pass
    42	
    43	        def _send(self, body: bytes, status: int = 200):
    44	            self.send_response(status)
    45	            self.send_header("Content-Type", "text/html; charset=utf-8")
    46	            self.send_header("Content-Length", str(len(body)))
    47	            self.end_headers()
    48	            self.wfile.write(body)
    49	
    50	        def do_GET(self):
    51	            parsed = urlparse(self.path)
    52	            path = parsed.path
    53	            try:
    54	                if path == "/":
    55	                    return self._home()
    56	                if path == "/papers":
    57	                    return self._papers()
    58	                if path == "/updates":
    59	                    return self._updates()
    60	                if path.startswith("/search/"):
    61	                    return self._search(int(path.split("/")[2]))
    62	                if path.startswith("/report/"):
    63	                    return self._report(int(path.split("/")[2]))
    64	                self._send(_page("404", "<h1>Not found</h1>"), 404)
    65	            except Exception as exc:
    66	                self._send(_page("Error", f"<h1>Error</h1><p>{html.escape(str(exc))}</p>"), 500)
    67	
    68	        def do_POST(self):
    69	            parsed = urlparse(self.path)
    70	            if parsed.path != "/run-search":
    71	                self._send(_page("404", "<h1>Not found</h1>"), 404)
    72	                return
    73	            length = int(self.headers.get("Content-Length", 0))
    74	            form = parse_qs(self.rfile.read(length).decode("utf-8"))
    75	            question = (form.get("question") or [""])[0].strip()
    76	            if not question:
    77	                self._send(_page("Search", "<p>Please enter a question.</p>"))
    78	                return
    79	            criteria = ctx.engine.build_criteria(question, {})
    80	            outcome = ctx.engine.run(question, criteria, per_query=30, max_rounds=1)
    81	            self.send_response(303)
    82	            self.send_header("Location", f"/search/{outcome.search_id}")
    83	            self.end_headers()
