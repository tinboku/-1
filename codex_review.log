     1	"""Semantic Scholar Graph API client (primary data source).
     2	
     3	Docs: https://api.semanticscholar.org/api-docs/graph
     4	Anonymous calls share a heavily throttled pool; with an API key the
     5	introductory limit is 1 req/s. This client backs off exponentially on
     6	429/5xx and raises RateLimited when the budget of retries is exhausted,
     7	so callers can degrade gracefully instead of crashing.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import time
    13	
    14	import requests
    15	
    16	from ..models import Paper
    17	
    18	BASE = "https://api.semanticscholar.org/graph/v1"
    19	FIELDS = (
    20	    "title,abstract,year,authors,venue,citationCount,referenceCount,"
    21	    "externalIds,openAccessPdf,url,tldr"
    22	)
    23	# Edge endpoints (citations/references) reject `tldr` on nested papers.
    24	FIELDS_EDGE = (
    25	    "title,abstract,year,authors,venue,citationCount,referenceCount,"
    26	    "externalIds,openAccessPdf,url"
    27	)
    28	
    29	
    30	class RateLimited(Exception):
    31	    pass
    32	
    33	
    34	class SemanticScholarClient:
    35	    name = "semantic_scholar"
    36	
    37	    def __init__(self, api_key: str | None = None, max_retries: int = 4):
    38	        self.api_key = api_key
    39	        self.max_retries = max_retries
    40	        self.session = requests.Session()
    41	        self.session.headers.update({"Accept": "application/json"})
    42	        if api_key:
    43	            self.session.headers.update({"x-api-key": api_key})
    44	
    45	    # -- low level ------------------------------------------------------
    46	    def _get(self, path: str, params: dict | None = None) -> dict:
    47	        url = f"{BASE}{path}"
    48	        delay = 1.0 if self.api_key else 2.0
    49	        last_status = None
    50	        for attempt in range(self.max_retries):
    51	            resp = self.session.get(url, params=params, timeout=30)
    52	            last_status = resp.status_code
    53	            if resp.status_code == 200:
    54	                return resp.json()
    55	            if resp.status_code in (429, 500, 502, 503, 504):
    56	                retry_after = resp.headers.get("Retry-After")
    57	                wait = float(retry_after) if retry_after and retry_after.isdigit() else delay
    58	                time.sleep(min(wait, 30.0))
    59	                delay *= 2
    60	                continue
    61	            resp.raise_for_status()
    62	        raise RateLimited(f"Semantic Scholar throttled after retries (status {last_status})")
    63	
    64	    # -- mapping ---------------------------------------------------------
    65	    @staticmethod
    66	    def _to_paper(d: dict) -> Paper | None:
    67	        if not d or not d.get("paperId") or not d.get("title"):
    68	            return None
    69	        ext = d.get("externalIds") or {}
    70	        oa = d.get("openAccessPdf") or {}
    71	        return Paper(
    72	            paper_id=d["paperId"],
    73	            title=d["title"],
    74	            abstract=d.get("abstract"),
    75	            year=d.get("year"),
    76	            authors=[a.get("name", "") for a in (d.get("authors") or []) if a.get("name")],
    77	            venue=d.get("venue"),
    78	            citation_count=d.get("citationCount") or 0,
    79	            reference_count=d.get("referenceCount") or 0,
    80	            doi=ext.get("DOI"),
    81	            arxiv_id=ext.get("ArXiv"),
    82	            open_access_pdf=oa.get("url"),
    83	            url=d.get("url"),
    84	            tldr=(d.get("tldr") or {}).get("text"),
    85	            source="semantic_scholar",
    86	        )
    87	
    88	    # -- API -------------------------------------------------------------
    89	    def search(self, query: str, limit: int = 50, offset: int = 0, year: str | None = None) -> list[Paper]:
    90	        params: dict = {"query": query, "limit": min(limit, 100), "offset": offset, "fields": FIELDS}
    91	        if year:
    92	            params["year"] = year
    93	        data = self._get("/paper/search", params)
    94	        return [p for p in (self._to_paper(d) for d in data.get("data") or []) if p]
    95	
    96	    def paper(self, paper_id: str) -> Paper | None:
    97	        data = self._get(f"/paper/{paper_id}", {"fields": FIELDS})
    98	        return self._to_paper(data)
    99	
   100	    def citations(self, paper_id: str, limit: int = 50) -> list[Paper]:
   101	        data = self._get(
   102	            f"/paper/{paper_id}/citations",
   103	            {"limit": min(limit, 1000), "fields": f"citingPaper.{FIELDS_EDGE}".replace(",", ",citingPaper.")},
   104	        )
   105	        out = []
   106	        for edge in data.get("data") or []:
   107	            p = self._to_paper(edge.get("citingPaper") or {})
   108	            if p:
   109	                out.append(p)
   110	        return out
   111	
   112	    def references(self, paper_id: str, limit: int = 50) -> list[Paper]:
   113	        data = self._get(
   114	            f"/paper/{paper_id}/references",
   115	            {"limit": min(limit, 1000), "fields": f"citedPaper.{FIELDS_EDGE}".replace(",", ",citedPaper.")},
   116	        )
   117	        out = []
   118	        for edge in data.get("data") or []:
   119	            p = self._to_paper(edge.get("citedPaper") or {})
   120	            if p:
   121	                out.append(p)
   122	        return out
     1	"""OpenAlex API client (secondary source + forward snowballing).
     2	
     3	Docs: https://docs.openalex.org
     4	OpenAlex moved to keyed, credit-based access in 2026; without a key the
     5	trial budget is tiny, so failures surface as RateLimited and the engine
     6	falls back to single-source mode.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import time
    12	
    13	import requests
    14	
    15	from ..models import Paper
    16	from .semantic_scholar import RateLimited
    17	
    18	BASE = "https://api.openalex.org"
    19	
    20	
    21	class OpenAlexClient:
    22	    name = "openalex"
    23	
    24	    def __init__(self, api_key: str | None = None, email: str | None = None, max_retries: int = 3):
    25	        self.api_key = api_key
    26	        self.email = email
    27	        self.max_retries = max_retries
    28	        self.session = requests.Session()
    29	        self.session.headers.update({"Accept": "application/json"})
    30	
    31	    def _params(self, extra: dict) -> dict:
    32	        params = dict(extra)
    33	        if self.api_key:
    34	            params["api_key"] = self.api_key
    35	        elif self.email:
    36	            params["mailto"] = self.email
    37	        return params
    38	
    39	    def _get(self, path: str, params: dict) -> dict:
    40	        delay = 1.5
    41	        last_status = None
    42	        for _ in range(self.max_retries):
    43	            resp = self.session.get(f"{BASE}{path}", params=self._params(params), timeout=30)
    44	            last_status = resp.status_code
    45	            if resp.status_code == 200:
    46	                return resp.json()
    47	            if resp.status_code in (409, 429, 500, 502, 503, 504):
    48	                time.sleep(delay)
    49	                delay *= 2
    50	                continue
    51	            resp.raise_for_status()
    52	        raise RateLimited(f"OpenAlex unavailable after retries (status {last_status})")
    53	
    54	    # -- mapping ---------------------------------------------------------
    55	    @staticmethod
    56	    def _decode_abstract(inverted: dict | None) -> str | None:
    57	        if not inverted:
    58	            return None
    59	        positions: list[tuple[int, str]] = []
    60	        for word, idxs in inverted.items():
    61	            for i in idxs:
    62	                positions.append((i, word))
    63	        positions.sort()
    64	        return " ".join(w for _, w in positions)
    65	
    66	    @classmethod
    67	    def _to_paper(cls, w: dict) -> Paper | None:
    68	        if not w or not w.get("id") or not w.get("title"):
    69	            return None
    70	        authors = []
    71	        for a in w.get("authorships") or []:
    72	            name = (a.get("author") or {}).get("display_name")
    73	            if name:
    74	                authors.append(name)
    75	        source = ((w.get("primary_location") or {}).get("source") or {}).get("display_name")
    76	        oa = w.get("open_access") or {}
    77	        best_oa = w.get("best_oa_location") or {}
    78	        doi = w.get("doi")
    79	        if doi and doi.startswith("https://doi.org/"):
    80	            doi = doi[len("https://doi.org/"):]
    81	        return Paper(
    82	            paper_id=w["id"].rsplit("/", 1)[-1],  # e.g. W2741809807
    83	            title=w["title"],
    84	            abstract=cls._decode_abstract(w.get("abstract_inverted_index")),
    85	            year=w.get("publication_year"),
    86	            authors=authors,
    87	            venue=source,
    88	            citation_count=w.get("cited_by_count") or 0,
    89	            reference_count=len(w.get("referenced_works") or []),
    90	            doi=doi,
    91	            open_access_pdf=best_oa.get("pdf_url") if oa.get("is_oa") else None,
    92	            url=w.get("id"),
    93	            source="openalex",
    94	        )
    95	
    96	    # -- API -------------------------------------------------------------
    97	    def search(self, query: str, per_page: int = 25) -> list[Paper]:
    98	        data = self._get("/works", {"search": query, "per_page": min(per_page, 100)})
    99	        return [p for p in (self._to_paper(w) for w in data.get("results") or []) if p]
   100	
   101	    def work_id_for_doi(self, doi: str) -> str | None:
   102	        data = self._get(f"/works/doi:{doi}", {})
   103	        wid = data.get("id")
   104	        return wid.rsplit("/", 1)[-1] if wid else None
   105	
   106	    def citing(self, openalex_id: str, per_page: int = 25) -> list[Paper]:
   107	        """Papers that cite the given work (forward snowballing)."""
   108	        data = self._get("/works", {"filter": f"cites:{openalex_id}", "per_page": min(per_page, 100)})
   109	        return [p for p in (self._to_paper(w) for w in data.get("results") or []) if p]
     1	"""Crossref API client: DOI metadata lookup and enrichment."""
     2	
     3	from __future__ import annotations
     4	
     5	import html as _html
     6	import re
     7	
     8	import requests
     9	
    10	from ..models import Paper
    11	
    12	BASE = "https://api.crossref.org"
    13	
    14	
    15	def _clean_abstract(text: str | None) -> str | None:
    16	    if not text:
    17	        return None
    18	    cleaned = re.sub(r"<[^>]+>", " ", text)
    19	    cleaned = _html.unescape(re.sub(r"\s+", " ", cleaned)).strip()
    20	    return cleaned or None
    21	
    22	
    23	class CrossrefClient:
    24	    name = "crossref"
    25	
    26	    def __init__(self, email: str | None = None):
    27	        self.email = email
    28	        self.session = requests.Session()
    29	        ua = "deep-literature-search/0.1"
    30	        if email:
    31	            ua += f" (mailto:{email})"
    32	        self.session.headers.update({"Accept": "application/json", "User-Agent": ua})
    33	
    34	    @staticmethod
    35	    def _to_paper(item: dict) -> Paper | None:
    36	        if not item:
    37	            return None
    38	        title = (item.get("title") or [None])[0]
    39	        doi = item.get("DOI")
    40	        if not title or not doi:
    41	            return None
    42	        authors = []
    43	        for a in item.get("author") or []:
    44	            name = " ".join(x for x in [a.get("given"), a.get("family")] if x)
    45	            if name:
    46	                authors.append(name)
    47	        year = None
    48	        for key in ("published-print", "published-online", "issued", "created"):
    49	            parts = ((item.get(key) or {}).get("date-parts") or [[None]])[0]
    50	            if parts and parts[0]:
    51	                year = parts[0]
    52	                break
    53	        return Paper(
    54	            paper_id=f"doi:{doi}",
    55	            title=title,
    56	            abstract=_clean_abstract(item.get("abstract")),
    57	            year=year,
    58	            authors=authors,
    59	            venue=(item.get("container-title") or [None])[0],
    60	            citation_count=item.get("is-referenced-by-count") or 0,
    61	            reference_count=item.get("reference-count") or 0,
    62	            doi=doi,
    63	            url=item.get("URL"),
    64	            source="crossref",
    65	        )
    66	
    67	    def by_doi(self, doi: str) -> Paper | None:
    68	        resp = self.session.get(f"{BASE}/works/{doi}", timeout=30)
    69	        if resp.status_code == 404:
    70	            return None
    71	        resp.raise_for_status()
    72	        return self._to_paper(resp.json().get("message") or {})
    73	
    74	    def search(self, query: str, rows: int = 10) -> list[Paper]:
    75	        resp = self.session.get(
    76	            f"{BASE}/works", params={"query": query, "rows": rows}, timeout=30
    77	        )
    78	        resp.raise_for_status()
    79	        items = (resp.json().get("message") or {}).get("items") or []
    80	        return [p for p in (self._to_paper(i) for i in items) if p]
