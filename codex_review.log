    59	    def _snowball(self, seeds: list[Paper], limit_per_seed: int = 30) -> list[Paper]:
    60	        out: list[Paper] = []
    61	        for seed in seeds:
    62	            label = f"[{seed.key}]" if seed.key else f"'{seed.title[:40]}'"
