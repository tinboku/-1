    57	class TestEngine(unittest.TestCase):
    58	    def setUp(self):
    59	        self.tmp = tempfile.TemporaryDirectory()
    60	        self.store = Store(Path(self.tmp.name) / "test.db")
    61	        self.engine = DeepSearchEngine(FakeS2(), FakeOpenAlex(), HeuristicLLM(), self.store)
