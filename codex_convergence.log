+  status.className = final.type === "done" && !final.result?.degraded ? "status-done" : "status-error";
+  status.textContent = final.type === "done" ? (final.result?.degraded ? "⚠ 完成，结果不完整" : "✓ 完成") : `✗ ${final.error || "失败"}`;
