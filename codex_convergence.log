import tempfile
import unittest
from pathlib import Path

from dls.engine import DeepSearchEngine
from dls.llm import HeuristicLLM
from dls.models import Paper
from dls.store import Store

CRITERIA = [
    "natural-language descriptions of tabular datasets using large language "
    "models, including data profiling and metadata generation for catalogs"
]
ABSTRACT = (
    "We generate natural language descriptions of tabular datasets using large "
    "language models, with data profiling and metadata generation for dataset "
    "catalogs and discovery."
)


def mk(pid, title, abstract=ABSTRACT, year=2025, cites=30, doi=None, source="semantic_scholar", authors=None):
    return Paper(
        paper_id=pid, title=title, abstract=abstract, year=year,
        authors=authors or ["Alice Zhang"], citation_count=cites, doi=doi, source=source,
    )


P1 = mk("s2-1", "AutoDDG: Automated Dataset Description Generation", doi="10.1/a")
P2_S2 = mk("s2-2", "Polaris: Structured Dataset Descriptions", year=2026, cites=5, doi="10.1/b")
P2_OA = mk("W2", "Polaris: Structured Dataset Descriptions", year=2026, cites=5, doi="10.1/b", source="openalex")
P3 = mk(
    "s2-3", "Quantum error correction with surface codes",
    abstract="Fault tolerant quantum computation with surface codes and decoders.",
    year=2024, cites=900,
)
P4 = mk("s2-4", "Dataset Metadata Generation for Catalogs", year=2023, cites=12, doi="10.1/d")
P5 = mk("W5", "Metadata Generation for Dataset Discovery", year=2026, cites=3, source="openalex")
P6 = mk("W6", "Tabular Dataset Descriptions with Language Models", year=2026, cites=2, source="openalex")


class FakeS2:
    def search(self, query, limit=50, offset=0, year=None):
        return [P1, P2_S2, P3]

    def citations(self, paper_id, limit=50):
        return [P4] if paper_id == "s2-1" else []

    def references(self, paper_id, limit=50):
        return []


class FakeOpenAlex:
    def search(self, query, per_page=25):
        return [P2_OA, P5, P6]


class TestEngine(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.store = Store(Path(self.tmp.name) / "test.db")
        self.engine = DeepSearchEngine(FakeS2(), FakeOpenAlex(), HeuristicLLM(), self.store)

    def tearDown(self):
        self.tmp.cleanup()

    def test_full_run(self):
        outcome = self.engine.run("dataset descriptions with LLMs", CRITERIA, per_query=10)
        # Included: P1, P2 (merged), P5, P6 from search + P4 from snowballing. P3 excluded.
        self.assertEqual(outcome.found, 5)
        self.assertEqual(outcome.excluded_count, 1)
        self.assertTrue(outcome.converged)
        self.assertGreaterEqual(outcome.rounds, 1)
        titles = [p.title for p in outcome.included]
        self.assertTrue(any("AutoDDG" in t for t in titles))
        self.assertTrue(any("Metadata Generation for Catalogs" in t for t in titles))
        # Provenance: the snowballed paper records which seed it came from.
        snowballed = [p for p in outcome.included if "Catalogs" in p.title][0]
        self.assertEqual(snowballed.found_via, "citations of [Zhang25]")
        stored_snow = [p for p in self.store.search_papers(outcome.search_id) if "Catalogs" in p.title][0]
        self.assertEqual(stored_snow.found_via, "citations of [Zhang25]")
        for p in outcome.included:
            self.assertIsNotNone(p.key)
            self.assertGreaterEqual(p.match, 55)
        # Coverage: S2 relevant {P1,P2,P4}=3, OA relevant {P2,P5,P6}=3, overlap {P2}=1
        self.assertIsNotNone(outcome.coverage)
        self.assertAlmostEqual(outcome.coverage["estimated_total_relevant"], 7.0)
        self.assertAlmostEqual(outcome.coverage["estimated_coverage"], 5 / 7, places=3)
        # Persisted
        stored = self.store.search_papers(outcome.search_id, included_only=True)
        self.assertEqual(len(stored), 5)
        search = self.store.get_search(outcome.search_id)
        self.assertEqual(search["counts"]["found"], 5)


class FakeS2Clone:
    """Returns the seed paper again under a different id (cross-source clone)."""

    def search(self, query, limit=50, offset=0, year=None):
        return [P1]

    def citations(self, paper_id, limit=50):
        clone = mk("doi:10.1/a", P1.title, year=2025, cites=30, doi="10.1/a", source="crossref")
        return [clone]

    def references(self, paper_id, limit=50):
        return []


class TestCrossSourceDedup(unittest.TestCase):
    def test_clone_not_double_counted(self):
        with tempfile.TemporaryDirectory() as td:
            store = Store(Path(td) / "t.db")
            engine = DeepSearchEngine(FakeS2Clone(), None, HeuristicLLM(), store)
            outcome = engine.run("dataset descriptions with LLMs", CRITERIA, per_query=10)
            self.assertEqual(outcome.found, 1)
            self.assertEqual(outcome.included[0].title, P1.title)


class TestTrace(unittest.TestCase):
    def test_trace_from_seed(self):
        with tempfile.TemporaryDirectory() as td:
            store = Store(Path(td) / "t.db")
            engine = DeepSearchEngine(FakeS2(), None, HeuristicLLM(), store)
            seed = mk("s2-1", "AutoDDG: Automated Dataset Description Generation", doi="10.1/a")
            outcome = engine.trace(seed, question=CRITERIA[0])
            # FakeS2.citations(s2-1) -> [P4]; references -> [].
            self.assertEqual(outcome.found, 1)
            self.assertEqual(outcome.included[0].title, P4.title)
            self.assertEqual(outcome.included[0].found_via, "citations of [Zhang25]")


if __name__ == "__main__":
    unittest.main()
"""Offline tests for the HTTP API layer (dls.api).

Uses a fake engine/LLM context so no network or API key is needed.
Skipped automatically when fastapi is not installed (it is an optional
extra); run with the project venv:  .venv/bin/python -m unittest tests.test_api
"""

from __future__ import annotations

import tempfile
import time
import types
import unittest
from pathlib import Path

try:
    from fastapi.testclient import TestClient
except ImportError:  # pragma: no cover
    raise unittest.SkipTest("fastapi not installed (pip install -e .[api])")

from dls.api import create_app
from dls.models import Paper, SearchOutcome
from dls.store import Store


def _paper() -> Paper:
    p = Paper(
        paper_id="s2:abc",
        title="AutoDDG: Automated Dataset Description Generation",
        abstract="We generate descriptions of tabular datasets.",
        year=2025,
        authors=["Wei Zhang"],
        venue="ACM TODS",
        citation_count=12,
        doi="10.1145/3786626",
    )
    return p


def _fake_ctx(tmp: Path):
    store = Store(tmp / "library.db")
    paper = _paper()
    paper.match = 92.0
    paper.match_reason = "directly on topic"
    paper.found_via = "search"

    def fake_run(question, criteria, answers=None, project="default",
                 per_query=40, max_rounds=2, progress=None):
        sid = store.create_search(project, question, criteria, answers or {})
        if progress:
            progress("Searching for the most promising papers", "fake channel")
            progress("Identifying the best candidate papers", "1 candidates")
        db_id = store.upsert_paper(paper)
        paper.db_id = db_id
        store.save_results(sid, [paper], {db_id}, {"found": 1, "excluded": 0}, None)
        if progress:
            progress("Done", "1 papers")
        return SearchOutcome(
            search_id=sid, question=question, criteria=criteria, included=[paper],
            excluded_count=0, with_full_text=0, rounds=1, converged=True,
            coverage=None, warnings=[],
        )

    engine = types.SimpleNamespace(
        brainstorm=lambda q: ["Scope?", "Methods only?"],
        build_criteria=lambda q, answers=None: [q, "narrow scope"],
        run=fake_run,
        trace=None,
    )
    llm = types.SimpleNamespace(answer=lambda q, papers: f"answer over {len(papers)} papers")
    config = types.SimpleNamespace(
        llm_model="test-model",
        db_path=tmp / "library.db",
        files_dir=tmp / "files",
        ensure_dirs=lambda: (tmp / "files").mkdir(parents=True, exist_ok=True),
    )
    return types.SimpleNamespace(
        config=config, store=store, engine=engine, llm=llm, s2=None, crossref=None
    )


def _wait_job(client: TestClient, job_id: str, timeout: float = 10.0) -> dict:
    deadline = time.time() + timeout
    while time.time() < deadline:
        snap = client.get(f"/api/jobs/{job_id}").json()
        if snap["status"] in ("done", "error"):
            return snap
        time.sleep(0.05)
    raise AssertionError("job did not finish in time")


class ApiTest(unittest.TestCase):
    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp())
        self.ctx = _fake_ctx(self.tmp)
        self.client = TestClient(create_app(self.ctx))

    def test_health(self):
        r = self.client.get("/api/health")
        self.assertEqual(r.status_code, 200)
        self.assertTrue(r.json()["ok"])

    def test_plan(self):
        r = self.client.post("/api/plan", json={"question": "dataset descriptions with LLMs"})
        self.assertEqual(r.status_code, 200)
        body = r.json()
        self.assertEqual(len(body["questions"]), 2)
        self.assertEqual(len(body["criteria"]), 2)

    def test_search_job_flow(self):
        r = self.client.post("/api/searches", json={"question": "dataset descriptions"})
        self.assertEqual(r.status_code, 202)
        snap = _wait_job(self.client, r.json()["job_id"])
        self.assertEqual(snap["status"], "done", snap)
        self.assertEqual(snap["result"]["found"], 1)
        stages = [e["stage"] for e in snap["events"]]
        self.assertIn("Searching for the most promising papers", stages)

        search_id = snap["result"]["search_id"]
        detail = self.client.get(f"/api/searches/{search_id}").json()
        self.assertEqual(detail["question"], "dataset descriptions")
        self.assertEqual(len(detail["papers"]), 1)
        self.assertEqual(detail["papers"][0]["key"], "Zhang25")
        self.assertEqual(detail["papers"][0]["match"], 92.0)

    def test_search_events_stream(self):
        r = self.client.post("/api/searches", json={"question": "stream test"})
        job_id = r.json()["job_id"]
        _wait_job(self.client, job_id)
        with self.client.stream("GET", f"/api/jobs/{job_id}/events") as stream:
            text = "".join(chunk for chunk in stream.iter_text())
        self.assertIn('"type": "progress"', text)
        self.assertIn('"type": "done"', text)

    def test_ask_and_export_and_star(self):
        r = self.client.post("/api/searches", json={"question": "q"})
        snap = _wait_job(self.client, r.json()["job_id"])
        search_id = snap["result"]["search_id"]

        ans = self.client.post(f"/api/searches/{search_id}/ask", json={"question": "which?"})
        self.assertEqual(ans.json()["answer"], "answer over 1 papers")

        exp = self.client.get(f"/api/searches/{search_id}/export", params={"format": "bibtex"})
        self.assertEqual(exp.status_code, 200)
        self.assertIn("Zhang25", exp.text)

        papers = self.client.get("/api/papers").json()
        self.assertEqual(len(papers), 1)
        db_id = papers[0]["db_id"]
        star = self.client.post(f"/api/papers/{db_id}/star", json={"starred": True})
        self.assertEqual(star.json()["starred"], True)
        starred = self.client.get("/api/papers", params={"starred": True}).json()
        self.assertEqual(len(starred), 1)

    def test_unknown_job_404(self):
        self.assertEqual(self.client.get("/api/jobs/nope").status_code, 404)
        self.assertEqual(self.client.get("/api/searches/999").status_code, 404)


if __name__ == "__main__":
    unittest.main()
