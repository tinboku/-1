from fastapi import FastAPI, HTTPException, Query, Request
from fastapi.responses import PlainTextResponse, StreamingResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field

from .models import Paper

WEBAPP_DIR = Path(__file__).resolve().parent.parent / "webapp"


# ----------------------------------------------------------------------
# Job management
# ----------------------------------------------------------------------

@dataclass
class Job:
    id: str
    kind: str
    status: str = "queued"  # queued | running | done | error
    created_at: float = field(default_factory=time.time)
    finished_at: float | None = None
    events: list[dict] = field(default_factory=list)
    result: dict | None = None
    error: str | None = None
    _cond: threading.Condition = field(default_factory=threading.Condition, repr=False)

    def emit(self, stage: str, detail: str) -> None:
        with self._cond:
            self.events.append({"ts": time.time(), "stage": stage, "detail": detail})
            self._cond.notify_all()

    def finish(self, status: str, result: dict | None = None, error: str | None = None) -> None:
        with self._cond:
            self.status = status
            self.result = result
            self.error = error
            self.finished_at = time.time()
            self._cond.notify_all()

    def snapshot(self) -> dict:
        return {
            "id": self.id,
            "kind": self.kind,
            "status": self.status,
            "created_at": self.created_at,
            "finished_at": self.finished_at,

    @app.get("/api/searches/{search_id}")
    def get_search(search_id: int, included_only: bool = True) -> dict:
        with locked():
            search = ctx.store.get_search(search_id)
            if search is None:
                raise HTTPException(404, "search not found")
            papers = ctx.store.search_papers(search_id, included_only=included_only)
        search["papers"] = [paper_dict(p) for p in papers]
        return search

    @app.post("/api/searches", status_code=202)
    def launch_search(body: SearchIn) -> dict:
        def work(job: Job) -> dict:
            criteria = body.criteria
            if not criteria:
                with locked():
                    criteria = ctx.engine.build_criteria(body.question, body.answers or None)
            job.emit("Interpreting your search criteria", f"{len(criteria)} criteria")
            with locked():
                outcome = ctx.engine.run(
                    body.question,
                    criteria,
                    answers=body.answers,
                    project=body.project,
                    per_query=body.per_query,
                    max_rounds=body.rounds,
                    progress=job.emit,
                )
            return {
                "search_id": outcome.search_id,
                "found": outcome.found,
                "excluded": outcome.excluded_count,
                "with_full_text": outcome.with_full_text,
                "rounds": outcome.rounds,
                "converged": outcome.converged,
                "coverage": outcome.coverage,
                "warnings": outcome.warnings,
            }

        job = jobs.submit("search", work)
        return {"job_id": job.id}

    @app.post("/api/trace", status_code=202)
    def launch_trace(body: TraceIn) -> dict:
        def work(job: Job) -> dict:
            with locked():
                seed = _resolve_seed(ctx, body.identifier)
            if seed is None:
                raise ValueError(f"could not resolve seed paper: {body.identifier}")
            with locked():
                outcome = ctx.engine.trace(
                    seed, question=body.question, hops=body.hops, progress=job.emit
                )
            return {
                "search_id": outcome.search_id,
                "found": outcome.found,
                "excluded": outcome.excluded_count,
                "warnings": outcome.warnings,
            }

        job = jobs.submit("trace", work)
        return {"job_id": job.id}

    # -- per-search actions ----------------------------------------------------
    @app.post("/api/searches/{search_id}/report", status_code=202)
"""Pluggable LLM backends.

Two implementations of the same interface:

- ``OpenAIChatLLM``: any OpenAI-compatible chat endpoint (set LLM_API_KEY,
  LLM_BASE_URL, LLM_MODEL). Used for brainstorming, criteria writing,
  MATCH judging, report writing, table extraction and follow-up Q&A.
- ``GeminiConnectorLLM``: Gemini through the registered custom.gemini
  connector (set DLS_LLM_BACKEND=gemini-connector). The API key lives in
  the connector's secure storage and is never present in this process;
  each call goes through the connector helper, which attaches a
  surrogate credential that is swapped for the real key on egress.
- ``HeuristicLLM``: deterministic offline fallback (lexical scoring,
  extractive report assembly). Lets the whole pipeline run — and be
  tested — with no API key at all.

Every method degrades to the heuristic behavior on API errors, so a flaky
endpoint never kills a search run.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
import time

import requests

from .config import Config
from .models import Paper
from .scoring import content_tokens, heuristic_match



