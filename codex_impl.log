"""Core data types shared across clients, the engine and the store."""

from __future__ import annotations

from dataclasses import dataclass, field


@dataclass
class Paper:
    paper_id: str  # canonical id: S2 id, "W..." OpenAlex id, or "doi:..."
    title: str
    abstract: str | None = None
    year: int | None = None
    authors: list[str] = field(default_factory=list)
    venue: str | None = None
    citation_count: int = 0
    reference_count: int = 0
    doi: str | None = None
    arxiv_id: str | None = None
    open_access_pdf: str | None = None
    url: str | None = None
    tldr: str | None = None
    source: str = "semantic_scholar"
    sources: list[str] = field(default_factory=list)  # every channel that found it

    # Filled in by scoring / storage layers
    key: str | None = None        # citation key, e.g. "Zha25"
    match: float | None = None    # 0..100 relevance to a search's criteria
    match_reason: str | None = None
    found_via: str | None = None  # provenance: "search", "citations of [Key]", ...

    def __post_init__(self) -> None:
        if self.source and self.source not in self.sources:
            self.sources.append(self.source)

    @property
    def has_full_text(self) -> bool:
        return bool(self.open_access_pdf)

    def citations_per_year(self, current_year: int = 2026) -> float:
        if not self.year:
            return float(self.citation_count)
        age = max(1, current_year - self.year + 1)
        return self.citation_count / age

    def first_author_surname(self) -> str:
        if not self.authors:
            return "Anon"
        name = self.authors[0].strip()
        if not name:
            return "Anon"
        # "First Last" -> "Last"; keep only letters for a compact key.
        last = name.split()[-1]
        cleaned = "".join(ch for ch in last if ch.isalpha())
        return cleaned or "Anon"


@dataclass
class SearchOutcome:
    search_id: int
    question: str
    criteria: list[str]
    included: list[Paper]
    excluded_count: int
    with_full_text: int
    rounds: int
    converged: bool
    coverage: dict | None  # discovery-curve estimate, see engine.estimate_coverage
    warnings: list[str] = field(default_factory=list)

    @property
    def found(self) -> int:
        return len(self.included)
"""SQLite-backed project library: papers, searches, reports, updates."""

from __future__ import annotations

import json
import sqlite3
import time
from pathlib import Path

from .models import Paper
from .scoring import make_key

SCHEMA = """
CREATE TABLE IF NOT EXISTS projects (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT UNIQUE NOT NULL,
    created_at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS papers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    paper_uid TEXT UNIQUE NOT NULL,
    key TEXT UNIQUE,
    title TEXT NOT NULL,
    abstract TEXT,
    year INTEGER,
    authors TEXT NOT NULL DEFAULT '[]',
    venue TEXT,
    citation_count INTEGER NOT NULL DEFAULT 0,
    reference_count INTEGER NOT NULL DEFAULT 0,
    doi TEXT,
    arxiv_id TEXT,
    oa_pdf TEXT,
    url TEXT,
    tldr TEXT,
    source TEXT,
    starred INTEGER NOT NULL DEFAULT 0,
    folder TEXT,
    created_at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS searches (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER NOT NULL REFERENCES projects(id),
    question TEXT NOT NULL,
    criteria TEXT NOT NULL DEFAULT '[]',
    answers TEXT NOT NULL DEFAULT '{}',
    counts TEXT NOT NULL DEFAULT '{}',
    coverage TEXT,
    created_at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS search_results (
    search_id INTEGER NOT NULL REFERENCES searches(id),
    paper_id INTEGER NOT NULL REFERENCES papers(id),
    match REAL,
    reason TEXT,
    included INTEGER NOT NULL DEFAULT 0,
    rank INTEGER,
    PRIMARY KEY (search_id, paper_id)
);
CREATE TABLE IF NOT EXISTS files (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER NOT NULL REFERENCES projects(id),
    kind TEXT NOT NULL,
    name TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS updates (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    search_id INTEGER NOT NULL REFERENCES searches(id),
    paper_id INTEGER NOT NULL REFERENCES papers(id),
    found_at REAL NOT NULL,
    seen INTEGER NOT NULL DEFAULT 0
);
"""


class Store:
    def __init__(self, db_path: Path):
        db_path.parent.mkdir(parents=True, exist_ok=True)
        # check_same_thread=False: the web UI serves requests from worker
        # threads. SQLite itself serializes writers; our transactions are
        # short, which is fine for this local single-user store.
        self.conn = sqlite3.connect(str(db_path), check_same_thread=False, timeout=30)
        self.conn.row_factory = sqlite3.Row
        self.conn.executescript(SCHEMA)
        # Migration: provenance column on search_results (added after v0.1).
        cols = {r["name"] for r in self.conn.execute("PRAGMA table_info(search_results)")}
        if "provenance" not in cols:
            self.conn.execute("ALTER TABLE search_results ADD COLUMN provenance TEXT")
        self.conn.commit()

    # -- projects ---------------------------------------------------------
    def project_id(self, name: str = "default") -> int:
        row = self.conn.execute("SELECT id FROM projects WHERE name = ?", (name,)).fetchone()
        if row:
            return int(row["id"])
        cur = self.conn.execute(
            "INSERT INTO projects (name, created_at) VALUES (?, ?)", (name, time.time())
        )
        self.conn.commit()
        return int(cur.lastrowid)

    # -- papers -------------------------------------------------------------
    def _taken_keys(self) -> set[str]:
        return {r["key"] for r in self.conn.execute("SELECT key FROM papers WHERE key IS NOT NULL")}

    def upsert_paper(self, paper: Paper) -> int:
        """Insert or enrich a paper; assigns a citation KEY on first insert."""
        row = self.conn.execute(
            "SELECT id FROM papers WHERE paper_uid = ?", (paper.paper_id,)
        ).fetchone()
        if row is None and paper.doi:
            row = self.conn.execute(
                "SELECT id FROM papers WHERE doi = ?", (paper.doi,)
            ).fetchone()
        if row is not None:
            pid = int(row["id"])
            # Enrich missing fields only.
            cur = self.conn.execute("SELECT * FROM papers WHERE id = ?", (pid,)).fetchone()
            if not paper.key and cur["key"]:
                paper.key = cur["key"]
            updates: dict[str, object] = {}
            if not cur["abstract"] and paper.abstract:
                updates["abstract"] = paper.abstract
            if not cur["oa_pdf"] and paper.open_access_pdf:
                updates["oa_pdf"] = paper.open_access_pdf
            if not cur["tldr"] and paper.tldr:
                updates["tldr"] = paper.tldr
            if paper.citation_count > (cur["citation_count"] or 0):
                updates["citation_count"] = paper.citation_count
            if updates:
                sets = ", ".join(f"{k} = ?" for k in updates)
                self.conn.execute(
                    f"UPDATE papers SET {sets} WHERE id = ?", (*updates.values(), pid)
                )
                self.conn.commit()
            return pid
        if not paper.key:
            paper.key = make_key(paper, self._taken_keys())
        cur = self.conn.execute(
            """INSERT INTO papers (paper_uid, key, title, abstract, year, authors, venue,
               citation_count, reference_count, doi, arxiv_id, oa_pdf, url, tldr, source, created_at)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (
                paper.paper_id, paper.key, paper.title, paper.abstract, paper.year,
                json.dumps(paper.authors), paper.venue, paper.citation_count,
                paper.reference_count, paper.doi, paper.arxiv_id,
                paper.open_access_pdf, paper.url, paper.tldr, paper.source, time.time(),
            ),
        )
        self.conn.commit()
        return int(cur.lastrowid)

    def _row_to_paper(self, row: sqlite3.Row) -> Paper:
        p = Paper(
            paper_id=row["paper_uid"],
            title=row["title"],
            abstract=row["abstract"],
            year=row["year"],
            authors=json.loads(row["authors"] or "[]"),
            venue=row["venue"],
            citation_count=row["citation_count"] or 0,
            reference_count=row["reference_count"] or 0,
            doi=row["doi"],
            arxiv_id=row["arxiv_id"],
            open_access_pdf=row["oa_pdf"],
            url=row["url"],
            tldr=row["tldr"],
            source=row["source"] or "import",
        )
        p.key = row["key"]
        p.db_id = int(row["id"])  # type: ignore[attr-defined]
        p.starred = bool(row["starred"])  # type: ignore[attr-defined]
        p.folder = row["folder"]  # type: ignore[attr-defined]
        return p

    def get_paper(self, db_id: int) -> Paper | None:
        row = self.conn.execute("SELECT * FROM papers WHERE id = ?", (db_id,)).fetchone()
        return self._row_to_paper(row) if row else None

    def find_paper(self, identifier: str) -> Paper | None:
        """Look up by KEY, DOI, arXiv id, or canonical paper_uid."""
        for column in ("key", "doi", "arxiv_id", "paper_uid"):
            row = self.conn.execute(
                f"SELECT * FROM papers WHERE {column} = ?", (identifier,)
            ).fetchone()
            if row:
                return self._row_to_paper(row)
        if identifier.startswith("doi:"):
            return self.find_paper(identifier[4:])
        return None

    def list_papers(self, starred_only: bool = False, folder: str | None = None) -> list[Paper]:
        sql = "SELECT * FROM papers"
        clauses, args = [], []
        if starred_only:
            clauses.append("starred = 1")
        if folder is not None:
            clauses.append("folder = ?")
            args.append(folder)
        if clauses:
            sql += " WHERE " + " AND ".join(clauses)
        sql += " ORDER BY year DESC, citation_count DESC"
        return [self._row_to_paper(r) for r in self.conn.execute(sql, args)]

    def set_star(self, db_id: int, starred: bool) -> None:
        self.conn.execute("UPDATE papers SET starred = ? WHERE id = ?", (1 if starred else 0, db_id))
        self.conn.commit()

    def set_folder(self, db_id: int, folder: str | None) -> None:
        self.conn.execute("UPDATE papers SET folder = ? WHERE id = ?", (folder, db_id))
        self.conn.commit()

    # -- searches -------------------------------------------------------------
    def create_search(self, project: str, question: str, criteria: list[str], answers: dict) -> int:
        pid = self.project_id(project)
        cur = self.conn.execute(
            "INSERT INTO searches (project_id, question, criteria, answers, created_at) VALUES (?, ?, ?, ?, ?)",
            (pid, question, json.dumps(criteria), json.dumps(answers), time.time()),
        )
        self.conn.commit()
        return int(cur.lastrowid)

    def save_results(self, search_id: int, scored: list[Paper], included_ids: set[int], counts: dict, coverage: dict | None) -> None:
        rank = 0
        for paper in scored:
            db_id = getattr(paper, "db_id", None)
            if db_id is None:
                db_id = self.upsert_paper(paper)
                paper.db_id = db_id  # type: ignore[attr-defined]
            is_included = db_id in included_ids
            if is_included:
                rank += 1
            self.conn.execute(
                """INSERT OR REPLACE INTO search_results (search_id, paper_id, match, reason, included, rank, provenance)
                   VALUES (?, ?, ?, ?, ?, ?, ?)""",
                (search_id, db_id, paper.match, paper.match_reason, 1 if is_included else 0, rank if is_included else None, paper.found_via),
            )
        self.conn.execute(
            "UPDATE searches SET counts = ?, coverage = ? WHERE id = ?",
            (json.dumps(counts), json.dumps(coverage) if coverage else None, search_id),
        )
        self.conn.commit()

    def get_search(self, search_id: int) -> dict | None:
        row = self.conn.execute("SELECT * FROM searches WHERE id = ?", (search_id,)).fetchone()
        if not row:
            return None
        return {
            "id": int(row["id"]),
            "project_id": int(row["project_id"]),
            "question": row["question"],
            "criteria": json.loads(row["criteria"] or "[]"),
            "answers": json.loads(row["answers"] or "{}"),
            "counts": json.loads(row["counts"] or "{}"),
            "coverage": json.loads(row["coverage"]) if row["coverage"] else None,
            "created_at": row["created_at"],
        }

    def list_searches(self) -> list[dict]:
        ids = [int(r["id"]) for r in self.conn.execute("SELECT id FROM searches ORDER BY id DESC")]
        return [self.get_search(i) for i in ids if self.get_search(i)]

    def search_papers(self, search_id: int, included_only: bool = True) -> list[Paper]:
        sql = """
            SELECT p.*, sr.match AS sr_match, sr.reason AS sr_reason, sr.rank AS sr_rank, sr.provenance AS sr_provenance
            FROM search_results sr JOIN papers p ON p.id = sr.paper_id
            WHERE sr.search_id = ?
        """
        if included_only:
            sql += " AND sr.included = 1"
        sql += " ORDER BY sr.match DESC"
        papers = []
        for row in self.conn.execute(sql, (search_id,)):
            p = self._row_to_paper(row)
            p.match = row["sr_match"]
            p.match_reason = row["sr_reason"]
            p.found_via = row["sr_provenance"]
            papers.append(p)
        return papers

    def search_paper_ids(self, search_id: int) -> set[int]:
        return {
            int(r["paper_id"])
            for r in self.conn.execute("SELECT paper_id FROM search_results WHERE search_id = ?", (search_id,))
        }

    # -- files (reports) -------------------------------------------------------
    def save_file(self, project: str, kind: str, name: str, content: str) -> int:
        pid = self.project_id(project)
        cur = self.conn.execute(
            "INSERT INTO files (project_id, kind, name, content, created_at) VALUES (?, ?, ?, ?, ?)",
            (pid, kind, name, content, time.time()),
        )
        self.conn.commit()
        return int(cur.lastrowid)

    def get_file(self, file_id: int) -> dict | None:
        row = self.conn.execute("SELECT * FROM files WHERE id = ?", (file_id,)).fetchone()
        if not row:
            return None
        return {"id": int(row["id"]), "kind": row["kind"], "name": row["name"], "content": row["content"]}

    def list_files(self) -> list[dict]:
        return [
            {"id": int(r["id"]), "kind": r["kind"], "name": r["name"], "created_at": r["created_at"]}
            for r in self.conn.execute("SELECT id, kind, name, created_at FROM files ORDER BY id DESC")
        ]

    # -- updates ------------------------------------------------------------------
    def add_update(self, search_id: int, paper_db_id: int) -> None:
        exists = self.conn.execute(
            "SELECT 1 FROM updates WHERE search_id = ? AND paper_id = ?", (search_id, paper_db_id)
        ).fetchone()
        if not exists:
            self.conn.execute(
                "INSERT INTO updates (search_id, paper_id, found_at) VALUES (?, ?, ?)",
                (search_id, paper_db_id, time.time()),
            )
            self.conn.commit()

    def list_updates(self, search_id: int | None = None) -> list[dict]:
        sql = """
            SELECT u.id, u.search_id, u.found_at, u.seen, p.title, p.key, p.year
            FROM updates u JOIN papers p ON p.id = u.paper_id
        """
        args: tuple = ()
        if search_id is not None:
            sql += " WHERE u.search_id = ?"
            args = (search_id,)
        sql += " ORDER BY u.found_at DESC"
        return [dict(r) for r in self.conn.execute(sql, args)]
"""The deep-search engine: orchestrates retrieval, scoring, snowballing.

Stage names intentionally mirror the reference product's progress UI:
Interpreting → Searching → Identifying → Reflecting → Adapting → Done.
A `progress` callback receives (stage, detail) pairs so CLI, Web UI and
tests can all observe the run.
"""

from __future__ import annotations

from typing import Callable

from .clients.openalex import OpenAlexClient
from .clients.semantic_scholar import RateLimited, SemanticScholarClient
from .llm import HeuristicLLM
from .models import Paper, SearchOutcome
from .scoring import dedupe, identity_keys
from .store import Store

ProgressFn = Callable[[str, str], None]


def _noop(stage: str, detail: str) -> None:
    pass


class DeepSearchEngine:
    def __init__(
        self,
        s2: SemanticScholarClient,
        openalex: OpenAlexClient | None,
        llm: HeuristicLLM,
        store: Store,
        include_threshold: float = 55.0,
        crossref=None,
    ):
        self.s2 = s2
        self.openalex = openalex
        self.llm = llm
        self.store = store
        self.include_threshold = include_threshold
        self.crossref = crossref

    # ------------------------------------------------------------------
    def brainstorm(self, question: str) -> list[str]:
        return self.llm.brainstorm(question)

    def build_criteria(self, question: str, answers: dict[str, str] | None = None) -> list[str]:
        return self.llm.make_criteria(question, answers)

    # ------------------------------------------------------------------
    def _score(self, criteria: list[str], papers: list[Paper]) -> list[Paper]:
        scores = self.llm.score_matches(criteria, papers)
        for paper, (score, reason) in zip(papers, scores):
            paper.match = score
            paper.match_reason = reason
        return papers

    def _snowball(self, seeds: list[Paper], limit_per_seed: int = 30) -> list[Paper]:
        out: list[Paper] = []
        for seed in seeds:
            label = f"[{seed.key}]" if seed.key else f"'{seed.title[:40]}'"
            for fetcher, direction in ((self.s2.citations, "citations"), (self.s2.references, "references")):
                try:
                    found = fetcher(seed.paper_id, limit=limit_per_seed)
                except Exception:
                    continue
                for p in found:
                    if p.found_via is None:
                        p.found_via = f"{direction} of {label}"
                    out.append(p)
        return out

    # ------------------------------------------------------------------
    @staticmethod
    def estimate_coverage(
        s2_relevant: set[str], oa_relevant: set[str], found_relevant: int
    ) -> dict | None:
        """Lincoln–Petersen / Chapman capture–recapture over two channels.

        Treats Semantic Scholar and OpenAlex as two independent "captures"
        of the same relevant-paper population. Only meaningful when both
        channels returned relevant papers with some overlap.
        """
        n1, n2 = len(s2_relevant), len(oa_relevant)
        m = len(s2_relevant & oa_relevant)
        if n1 < 3 or n2 < 3 or m == 0:
            return None
        total_est = ((n1 + 1) * (n2 + 1) / (m + 1)) - 1
        if total_est <= 0:
            return None
        coverage = max(0.0, min(1.0, found_relevant / total_est))
        return {
            "method": "capture-recapture (Chapman) over Semantic Scholar vs OpenAlex relevant sets",
            "estimated_total_relevant": round(total_est, 1),
            "found_relevant": found_relevant,
            "estimated_coverage": round(coverage, 3),
            "channel_sizes": {"semantic_scholar": n1, "openalex": n2, "overlap": m},
        }

    # ------------------------------------------------------------------
    def trace(
        self,
        seed: Paper,
        question: str | None = None,
        project: str = "default",
        hops: int = 1,
        per_direction: int = 40,
        progress: ProgressFn = _noop,
    ) -> SearchOutcome:
        """Citation-graph traversal from one seed paper ("相互查找").

        Expands both directions — papers the seed cites (references) and
        papers citing it (citations) — scores every neighbour against the
        question (or the seed itself), and stores the neighbourhood as a
        normal search so it can be reported, extracted and asked about.
        """
        warnings: list[str] = []
        criteria = [question] if question else [seed.title, seed.abstract or seed.title]
        label = f"Papers connected to: {seed.title}"
        search_id = self.store.create_search(project, label, criteria, {})
        seed.db_id = self.store.upsert_paper(seed)  # type: ignore[attr-defined]
        progress("Tracing citation graph", f"seed [{seed.key}] {seed.title}")

        seen_keys: set[str] = set(identity_keys(seed))
        pool: list[Paper] = []
        frontier = [seed]
        for hop in range(1, hops + 1):
            nxt: list[Paper] = []
            for node in frontier:
                node_label = f"[{node.key}]" if node.key else f"'{node.title[:40]}'"
                for fetcher, direction in ((self.s2.citations, "citations"), (self.s2.references, "references")):
                    try:
                        found = fetcher(node.paper_id, limit=per_direction)
                    except Exception:
                        warnings.append(f"{direction} lookup failed for {node_label}.")
                        continue
                    for p in found:
                        if identity_keys(p) & seen_keys:
                            continue
                        seen_keys |= identity_keys(p)
                        if p.found_via is None:
                            p.found_via = f"{direction} of {node_label}"
                        pool.append(p)
                        nxt.append(p)
            if not nxt:
                break
            # Score this hop before deciding the next frontier.
            hop_scored = self._score(criteria, nxt)
            for p in hop_scored:
                p.db_id = self.store.upsert_paper(p)  # type: ignore[attr-defined]
            frontier = sorted(
                (p for p in hop_scored if (p.match or 0) >= self.include_threshold),
                key=lambda p: -(p.match or 0),
            )[:5]
            progress("Adapting and searching again", f"hop {hop}: {len(nxt)} neighbours")
            if not frontier:
                break

        included = [p for p in pool if (p.match or 0) >= self.include_threshold]
        included.sort(key=lambda p: -(p.match or 0))
        included_db_ids = {getattr(p, "db_id") for p in included}
        counts = {
            "found": len(included),
            "with_full_text": sum(1 for p in included if p.has_full_text),
            "excluded": len(pool) - len(included),
            "candidates": len(pool),
        }
        self.store.save_results(search_id, pool, included_db_ids, counts, None)
        progress("Done", f"{counts['found']} connected papers · {counts['excluded']} excluded")
        return SearchOutcome(
            search_id=search_id,
            question=label,
            criteria=criteria,
            included=included,
            excluded_count=counts["excluded"],
            with_full_text=counts["with_full_text"],
            rounds=hops,
            converged=True,
            coverage=None,
            warnings=warnings,
        )

    # ------------------------------------------------------------------
    def run(
        self,
        question: str,
        criteria: list[str],
        answers: dict[str, str] | None = None,
        project: str = "default",
        per_query: int = 40,
        max_rounds: int = 2,
        seed_top: int = 8,
        progress: ProgressFn = _noop,
    ) -> SearchOutcome:
        warnings: list[str] = []
        search_id = self.store.create_search(project, question, criteria, answers or {})
        progress("Interpreting your search criteria", f"{len(criteria)} criteria")

        # -- Searching ---------------------------------------------------
        progress("Searching for the most promising papers", "Semantic Scholar + OpenAlex")
        pool: list[Paper] = []
        queries = list(dict.fromkeys([question, *criteria]))
        for q in queries:
            try:
                pool.extend(self.s2.search(q, limit=per_query))
            except RateLimited:
                warnings.append("Semantic Scholar rate-limited part of the initial search.")
                continue
            except Exception as exc:  # network etc.
                warnings.append(f"Semantic Scholar search failed: {exc}")
                continue
        try:
            if self.openalex is not None:
                pool.extend(self.openalex.search(question, per_page=25))
        except Exception:
            warnings.append("OpenAlex channel unavailable; running single-source.")
        if self.crossref is not None:
            try:
                pool.extend(self.crossref.search(question, rows=per_query))
            except Exception:
                warnings.append("Crossref channel unavailable.")

        pool = dedupe(pool)
        for p in pool:
            if p.found_via is None:
                p.found_via = "search"

        # -- Identifying ---------------------------------------------------
        progress("Identifying the best candidate papers", f"{len(pool)} candidates")
        scored = self._score(criteria, pool)
        included = [p for p in scored if (p.match or 0) >= self.include_threshold]
        seen_keys: set[str] = set()
        for p in scored:
            seen_keys |= identity_keys(p)
        # Persist early so included papers have citation KEYs; snowball
        # provenance labels ("citations of [Key]") depend on them.
        for p in scored:
            p.db_id = self.store.upsert_paper(p)  # type: ignore[attr-defined]

        # -- Reflecting / Adapting (snowball rounds) -------------------------
        rounds_done = 0
        converged = False
        for round_no in range(1, max_rounds + 1):
            rounds_done = round_no
            progress("Reflecting on the results", f"round {round_no}")
            reflection = self.llm.reflect(criteria, sorted(included, key=lambda p: -(p.match or 0)), round_no)
            seeds = sorted(included, key=lambda p: -(p.match or 0))[:seed_top]
            progress("Adapting and searching again", f"snowballing from {len(seeds)} seeds")
            candidates = dedupe(self._snowball(seeds))
            # The reflection step may propose fresh queries; run them too.
            for new_q in reflection.get("new_queries") or []:
                try:
                    extra = self.s2.search(new_q, limit=20)
                    for p in extra:
                        if p.found_via is None:
                            p.found_via = "reflection query"
                    candidates = dedupe(candidates + extra)
                except Exception:
                    continue
            candidates = [c for c in candidates if not (identity_keys(c) & seen_keys)]
            for c in candidates:
                seen_keys |= identity_keys(c)
            if not candidates:
                converged = True
                break
            new_scored = self._score(criteria, candidates)
            for p in new_scored:
                p.db_id = self.store.upsert_paper(p)  # type: ignore[attr-defined]
            scored.extend(new_scored)
            new_included = [p for p in new_scored if (p.match or 0) >= self.include_threshold]
            included.extend(new_included)
            gain = len(new_included) / max(1, len(included))
            if reflection.get("stop") or gain < 0.03:
                converged = True
                break

        included.sort(key=lambda p: -(p.match or 0))

        # Persist papers and results; capture db ids for coverage sets.
        s2_rel: set[str] = set()
        oa_rel: set[str] = set()
        included_db_ids: set[int] = set()
        for p in scored:
            db_id = self.store.upsert_paper(p)
            p.db_id = db_id  # type: ignore[attr-defined]
            if (p.match or 0) >= self.include_threshold:
                if "semantic_scholar" in p.sources:
                    s2_rel.add(p.paper_id)
                if "openalex" in p.sources:
                    oa_rel.add(p.paper_id)
        for p in included:
            included_db_ids.add(getattr(p, "db_id"))

        coverage = self.estimate_coverage(s2_rel, oa_rel, len(included))
        counts = {
            "found": len(included),
            "with_full_text": sum(1 for p in included if p.has_full_text),
            "excluded": len(scored) - len(included),
            "candidates": len(scored),
        }
        self.store.save_results(search_id, scored, included_db_ids, counts, coverage)
        # save_results upserts again internally for any paper missing db_id; keep ids consistent.
        progress("Done", f"{counts['found']} papers · {counts['with_full_text']} with full text · {counts['excluded']} excluded")

        return SearchOutcome(
            search_id=search_id,
            question=question,
            criteria=criteria,
            included=included,
            excluded_count=counts["excluded"],
            with_full_text=counts["with_full_text"],
            rounds=rounds_done,
            converged=converged,
            coverage=coverage,
            warnings=warnings,
        )

