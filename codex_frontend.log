      <p id="ns-plan-hint" class="muted" aria-live="polite"></p>
      <label class="confirm-label"><input id="ns-confirm" type="checkbox">我已审阅并确认 Search Criteria</label>
    </div>
    <div class="dlg-actions">
      <button type="button" id="ns-plan" class="btn">先澄清并生成标准</button>
