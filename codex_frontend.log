/* Research workspace: quiet surfaces, editorial hierarchy and accessible controls. */
:root { --accent: #256b60; --accent-soft: #eaf4f0; --bg: #f7f8f6; --ink: #24332f; --line: #dfe6e1; }
body { font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans CJK SC\", sans-serif; }
.topbar { min-height: 64px; padding: 12px 24px; gap: 16px; }
.brand { display: flex; align-items: center; gap: 10px; letter-spacing: -.3px; }
.brand-mark { background: var(--accent); color: white; padding: 3px 8px; border-radius: 8px; font-family: Georgia, serif; font-size: 20px; }
.topbar-right { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.layout { grid-template-columns: 230px minmax(340px, 1fr) minmax(320px, 370px); }
.sidebar { background: #f0f3ef; padding: 20px 14px; }
.main { padding: 28px; }
.inspector { padding: 18px; }
.search-item.active { border-color: #b9d5c9; background: #e4eee7; }
.btn { padding: 8px 12px; font-weight: 550; transition: background .15s; }
.btn-primary { box-shadow: 0 2px 3px #163b3012; }
.welcome { margin: 10vh auto; max-width: 580px; text-align: left; }
.welcome h2 { font: 500 clamp(28px, 3vw, 40px)/1.4 Georgia, \"Noto Serif CJK SC\", serif; letter-spacing: -1px; }
.welcome p { line-height: 1.9; }
.eyebrow { font-size: 10px; font-weight: 700; letter-spacing: .13em; color: var(--accent); margin-bottom: 10px; }
.workflow { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0; color: var(--muted); font-size: 12px; }
.workflow span { border-top: 1px solid var(--line); padding-top: 10px; }
.detail-head h2 { font: 600 24px/1.5 Georgia, \"Noto Serif CJK SC\", serif; margin-bottom: 16px; }
.criteria-chips { margin: 18px 0; }
.chip { border-radius: 6px; border: 1px solid var(--line); background: white; padding: 5px 9px; }
.table-scroll { overflow-x: auto; border-radius: 10px; }
.papers-table { min-width: 420px; }
.paper-title { line-height: 1.6; }
.paper-sub { margin-top: 5px; }
.paper-reason { margin-top: 7px; color: #53645c; }
.score-source { font-size: 10px; line-height: 1.3; margin-top: 5px; color: var(--muted); overflow-wrap: anywhere; }
.tabs { margin: -18px -18px 18px; padding: 10px 10px 0; gap: 0; }
.tab { flex: 1; padding: 10px 5px; }
.job-log .ev { display: block; border-left: 2px solid var(--line); border-bottom: none; margin-left: 4px; padding: 8px 12px; }
.job-log .stage { display: block; white-space: normal "'!important; font-size: 12px; }
.job-log .detail { display: block; margin-top: 3px; overflow-wrap: anywhere; }
.job-head { overflow-wrap: anywhere; }
.notice { padding: 10px 24px; background: #fff4da; color: #795819; border-bottom: 1px solid #ebdbb4; }
.warning { background: #fff6df; color: #795819; border-left: 3px solid #d7ae4c; padding: 9px 12px; font-size: 12px; overflow-wrap: anywhere; }
.status-done { color: var(--green); } .status-error { color: #b91c1c; }
.library-tools { display: flex; align-items: end; gap: 8px; flex-wrap: wrap; margin: 18px 0; }
.library-tools label { flex: 1; min-width: 160px; font-size: 12px; color: var(--muted); }
input, textarea { border: 1px solid var(--line); border-radius: 7px; background: white; padding: 9px; font: inherit; color: var(--ink); min-width: 0; }
.library-tools input { display: block; width: 100%; margin-top: 5px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
a { color: var(--accent); overflow-wrap: anywhere; }
#paper-detail h2 { font: 600 21px/1.5 Georgia, serif; }
#paper-detail h3 { font-size: 12px; color: var(--muted); margin-top: 24px; }
#paper-detail .abstract-text { white-space: pre-wrap; line-height: 1.9; }
#paper-detail label { display: block; margin: 20px 0 10px; }
#paper-detail input { width: 100%; margin-top: 6px; }
.markdown, #paper-detail { overflow-wrap: anywhere; }
.markdown { overflow-x: auto; line-height: 1.8; }
dialog { width: min(700px, 94vw); max-height: 90vh; box-shadow: 0 24px 80px #163b3026; }
.dlg { padding: 28px; }
.dlg > .muted { margin-top: 0; }
.dlg-actions { flex-wrap: wrap; }
.dlg .confirm-label { flex-direction: row; align-items: center; margin: 12px 0; }
@media (max-width: 1200px) {
  .layout { grid-template-columns: 210px minmax(0, 1fr); overflow-y: auto; }
  .inspector { grid-column: 1 / -1; border-left: none; border-top: 1px solid var(--line); min-height: 360px; max-height: 65vh; }
}
@media (max-width: 640px) {
  body { height: auto; min-height: 100vh; }
  .topbar { padding: 12px; align-items: start; flex-direction: column; }
  .backend-status { width: 100%; }
  .layout { display: flex; flex-direction: column; overflow: visible; }
  .sidebar { border-right: 0; border-bottom: 1px solid var(--line); max-height: 260px; }
  .sidebar h3 { margin-top: 10px; }
  .main { padding: 20px 12px; overflow: visible; }
  .welcome { margin: 24px auto; }
  .detail-head h2 { font-size: 22px; }
  .inspector { min-height: 380px; }
  .export-group { margin-left: 0; flex-wrap: wrap; }
  .dlg { padding: 18px; }
  .dlg-actions .flex-spacer { display: none; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
