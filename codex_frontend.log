"""Chat-driven table extraction: name the columns, get a table."""

from __future__ import annotations

from .llm import HeuristicLLM
from .store import Store


def extract_table(
    store: Store,
    search_id: int,
    columns: list[str],
    llm: HeuristicLLM,
    top_n: int = 10,
) -> str:
    papers = store.search_papers(search_id, included_only=True)[:top_n]
    if not papers:
        return "(no included papers in this search)"
    lines = ["| " + " | ".join(columns) + " |", "|" + "---|" * len(columns)]
    for p in papers:
        row = llm.extract_row(p, columns)
        cells = [str(row.get(c, "—")).replace("|", "/").replace("\n", " ") for c in columns]
        lines.append("| " + " | ".join(cells) + " |")
    lines.append("")
    lines.append(f"Only papers from search #{search_id} were included; no external sources were added.")
    return "\n".join(lines)
"""Report generation and exports (papers: CSV/BibTeX/RIS; reports: MD/HTML)."""

from __future__ import annotations

import csv
import html
import io
import re

from .llm import HeuristicLLM
from .models import Paper
from .store import Store


def generate_report(
    store: Store,
    search_id: int,
    llm: HeuristicLLM,
    focus: str | None = None,
    project: str = "default",
) -> tuple[int, str]:
    search = store.get_search(search_id)
    if not search:
        raise ValueError(f"search {search_id} not found")
    papers = store.search_papers(search_id, included_only=True)
    md = llm.write_report(search["question"], search["criteria"], papers, focus)
    # Title for the file: first 60 chars of the question.
    name = search["question"][:60].strip()
    file_id = store.save_file(project, "report", name, md)
    return file_id, md


# ---------------------------------------------------------------------------
# Paper exports
# ---------------------------------------------------------------------------

def _bibtex_key(paper: Paper) -> str:
    return paper.key or f"paper{paper.year or ''}"


def papers_to_bibtex(papers: list[Paper]) -> str:
    out = []
    for p in papers:
        authors = " and ".join(p.authors)
        fields = [
            f"  title = {{{p.title}}}",
            f"  author = {{{authors}}}",
        ]
        if p.year:
            fields.append(f"  year = {{{p.year}}}")
        if p.venue:
            fields.append(f"  journal = {{{p.venue}}}")
        if p.doi:
            fields.append(f"  doi = {{{p.doi}}}")
        if p.url:
            fields.append(f"  url = {{{p.url}}}")
        out.append("@article{" + _bibtex_key(p) + ",\n" + ",\n".join(fields) + "\n}")
    return "\n\n".join(out) + "\n"


def papers_to_csv(papers: list[Paper]) -> str:
    buf = io.StringIO()
    writer = csv.writer(buf)
    writer.writerow(["key", "year", "cit_per_year", "match", "title", "authors", "venue", "doi", "url"])
    for p in papers:
        writer.writerow([
            p.key or "",
            p.year or "",
            f"{p.citations_per_year():.1f}",
            p.match if p.match is not None else "",
            p.title,
            "; ".join(p.authors),
            p.venue or "",
            p.doi or "",
            p.url or "",
        ])
    return buf.getvalue()


def papers_to_ris(papers: list[Paper]) -> str:
    out = []
    for p in papers:
        lines = ["TY  - JOUR"]
        lines.append(f"TI  - {p.title}")
        for a in p.authors:
            lines.append(f"AU  - {a}")
        if p.year:
            lines.append(f"Y1  - {p.year}")
        if p.venue:
            lines.append(f"JO  - {p.venue}")
        if p.doi:
            lines.append(f"DO  - {p.doi}")
        if p.url:
            lines.append(f"UR  - {p.url}")
        if p.abstract:
            lines.append(f"AB  - {p.abstract[:500]}")
        lines.append("ER  - ")
        out.append("\n".join(lines))
    return "\n\n".join(out) + "\n"


