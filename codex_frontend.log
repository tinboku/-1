"""Runtime configuration, all from environment variables.

Nothing here is secret by itself; API keys are read from the environment
only and never written to disk by this package.
"""

from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path


def _first_env(*names: str) -> str | None:
    for name in names:
        value = os.environ.get(name)
        if value:
            return value.strip()
    return None


@dataclass
class Config:
    # Data sources
    s2_api_key: str | None = None          # SEMANTIC_SCHOLAR_API_KEY / S2_API_KEY
    openalex_api_key: str | None = None    # OPENALEX_API_KEY
    contact_email: str | None = None       # CROSSREF_EMAIL / OPENALEX_EMAIL (polite pools)

    # LLM backend (OpenAI-compatible). Without a key the heuristic backend is used.
    llm_api_key: str | None = None         # LLM_API_KEY / OPENAI_API_KEY
    llm_base_url: str = "https://api.openai.com/v1"
    llm_model: str = "gpt-4o-mini"
    llm_backend: str = "auto"              # DLS_LLM_BACKEND: auto | gemini-connector | heuristic
    gemini_helper: Path = Path.home() / "workspace/custom-connectors/custom.gemini/bin/gemini.py"  # DLS_GEMINI_HELPER

    # Storage
    data_dir: Path = Path.home() / ".dls"

    @classmethod
    def from_env(cls) -> "Config":
        data_dir = os.environ.get("DLS_HOME")
        backend = os.environ.get("DLS_LLM_BACKEND", "auto")
        # Gemini retired 2.5 Flash for new users; 3.8 Flash is the default there.
        default_model = "gemini-3.8-flash" if backend == "gemini-connector" else "gpt-4o-mini"
        helper = os.environ.get("DLS_GEMINI_HELPER")
        return cls(
            s2_api_key=_first_env("SEMANTIC_SCHOLAR_API_KEY", "S2_API_KEY"),
            openalex_api_key=_first_env("OPENALEX_API_KEY"),
            contact_email=_first_env("CROSSREF_EMAIL", "OPENALEX_EMAIL"),
            llm_api_key=_first_env("LLM_API_KEY", "OPENAI_API_KEY"),
            llm_base_url=os.environ.get("LLM_BASE_URL", "https://api.openai.com/v1"),
            llm_model=os.environ.get("LLM_MODEL", default_model),
            llm_backend=backend,
            gemini_helper=Path(helper) if helper else Path.home() / "workspace/custom-connectors/custom.gemini/bin/gemini.py",
            data_dir=Path(data_dir) if data_dir else Path.home() / ".dls",
        )

    @property
    def db_path(self) -> Path:
        return self.data_dir / "library.db"

    @property
    def files_dir(self) -> Path:
        return self.data_dir / "files"

    def ensure_dirs(self) -> None:
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.files_dir.mkdir(parents=True, exist_ok=True)
"""Command-line interface: `dls`.

Examples:
    dls search "methods for generating dataset descriptions with LLMs"
    dls report 1
    dls ask 1 "which of these use table profiling?"
    dls extract 1 --columns paper,year,method,output type
    dls papers --starred
    dls import-doi 10.1145/1234567
    dls export 1 --format bibtex --out refs.bib
    dls updates 1
    dls serve --port 8765
    dls mcp
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from .config import Config
from .engine import DeepSearchEngine
from .extract import extract_table
from .importers import import_bibtex, import_doi, import_pdf
from .llm import get_llm
from .report import generate_report, papers_to_bibtex, papers_to_csv, papers_to_ris
from .store import Store
from .updates import check_updates


class Context:
    def __init__(self):
        self.config = Config.from_env()
        self.config.ensure_dirs()
        self.store = Store(self.config.db_path)
        from .clients.crossref import CrossrefClient
        from .clients.openalex import OpenAlexClient
        from .clients.semantic_scholar import SemanticScholarClient

        self.s2 = SemanticScholarClient(self.config.s2_api_key)
        self.openalex = OpenAlexClient(self.config.openalex_api_key, self.config.contact_email)
        self.crossref = CrossrefClient(self.config.contact_email)
        self.llm = get_llm(self.config)
        self.engine = DeepSearchEngine(self.s2, self.openalex, self.llm, self.store, crossref=self.crossref)


def _progress(stage: str, detail: str) -> None:
    print(f"  [{stage}] {detail}", file=sys.stderr)


def cmd_search(ctx: Context, args: argparse.Namespace) -> int:
    question = args.question
    answers: dict[str, str] = {}
    criteria: list[str]
    if args.criteria:
        criteria = [c.strip() for c in args.criteria.split(";") if c.strip()]
    else:
        questions = ctx.engine.brainstorm(question)
        if not args.yes:
            print("Before searching, a couple of quick questions (Enter to skip):")
            for q in questions:
                try:
                    ans = input(f"  {q}\n  > ").strip()
                except EOFError:
                    ans = ""
                if ans:
                    answers[q] = ans
        criteria = ctx.engine.build_criteria(question, answers)
        print("\nSearch criteria (the search draft):")
        for c in criteria:
            print(f"  - {c}")
        if not args.yes:
            try:
                go = input("Launch this search? [Y/n] ").strip().lower()
            except EOFError:
                go = "y"
            if go.startswith("n"):
                print("Aborted before launch.")
                return 0
    outcome = ctx.engine.run(
        question,
        criteria,
        answers=answers,
        project=args.project,
        per_query=args.per_query,
        max_rounds=args.rounds,
        progress=_progress,
    )
    for w in outcome.warnings:
        print(f"  warning: {w}", file=sys.stderr)
    print(f"\n{outcome.found} papers · {outcome.with_full_text} with full text · {outcome.excluded_count} excluded")
    if outcome.coverage:
        cov = outcome.coverage
        print(
            f"Discovery estimate: ~{cov['estimated_total_relevant']} relevant papers exist; "
            f"this search found ≈{cov['estimated_coverage'] * 100:.1f}% of them "
            f"({cov['method']})."
        )
    print(f"Search id: {outcome.search_id}\n")
